;;-*-Lisp-*-
(in-package goal)

;; Punishment handling and rule effects

(defun mod-punishment-result-duration ((punishment symbol))
  (if (eq? punishment 'punishment-revert-cell) (seconds 8) (seconds 5)))

(defun mod-punishment-results-clear! ()
  (dotimes (i *mod-punishment-result-queue-capacity*)
    (set! (-> (-> *MOD-punishment-bank* result-ids) i) #f)
    (set! (-> (-> *MOD-punishment-bank* result-tasks) i) 0))
  (set! (-> *MOD-punishment-bank* result-count) 0)
  (set! (-> *MOD-punishment-bank* result-until) 0)
  (none))

(defun mod-punishment-result-remove! ((remove-idx int))
  (let ((count (-> *MOD-punishment-bank* result-count))
        (idx remove-idx))
    (while (< idx (- count 1))
      (set! (-> (-> *MOD-punishment-bank* result-ids) idx) (-> (-> *MOD-punishment-bank* result-ids) (+ idx 1)))
      (set! (-> (-> *MOD-punishment-bank* result-tasks) idx) (-> (-> *MOD-punishment-bank* result-tasks) (+ idx 1)))
      (+! idx 1))
    (-! count 1)
    (set! (-> *MOD-punishment-bank* result-count) count)
    (set! (-> (-> *MOD-punishment-bank* result-ids) count) #f)
    (set! (-> (-> *MOD-punishment-bank* result-tasks) count) 0))
  (none))

(defun mod-punishment-result-record! ((punishment symbol) (task int))
  (let ((count (-> *MOD-punishment-bank* result-count))
        (evict-idx -1)
        (idx 1))
    (when (>= count *mod-punishment-result-queue-capacity*)
      ;; Drop the oldest queued result. Never the one on screen, never a reverted cell
      (while (and (< idx count) (< evict-idx 0))
        (when (not (eq? (-> (-> *MOD-punishment-bank* result-ids) idx) 'punishment-revert-cell))
          (set! evict-idx idx))
        (+! idx 1))
      (when (>= evict-idx 0)
        (mod-punishment-result-remove! evict-idx)
        (set! count (-> *MOD-punishment-bank* result-count))))
    (when (< count *mod-punishment-result-queue-capacity*)
      (set! (-> (-> *MOD-punishment-bank* result-ids) count) punishment)
      (set! (-> (-> *MOD-punishment-bank* result-tasks) count) task)
      (when (= count 0)
        (set! (-> *MOD-punishment-bank* result-until) (+ (current-time) (mod-punishment-result-duration punishment))))
      (+! (-> *MOD-punishment-bank* result-count) 1)))
  (none))

;; Advance to the next queued result.
(defun mod-punishment-results-update! ()
  (when (and (> (-> *MOD-punishment-bank* result-count) 0) (<= (-> *MOD-punishment-bank* result-until) (current-time)))
    (mod-punishment-result-remove! 0)
    (when (> (-> *MOD-punishment-bank* result-count) 0)
      (set! (-> *MOD-punishment-bank* result-until)
            (+ (current-time) (mod-punishment-result-duration (-> (-> *MOD-punishment-bank* result-ids) 0))))))
  (none))

(defun mod-rule-clear-slot-outcomes! ()
  (dotimes (slot *mod-rule-slot-count*)
    (set! (mod-slot-ref slot-outcomes slot) 'none))
  (mod-punishment-results-clear!)
  (none))

(defun mod-punishment-duration ((punishment symbol))
  (cond
    ((eq? punishment 'punishment-blind) (seconds 10))
    ((eq? punishment 'punishment-fall-damage) (seconds 120))
    ((eq? punishment 'punishment-trip) (seconds 120))
    ((eq? punishment 'punishment-edge) (seconds 240))
    ((eq? punishment 'punishment-delay) (seconds 60))
    ((eq? punishment 'punishment-iframes) (seconds 180))
    ((eq? punishment 'punishment-camera) (seconds 120))
    ((eq? punishment 'punishment-ohko) (seconds 120))
    ((eq? punishment 'punishment-kick) (seconds 180))
    ((eq? punishment 'punishment-pause) (seconds 180))
    (else 0)))

(defun mod-find-timed-punishment-slot ((punishment symbol))
  (mod-symbol-index (-> *MOD-punishment-bank* timed-punishments) punishment))

(defun mod-first-free-timed-punishment-slot ()
  (let ((slot 0)
        (result -1))
    (while (and (< slot *mod-timed-punishment-slot-count*) (< result 0))
      (when (not (-> (-> *MOD-punishment-bank* timed-punishments) slot))
        (set! result slot))
      (+! slot 1))
    result))

(defun mod-start-timed-punishment ((punishment symbol))
  (let ((duration (mod-punishment-duration punishment)))
    (when (> duration 0)
      (let ((slot (mod-find-timed-punishment-slot punishment)))
        (when (< slot 0)
          (set! slot (mod-first-free-timed-punishment-slot)))
        (when (>= slot 0)
          (set! (-> (-> *MOD-punishment-bank* timed-punishments) slot) punishment)
          (set! (-> (-> *MOD-punishment-bank* timed-end-times) slot) (+ (current-time) duration))
          (set! (-> (-> *MOD-punishment-bank* timed-next-ticks) slot) (+ (current-time) (seconds 1)))))))
  (none))

(defun mod-timed-punishment-active? ((punishment symbol))
  (let ((slot (mod-find-timed-punishment-slot punishment)))
    (and (>= slot 0) (> (-> (-> *MOD-punishment-bank* timed-end-times) slot) (current-time)))))

(defun mod-clear-timed-punishment-slot ((slot int))
  (set! (-> (-> *MOD-punishment-bank* timed-punishments) slot) #f)
  (set! (-> (-> *MOD-punishment-bank* timed-end-times) slot) 0)
  (set! (-> (-> *MOD-punishment-bank* timed-next-ticks) slot) 0)
  (none))

(defun mod-end-timed-punishment ((punishment symbol))
  (case punishment
    (('punishment-fall-damage)
     (set! (-> *TARGET-bank* fall-far) (meters 30))
     (set! (-> *TARGET-bank* fall-far-inc) (meters 20)))
    (('punishment-delay) (input-delay-enable! #f 0.0))
    (('punishment-iframes) (set! (-> *TARGET-bank* hit-invulnerable-timeout) (seconds 3))))
  (none))

(defun mod-can-menu-pause? ()
  (the symbol
       (and (progress-allowed?)
            (not *progress-process*)
            (not (mod-rule-active? 'rule-qte))
            (not (mod-rule-active? 'rule-math-quiz))
            (not (mod-rule-active? 'rule-trivia))
            ;; (not (mod-rule-active? 'rule-red-light))
            )))

(defun mod-timed-punishment-roll? ((slot int) (chance int))
  (when (>= (current-time) (-> (-> *MOD-punishment-bank* timed-next-ticks) slot))
    (set! (-> (-> *MOD-punishment-bank* timed-next-ticks) slot) (+ (current-time) (seconds 1)))
    (= (mod-rand-punish-int-range 0 chance) 0)))

(defun mod-update-timed-punishments ()
  (dotimes (slot *mod-timed-punishment-slot-count*)
    (let ((punishment (-> (-> *MOD-punishment-bank* timed-punishments) slot)))
      (when punishment
        (if (>= (current-time) (-> (-> *MOD-punishment-bank* timed-end-times) slot))
          (begin
            (mod-end-timed-punishment punishment)
            (mod-clear-timed-punishment-slot slot)
            (sound-play "menu-stats"))
          (begin
            (when (and (eq? punishment 'punishment-trip) (mod-timed-punishment-roll? slot 12))
              (send-event *target* 'loading))
            (when (and (eq? punishment 'punishment-pause) (mod-timed-punishment-roll? slot 12))
              (when (mod-can-menu-pause?)
                (activate-progress *dproc* (progress-screen fuel-cell)))))))))
  (none))

(defun mod-rule-update-hang-time ()
  (when (mod-rule-active? 'rule-hang-time)
    (let ((slot (mod-rule-find-active-slot 'rule-hang-time)))
      (when (>= slot 0)
        (let ((goal-frames (* (mod-rule-counter-goal 'rule-hang-time) (seconds 1))))
          (if (mod-target-airborne?)
            (let* ((elapsed (- (current-time) (-> *MOD-rule-context-bank* hang-time-air-start)))
                   (whole-seconds (min (mod-rule-counter-goal 'rule-hang-time) (the int (/ elapsed (seconds 1))))))
              (set! (mod-slot-ref slot-progress slot) whole-seconds)
              (when (>= elapsed goal-frames)
                (mod-rule-resolve! slot 'success #f)))
            (begin
              (set! (-> *MOD-rule-context-bank* hang-time-air-start) (current-time))
              (set! (mod-slot-ref slot-progress slot) 0)))))))
  (none))

;; Mark a slot as pending a new roll. A pending roll is only scheduled when something can roll.
(defun mod-rule-schedule-slot ((slot int) (id symbol) (apply-buffer symbol))
  (when (and (> (mod-rule-target-slot-count) 0)
             (>= slot 0)
             (< slot *mod-rule-slot-count*)
             id
             (or (not (eq? id 'mod-rule-pending-roll)) (mod-rule-roll-possible?)))
    (set! (mod-slot-ref pending-slots slot) id)
    (set! (mod-slot-ref roll-ready-times slot)
          (+ (current-time) (if apply-buffer (the time-frame (* (the float TICKS_PER_SECOND) (new-condition-delay-seconds))) 0))))
  (none))

;; Schedule rolls into free slots until the target count is reached.
(defun mod-rule-fill-to-target! ()
  (dotimes (i *mod-rule-slot-count*)
    (let ((free (mod-rule-first-free-slot)))
      (when (and (>= free 0) (< (mod-rule-active-slot-count) (mod-rule-target-slot-count)))
        (mod-rule-schedule-slot free 'mod-rule-pending-roll #t))))
  (none))

;; ID of the first active slot.
(defun mod-rule-current-active-id ()
  (let ((slot 0)
        (found #f)
        (result #f))
    (while (and (< slot *mod-rule-slot-count*) (not found))
      (let ((candidate (mod-slot-ref active-slots slot))) (when candidate (set! result candidate) (set! found #t)))
      (+! slot 1))
    result))

;; True if any loaded level has a fuel-cell actor for this task.
(defun mod-task-has-fuel-cell-entity? ((task game-task))
  (let ((level-idx 0)
        (found #f))
    (while (and (< level-idx (-> *level* length)) (not found))
      (let* ((lev (-> *level* level level-idx))
             (entities (-> lev bsp level entity))
             (entity-idx 0))
        (while (and (< entity-idx (-> entities length)) (not found))
          (let ((ent (-> entities data entity-idx entity)))
            (when (and ent
                       (type-type? (-> ent type) entity-actor)
                       (= (-> (the-as entity-actor ent) etype) fuel-cell)
                       (= (-> ent extra perm task) task))
              (set! found #t)))
          (+! entity-idx 1)))
      (+! level-idx 1))
    found))

(defun mod-cell-task-complete? ((task game-task))
  (and (nonzero? task) (!= task (game-task complete)) (task-complete? *game-info* task)))

(defun mod-cell-task-blacklisted? ((task game-task))
  (let ((idx 0)
        (blocked #f))
    (while (and (< idx (length *mod-revert-cell-task-blacklist*)) (not blocked))
      (when (= (-> *mod-revert-cell-task-blacklist* idx) task)
        (set! blocked #t))
      (+! idx 1))
    blocked))

(defun mod-cell-task-revert-eligible? ((task game-task))
  (and (mod-cell-task-complete? task) (not (mod-cell-task-blacklisted? task))))

(defun mod-collected-cell-candidate-count ()
  (let ((idx 0)
        (count 0))
    (while (< idx (length *mod-all-cell-tasks*))
      (when (mod-cell-task-revert-eligible? (-> *mod-all-cell-tasks* idx))
        (+! count 1))
      (+! idx 1))
    count))

(defun mod-can-revert-collected-cell? ()
  (> (mod-collected-cell-candidate-count) 0))

(defun mod-reopen-task-stage ((task game-task))
  (when (task-closed? task (task-status need-reward-speech))
    (open-specific-task! task (task-status need-reward-speech)))
  (when (task-closed? task (task-status need-resolution))
    (open-specific-task! task (task-status need-resolution)))
  (when (task-closed? task (task-status unknown))
    (open-specific-task! task (task-status unknown)))
  (none))

(defun mod-force-open-task-stage ((task game-task))
  (when (task-exists? task (task-status need-reward-speech))
    (open-specific-task! task (task-status need-reward-speech)))
  (when (task-exists? task (task-status need-resolution))
    (open-specific-task! task (task-status need-resolution)))
  (when (task-exists? task (task-status unknown))
    (open-specific-task! task (task-status unknown)))
  (none))

