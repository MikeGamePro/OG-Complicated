(defun mod-revert-random-collected-cell ()
  (let ((candidate-count (mod-collected-cell-candidate-count))
        (chosen-task (game-task none)))
    (when (> candidate-count 0)
      (let* ((pick (mod-rand-punish-int-range 0 candidate-count))
             (remaining pick)
             (idx 0))
        (while (and (< idx (length *mod-all-cell-tasks*)) (= chosen-task (game-task none)))
          (let ((task (-> *mod-all-cell-tasks* idx)))
            (when (mod-cell-task-revert-eligible? task)
              (if (= remaining 0) (set! chosen-task task) (+! remaining -1))))
          (+! idx 1))
        (when (!= chosen-task (game-task none))
          (let ((task-perm (-> *game-info* task-perm-list data chosen-task)))
            (logclear! (-> task-perm status) (entity-perm-status complete real-complete))
            (set! (-> task-perm user-uint8 0) (min (-> task-perm user-uint8 0) (the-as uint (task-status need-reminder)))))
          (mod-reopen-task-stage chosen-task)
          (mod-force-open-task-stage chosen-task)
          (let ((perm-list (-> *game-info* perm-list))
                (idx2 0))
            (while (< idx2 (-> perm-list length))
              (let ((perm2 (-> perm-list data idx2)))
                (when (= (-> perm2 task) chosen-task)
                  (logclear! (-> perm2 status) (entity-perm-status dead))))
              (+! idx2 1)))
          (let ((level-idx 0)
                (spawned #f))
            (while (< level-idx (-> *level* length))
              (let ((lev (-> *level* level level-idx)))
                (when (= (-> lev status) 'active)
                  (let ((entities (-> lev bsp level entity))
                        (entity-idx 0))
                    (while (< entity-idx (-> entities length))
                      (let ((ent (-> entities data entity-idx entity)))
                        (when (and ent
                                   (type-type? (-> ent type) entity-actor)
                                   (= (-> (the-as entity-actor ent) etype) fuel-cell)
                                   (= (-> ent extra perm task) chosen-task))
                          (update-perm! (-> ent extra perm) 'game (the-as entity-perm-status MOD_REVERT_PERM_STATUS))
                          (when (not spawned)
                            (entity-birth-no-kill ent)
                            (set! spawned #t))))
                      (+! entity-idx 1)))))
              (+! level-idx 1)))
          (set! (-> *game-info* fuel) (max 0.0 (- (-> *game-info* fuel) 1.0))))))
    chosen-task))

(defun mod-target-on-racer? ()
  (if (not *target*) #f (let ((mode (send-event *target* 'query 'mode))) (= mode 'racer))))

(defun mod-target-on-flut? ()
  (if (not *target*) #f (let ((mode (send-event *target* 'query 'mode))) (= mode 'flut))))

(defun mod-target-on-racer-or-flut? ()
  (or (mod-target-on-racer?) (mod-target-on-flut?)))

(defun mod-target-has-eco-type? ((eco-type pickup-type))
  (the symbol (and *target* (= (-> *target* fact eco-type) eco-type) (>= (-> *target* fact eco-level) 1.0))))

;; Toggle Jak's mesh invisibility by zeroing every effect's envmap-usage.
(defun mod-target-mesh-invis-set! ((on symbol))
  (when (and on (not (-> *MOD-target-mesh-bank* invis-active?)))
    (set! (-> *MOD-target-mesh-bank* invis-active?) #t)
    (let* ((lods (-> *target* draw lod-set))
           (max-lod (-> lods max-lod))
           (idx 0))
      (dotimes (i (+ max-lod 1))
        (let* ((ctrl (-> lods lod i geo))
               (effect-count (-> ctrl header effect-count)))
          (dotimes (j effect-count)
            (let ((eff (-> ctrl effect j)))
              (set! (-> *MOD-target-mesh-bank* envmap-save idx) (the-as int (-> eff envmap-usage)))
              (set! (-> eff envmap-usage) 0))
            (set! idx (+ idx 1)))))))
  (when (and (not on) (-> *MOD-target-mesh-bank* invis-active?))
    (set! (-> *MOD-target-mesh-bank* invis-active?) #f)
    (let* ((lods (-> *target* draw lod-set))
           (max-lod (-> lods max-lod))
           (idx 0))
      (dotimes (i (+ max-lod 1))
        (let* ((ctrl (-> lods lod i geo))
               (effect-count (-> ctrl header effect-count)))
          (dotimes (j effect-count)
            (let ((eff (-> ctrl effect j))) (set! (-> eff envmap-usage) (the-as uint8 (-> *MOD-target-mesh-bank* envmap-save idx))))
            (set! idx (+ idx 1)))))))
  (none))

(defun mod-invisible-man-restore! ()
  (when *target*
    (mod-target-mesh-invis-set! #f)
    (set-vector! (-> *target* draw color-mult) 1.0 1.0 1.0 1.0)
    (send-event *target* 'sidekick #t)
    (let ((v1-9 (-> *target* draw shadow-ctrl))) (logclear! (-> v1-9 settings flags) (shadow-flags disable-draw))))
  (none))

;; True if an active slot already has this punishment assigned.
(defun mod-punishment-used-by-active-slot? ((punishment symbol))
  (let ((slot 0)
        (used #f))
    (while (and (< slot *mod-rule-slot-count*) (not used))
      (when (and (mod-slot-ref active-slots slot) (eq? (mod-slot-ref slot-punishments slot) punishment))
        (set! used #t))
      (+! slot 1))
    used))

(defun mod-punishment-rollable? ((punishment symbol))
  ;; reset and time loss have no lingering state, so several slots may hold them at once
  (and (not (mod-timed-punishment-active? punishment))
       (or (eq? punishment 'punishment-reset)
           (eq? punishment 'punishment-countdown)
           (not (mod-punishment-used-by-active-slot? punishment)))))

(defmacro consider-punishment (sym weight &rest conds)
  `(when (and ,@conds (punishment-toggle-enabled? ',sym) (mod-punishment-rollable? ',sym))
    (let ((w ,weight)) (+! running-total w) (when (< (mod-rand-punish-int-range 0 running-total) w) (set! selected ',sym)))))

;; Defaults to time loss if nothing else is chosen.
(defun mod-random-available-punishment ((rule-id symbol))
  (let ((selected 'punishment-countdown)
        (running-total 0))
    (consider-punishment punishment-countdown
                         10
                         (not (or (eq? rule-id 'rule-for-billy)
                                  (eq? rule-id 'rule-orb-hunt)
                                  (and (eq? rule-id 'rule-sniper) (eq? (current-level-name) 'beach)))))
    (consider-punishment punishment-fall-damage
                         10
                         (not (or (eq? (current-level-name) 'finalboss) (mod-target-on-racer-or-flut?))))
    (consider-punishment punishment-trip 10 (not (mod-target-on-racer-or-flut?)))
    (consider-punishment punishment-edge 10 (not (eq? (current-level-name) 'finalboss)) (not (mod-target-on-racer-or-flut?)))
    (consider-punishment punishment-money
                         (if (>= (current-cell-count) 72) 5 10)
                         (>= (current-orb-count) (-> *MOD-tuning-bank* money-punishment-min-orbs))
                         (not (or (eq? (current-level-name) 'citadel) (eq? (current-level-name) 'finalboss) (eq? (current-level-name) 'lavatube))))
    (consider-punishment punishment-warp 8 (!= (-> (level-get-target-inside *level*) name) 'training))
    (consider-punishment punishment-revert-cell
                         7
                         (mod-can-revert-collected-cell?)
                         (not (and (or (eq? (current-level-name) 'lavatube) (eq? (current-level-name) 'citadel) (eq? (current-level-name) 'finalboss))
                                   (< (current-cell-count) 90))))
    (consider-punishment punishment-extra-rule 10 (<= (+ (mod-rule-active-slot-count) 2) *mod-rule-slot-count*))
    (consider-punishment punishment-crash 6 (not (eq? rule-id 'rule-qte)))
    (consider-punishment punishment-delay 10 (not (mod-rule-active? 'complication-bad-ping)))
    (consider-punishment punishment-blind 10)
    (consider-punishment punishment-iframes 10)
    (consider-punishment punishment-camera 10)
    (consider-punishment punishment-kick 10)
    (consider-punishment punishment-ohko 10)
    (consider-punishment punishment-pause 10)
    (consider-punishment punishment-reset 3 (not (eq? rule-id 'rule-qte)))
    selected))

(defun play-custom-sfx ((filename string) (base-volume float))
  (let* ((sfx-vol (-> *setting-control* current sfx-volume))
         (scaled-vol (the int (* base-volume (/ sfx-vol 100.0)))))
    (play-sound-file filename scaled-vol)))

(defun mod-rule-lights-out-activate! ()
  (set! (-> *MOD-lights-out-bank* active?) #t)
  (dotimes (i (-> *level* length))
    (let ((lev (-> *level* level i)))
      (cond
        ((and (= (-> lev name) 'maincave) (!= (-> lev mood-func) update-mood-lights-out))
         (set! (-> *MOD-lights-out-bank* maincave-mood) (-> lev mood))
         (set! (-> *MOD-lights-out-bank* maincave-mood-func) (-> lev mood-func))
         (set! (-> lev mood) *lights-out-mood*)
         (set! (-> lev mood-func) update-mood-lights-out))
        ((and (= (-> lev name) 'robocave) (!= (-> lev mood-func) update-mood-lights-out))
         (set! (-> *MOD-lights-out-bank* robocave-mood) (-> lev mood))
         (set! (-> *MOD-lights-out-bank* robocave-mood-func) (-> lev mood-func))
         (set! (-> lev mood) *lights-out-mood*)
         (set! (-> lev mood-func) update-mood-lights-out)))))
  (none))

(defun mod-rule-lights-out-deactivate! ()
  (set! (-> *MOD-lights-out-bank* active?) #f)
  (dotimes (i (-> *level* length))
    (let ((lev (-> *level* level i)))
      (cond
        ((and (= (-> lev name) 'maincave) (= (-> lev mood-func) update-mood-lights-out))
         (set! (-> lev mood) (-> *MOD-lights-out-bank* maincave-mood))
         (set! (-> lev mood-func) (-> *MOD-lights-out-bank* maincave-mood-func)))
        ((and (= (-> lev name) 'robocave) (= (-> lev mood-func) update-mood-lights-out))
         (set! (-> lev mood) (-> *MOD-lights-out-bank* robocave-mood))
         (set! (-> lev mood-func) (-> *MOD-lights-out-bank* robocave-mood-func))))))
  (none))

(defun mod-level-loaded? ((level-name symbol))
  (let ((result #f))
    (dotimes (i (-> *level* length))
      (let ((lev (-> *level* level i)))
        (when (and (= (-> lev name) level-name) (or (= (-> lev status) 'active) (= (-> lev status) 'loaded)))
          (set! result #t))))
    result))

(defmacro mod-set-platform-gravity! (level-name constants factor)
  `(when (and (mod-level-loaded? ,level-name) ,constants (nonzero? ,constants))
    (set! (-> ,constants gravity-factor) ,factor)))

(defun mod-rule-set-drought-platform-gravity! ((disabled? symbol))
  (let ((factor (if disabled? 0.0 1.0)))
    (mod-set-platform-gravity! 'village2 *pontoonfive-constants* factor)
    (mod-set-platform-gravity! 'village2 *pontoonten-constants* factor)
    (mod-set-platform-gravity! 'training *tra-pontoon-constants* factor)
    ;; (mod-set-platform-gravity! 'ogre *ogre-isle-constants* factor)
    (mod-set-platform-gravity! 'misty *bone-platform-constants* factor)
    (mod-set-platform-gravity! 'sunken *qbert-plat-constants* factor))
  (none))

;; Apply or re-apply the one-time effect of a condition.
(defun mod-rule-reapply-slot-visual-effect ((id symbol))
  (cond
    ((eq? id 'complication-mirror) (set! *mod-mirror-active?* #t))
    ((eq? id 'complication-hidden-treasure) (mod-refresh-money-actors #f))
    ((eq? id 'complication-drought) (mod-rule-set-drought-platform-gravity! #t))
    ((eq? id 'complication-cumbersome) (mod-orb-weight-apply!))
    ((eq? id 'complication-interference) (when (mod-low-res-should-apply?) (mod-apply-low-res!)))
    ((eq? id 'complication-invisible-man)
     (when *target*
       (mod-target-mesh-invis-set! #t)
       (set-vector! (-> *target* draw color-mult) 1.0 1.0 1.0 0.0)
       (send-event *target* 'sidekick #f)
       (let ((v1-9 (-> *target* draw shadow-ctrl))) (logior! (-> v1-9 settings flags) (shadow-flags disable-draw)))))
    ((eq? id 'complication-bad-ping) (input-delay-enable! #t (-> *MOD-tuning-bank* bad-ping-input-delay)))
    ((eq? id 'complication-lights-out) (mod-rule-lights-out-activate!))
    ((eq? id 'complication-jak-rabbit)
     (set! (-> *TARGET-bank* jump-height-min) (meters 2.02))
     (set! (-> *TARGET-bank* jump-height-max) (meters 7))
     (set! (-> *TARGET-bank* double-jump-height-min) (meters 2))
     (set! (-> *TARGET-bank* double-jump-height-max) (meters 5))
     (set! (-> *TARGET-bank* flip-jump-height-min) (meters 10))
     (set! (-> *TARGET-bank* flip-jump-height-max) (meters 14))
     (set! (-> *TARGET-bank* duck-jump-height-min) (meters 10))
     (set! (-> *TARGET-bank* duck-jump-height-max) (meters 14))
     (set! (-> *TARGET-bank* flop-jump-height-min) (meters 10))
     (set! (-> *TARGET-bank* flop-jump-height-max) (meters 14))
     (set! (-> *TARGET-bank* swim-jump-height-min) (meters 10))
     (set! (-> *TARGET-bank* swim-jump-height-max) (meters 10))
     (set! (-> *TARGET-bank* tube-jump-height-min) (meters 3.5))
     (set! (-> *TARGET-bank* tube-jump-height-max) (meters 5))
     (set! (-> *FLUT-bank* jump-height-min) (meters 10))
     (set! (-> *FLUT-bank* jump-height-max) (meters 14))
     (set! (-> *FLUT-bank* double-jump-height-min) (meters 2))
     (set! (-> *FLUT-bank* double-jump-height-max) (meters 4)))
    ((eq? id 'complication-jak-be-nimble)
     (mod-refresh-movement-speeds! #t (if (mod-rule-active? 'complication-cumbersome) (mod-orb-weight-multiplier) 1.0))
     (set! (-> *high-jump-mods* target-speed) 77777.0)
     (set! (-> *duck-attack-mods* target-speed) 77777.0)
     (set! (-> *flop-mods* target-speed) 77777.0)
     (set! (-> *stone-surface* target-speed) 1.25))
    ((eq? id 'complication-joyride) (send-event *target* 'change-mode 'flut #f))
    ((eq? id 'complication-shifty)
     (set! (-> *MOD-rule-context-bank* shifty-next-time) (+ (current-time) (seconds (mod-rand-int-range 1 9)))))
    (else (none)))
  (none))

(define *mod-rule-rgyb-handles* (new 'global 'boxed-array handle 128))

(define *mod-rule-rgyb-count* 0)

(defun mod-rgyb-opposite-eco ((typ pickup-type))
  (cond
    ((= typ (pickup-type eco-blue)) (pickup-type eco-yellow))
    ((= typ (pickup-type eco-yellow)) (pickup-type eco-blue))
    (else typ)))

;; RGYB: rebuild one eco pickup so it matches the current swap state.
(defun mod-rule-rgyb-refresh-one ((p eco-collectable))
  (let* ((ent (-> p entity))
         (cluster? (and ent (nonzero? ent) (= (-> ent extra process) p)))
         (state-name (-> p state name))
         (collected? (or (= state-name 'die) (= state-name 'pickup)))
         (orig (-> p pickup-type))
         (want (rgyb-swap-eco-type orig))
         (skip? (or (= (-> p fact pickup-type) want)
                    (if cluster? (logtest? (-> ent extra perm status) (entity-perm-status dead)) collected?))))
    (when (not skip?)
      (if (nonzero? (-> p part)) (kill-and-free-particles (-> p part)))
      (if (nonzero? (-> p sound)) (stop! (-> p sound)))
      (cond
        (cluster?
         ;; entity-placed: rebirth from the entity so init-from-entity! re-derives the original type
         (deactivate p)
         (set! (-> ent extra process) (the-as process #f))
         (entity-birth-no-kill ent)
         ;; keep already-collected clusters collected
         (if (and collected? (-> ent extra process)) (send-event (-> ent extra process) 'die)))
        (else
         ;; drop: no entity, so spawn a replacement from the original type (initialize-effect applies the swap) and copy its state over
         ;; Keep the ORIGINAL PARENT (usually the crate). *active-pool* children are never cleaned up by reset-actors or level unload, and blue/yellow drops never fade.
         (let ((new-ptr (birth-pickup-at-point (-> p root trans) orig 1.0 #f (ppointer->process (-> p parent)) (the-as fact-info #f))))
           (when new-ptr
             (let ((np (the-as eco-collectable (ppointer->process new-ptr))))
               (set! (-> np flags) (-> p flags))
               (set! (-> np base quad) (-> p base quad))
               (set! (-> np root transv quad) (-> p root transv quad))
               (set! (-> np birth-time) (-> p birth-time))
               (set! (-> np fadeout-timeout) (-> p fadeout-timeout))
               (set! (-> np fact options) (-> p fact options))
               (deactivate p))))))))
  (none))

;; RGYB: collect handles of all blue/yellow eco processes then refresh each.
(defun mod-rule-rgyb-refresh-eco-clusters ()
  (kill-by-name 'mod-rule-rgyb-refresh *active-pool*)
  (process-spawn-function process
    (lambda ()
      (suspend)
      (suspend)
      ;; refreshing spawns/kills eco processes, so never do it mid-iteration
      (set! *mod-rule-rgyb-count* 0)
      (iterate-process-tree *active-pool*
                            (lambda ((p process))
                              (when (and (or (type-type? (-> p type) eco-blue) (type-type? (-> p type) eco-yellow)) (< *mod-rule-rgyb-count* 128))
                                (set! (-> *mod-rule-rgyb-handles* *mod-rule-rgyb-count*) (process->handle p))
                                (+! *mod-rule-rgyb-count* 1))
                              #f)
                            *null-kernel-context*)
      (dotimes (i *mod-rule-rgyb-count*)
        (let ((p (the-as eco-collectable (handle->process (-> *mod-rule-rgyb-handles* i)))))
          (when p
            (mod-rule-rgyb-refresh-one p)))))
    :name 'mod-rule-rgyb-refresh)
  (none))

(defun mod-rule-start-palate-change-grace! ()
  (when (and *target* (= (send-event *target* 'query 'mode) 'target-fishing))
    (set! (-> *MOD-rule-context-bank* palate-change-grace-until) (+ (current-time) (seconds 1))))
  (none))

(defun mod-rule-palate-change-grace-active? ()
  (> (-> *MOD-rule-context-bank* palate-change-grace-until) (current-time)))

;; (0 +, 1 -, 2 *)
(defun mod-math-quiz-compute-answer! ()
  (cond
    ((= (-> *MOD-quiz-bank* math-op) 0)
     (set! (-> *MOD-quiz-bank* math-answer) (+ (-> *MOD-quiz-bank* math-val1) (-> *MOD-quiz-bank* math-val2))))
    ((= (-> *MOD-quiz-bank* math-op) 1)
     (set! (-> *MOD-quiz-bank* math-answer) (- (-> *MOD-quiz-bank* math-val1) (-> *MOD-quiz-bank* math-val2))))
    ((= (-> *MOD-quiz-bank* math-op) 2)
     (set! (-> *MOD-quiz-bank* math-answer) (* (-> *MOD-quiz-bank* math-val1) (-> *MOD-quiz-bank* math-val2)))))
  (none))

;; Per-condition setup when it activates.
(defun mod-rule-on-activate ((id symbol))
  (cond
    ((eq? id 'rule-qte) (set! (-> *MOD-rule-context-bank* qte-target-button) (mod-rand-int-range 0 4)))
    ((eq? id 'complication-palate-change) (mod-rule-start-palate-change-grace!))
    ((eq? id 'complication-twisted)
     (set! (-> *MOD-rule-context-bank* twist-pending-count) (+ (-> *MOD-stats-bank* rules-rolled) (mod-rand-int-range 2 4))))
    ((eq? id 'rule-hitlist) (dotimes (slot 3) (set! (-> *mod-unique-enemy-killed-types* slot) #f)))
    ((eq? id 'rule-double-kill) (set! (-> *MOD-rule-context-bank* last-kill-time) 0))
    ((eq? id 'rule-distancing) (set! *closest-buzzer-dist* 1000000000.0))
    ((eq? id 'complication-rgyb) (mod-rule-rgyb-refresh-eco-clusters))
    ((eq? id 'rule-hang-time) (set! (-> *MOD-rule-context-bank* hang-time-air-start) (current-time)))
    ((eq? id 'complication-get-a-grip) (set! (-> *MOD-rule-context-bank* get-a-grip-last-grab) (current-time)))
    ((eq? id 'complication-bus-driver) (set! (-> *MOD-rule-context-bank* bus-driver-activate-time) (current-time)))
    ((eq? id 'complication-vibe-check)
     (play-custom-sfx "I like ya cut g.mp3" 40.0)
     (process-spawn-function process
       (lambda ()
         (let ((start-time (current-time))) (until (>= (- (current-time) start-time) (seconds 1.35)) (suspend)))
         (when (and *target* (mod-rule-active? 'complication-vibe-check))
           (if (and (< (-> (the-as fact-info-target (-> *target* fact)) health) 2.0) (mod-target-on-racer?))
             (target-attack-up *target* 'attack 'explode)
             (send-event *target* 'attack #f (static-attack-info ((shove-back (meters 999)) (shove-up (meters 20))))))))))
    ((eq? id 'complication-energy-boost)
     (let* ((no-green? (and *target*
                            (let ((fact (the-as fact-info-target (-> *target* fact))))
                              (and (>= (-> fact health) (-> fact health-max)) (>= (-> fact eco-pill) (-> *FACT-bank* eco-pill-max-default))))))
            (pick (mod-rand-int-range 0 (if no-green? 3 4)))
            (eco-type (case pick
                        ((0) (pickup-type eco-red))
                        ((1) (pickup-type eco-blue))
                        ((2) (pickup-type eco-yellow))
                        (else (pickup-type eco-green)))))
       (when *target*
         (if (= eco-type (pickup-type eco-blue))
           (begin
             (protect ((-> *target* event-hook))
               (set! (-> *target* event-hook) target-generic-event-handler)
               (send-event *target* 'get-pickup eco-type (-> *FACT-bank* eco-full-inc)))
             (send-event *target* 'boost (-> *FACT-bank* eco-single-inc)))
           (send-event *target* 'get-pickup eco-type (-> *FACT-bank* eco-full-inc))))))
    ((eq? id 'rule-trivia)
     (set! (-> *MOD-quiz-bank* trivia-current-question) (mod-trivia-pick-question))
     (set! (-> *MOD-quiz-bank* trivia-current-guess) -1)
     (set! (-> *MOD-quiz-bank* trivia-dynamic-seed) (mod-rand-int-range 0 4096)))
    ((eq? id 'rule-math-quiz)
     (set! (-> *MOD-quiz-bank* math-op) (mod-rand-int-range 0 3))
     (let ((min-val (if (= (-> *MOD-quiz-bank* math-op) 2) 2 10))
           (max-val (if (= (-> *MOD-quiz-bank* math-op) 2) 13 61)))
       (set! (-> *MOD-quiz-bank* math-val1) (mod-rand-int-range min-val max-val))
       (set! (-> *MOD-quiz-bank* math-val2) (mod-rand-int-range min-val max-val)))
     (set! (-> *MOD-quiz-bank* math-current-guess) 0)
     (mod-math-quiz-compute-answer!))
    (else (none)))
  (mod-rule-reapply-slot-visual-effect id)
  (none))

;; Deactivate a slot and undo the condition's effects.
(defun mod-rule-deactivate-slot ((slot int))
  (when (and (>= slot 0) (< slot *mod-rule-slot-count*))
    (when (= slot (-> *MOD-rule-context-bank* twist-marked-slot))
      (set! (-> *MOD-rule-context-bank* twist-marked-slot) -1))
    (let ((id (mod-slot-ref active-slots slot)))
      (when id
        (when (eq? id 'complication-palate-change)
          (mod-rule-start-palate-change-grace!))
        (cond
          ((and *target*
                (> (-> (the-as fact-info-target (-> *target* fact)) health) 0)
                (or (eq? id 'complication-ohko) (eq? id 'rule-survivor)))
           (set! (-> (the-as fact-info-target (-> *target* fact)) health) 3.0))
          ((eq? id 'complication-hidden-treasure) (mod-refresh-money-actors #t))
          ((eq? id 'complication-mirror) (set! *mod-mirror-active?* #f))
          ((eq? id 'complication-cumbersome) (mod-orb-weight-reset!))
          ((eq? id 'complication-drought) (mod-rule-set-drought-platform-gravity! #f))
          ((eq? id 'complication-bad-ping) (input-delay-enable! #f 0.0))
          ((eq? id 'complication-lights-out) (mod-rule-lights-out-deactivate!))
          ((eq? id 'complication-rgyb) (mod-rule-rgyb-refresh-eco-clusters))
          ((and *target* (eq? id 'complication-glare))
           (logclear! (-> *target* mask) (process-mask sleep))
           (set! (-> *MOD-rule-context-bank* mean-look-clear-time) 0))
          ((and *target* (eq? id 'complication-joyride) (mod-target-on-flut?)) (send-event *target* 'end-mode))
          ((eq? id 'complication-invisible-man) (mod-invisible-man-restore!))
          ((eq? id 'complication-jak-rabbit)
           (set! (-> *TARGET-bank* jump-height-min) (meters 1.01))
           (set! (-> *TARGET-bank* jump-height-max) (meters 3.5))
           (set! (-> *TARGET-bank* double-jump-height-min) (meters 1))
           (set! (-> *TARGET-bank* double-jump-height-max) (meters 2.5))
           (set! (-> *TARGET-bank* flip-jump-height-min) (meters 5))
           (set! (-> *TARGET-bank* flip-jump-height-max) (meters 7))
           (set! (-> *TARGET-bank* duck-jump-height-min) (meters 5))
           (set! (-> *TARGET-bank* duck-jump-height-max) (meters 7))
           (set! (-> *TARGET-bank* flop-jump-height-min) (meters 5))
           (set! (-> *TARGET-bank* flop-jump-height-max) (meters 7))
           (set! (-> *TARGET-bank* swim-jump-height-min) (meters 5))
           (set! (-> *TARGET-bank* swim-jump-height-max) (meters 5))
           (set! (-> *TARGET-bank* tube-jump-height-min) (meters 1.75))
           (set! (-> *TARGET-bank* tube-jump-height-max) (meters 2.5))
           (set! (-> *FLUT-bank* jump-height-min) (meters 5))
           (set! (-> *FLUT-bank* jump-height-max) (meters 7))
           (set! (-> *FLUT-bank* double-jump-height-min) (meters 1))
           (set! (-> *FLUT-bank* double-jump-height-max) (meters 2)))
          ((eq? id 'complication-jak-be-nimble)
           (mod-refresh-movement-speeds! #f (if (mod-rule-active? 'complication-cumbersome) (mod-orb-weight-multiplier) 1.0))
           (set! (-> *high-jump-mods* target-speed) 26624.0)
           (set! (-> *duck-attack-mods* target-speed) 16384.0)
           (set! (-> *flop-mods* target-speed) 40960.0)
           (set! (-> *stone-surface* target-speed) 1.0))
          ((eq? id 'rule-orb-hunt) (mod-orb-hunt-clear!)))))
    (mod-rule-clear-slot slot))
  (none))

;; Grace period after activation during which a failure is ignored.
(defun mod-rule-grace-period ((id symbol))
  (cond
    ((eq? id 'rule-side-to-side) (seconds 2))
    ((eq? id 'rule-qte) (seconds 0.7))
    ((eq? id 'rule-red-light) (seconds 1.5))
    (else (seconds 1.25))))

;; Activate a condition in a slot. Useful!
(defun mod-rule-activate-slot ((slot int) (id symbol))
  (when (and (>= slot 0) (< slot *mod-rule-slot-count*) id)
    (mod-rule-deactivate-slot slot)
    (set! (mod-slot-ref active-slots slot) id)
    (mod-rule-set-slot-outcome! slot 'none)
    (if (or (eq? id 'rule-qte)
            (eq? id 'rule-math-quiz)
            (eq? id 'rule-trivia)
            (eq? id 'complication-twisted)
            (eq? id 'rule-red-light)
            (eq? id 'complication-palate-change))
      (sound-play "warning")
      (sound-play "ecohit2"))
    (set! (mod-slot-ref slot-goals slot) (mod-rule-counter-goal id))
    (set! (mod-slot-ref slot-progress slot) 0)
    (if (eq? (mod-rule-type id) 'rule)
      (begin
        (set! (mod-slot-ref slot-punishments slot) (mod-random-available-punishment id))
        (+! (-> *MOD-stats-bank* rules-rolled) 1)
        (mod-rule-twist-check-and-mark! slot id))
      (set! (mod-slot-ref slot-punishments slot) #f))
    (set! (mod-slot-ref slot-end-times slot) (+ (current-time) (mod-rule-duration id)))
    (set! (mod-slot-ref slot-grace-periods slot) (+ (current-time) (mod-rule-grace-period id)))
    (mod-rule-on-activate id))
  (none))

(defun mod-clear-all-timed-punishments ()
  (dotimes (slot *mod-timed-punishment-slot-count*)
    (let ((punishment (-> (-> *MOD-punishment-bank* timed-punishments) slot)))
      (when punishment
        (mod-end-timed-punishment punishment))
      (mod-clear-timed-punishment-slot slot)))
  (none))

;; Clear the ring buffer of enemy hits made by the player.
(defun mod-clear-player-hit-cache ()
  (dotimes (idx 64)
    (set! (-> *MOD-hit-bank* player-hit-handles idx) (the-as handle #f))
    (set! (-> *MOD-hit-bank* player-hit-modes idx) #f))
  (set! (-> *MOD-hit-bank* player-hit-write-idx) 0)
  (none))

(defun mod-rule-clear-recent-rolls ()
  (dotimes (slot 8)
    (set! (-> *mod-rule-recent-rolls* slot) #f))
  (none))

;; Reset active rules and punishments. Keeps stats and countdown.
(defun mod-rules-reset-core ()
  (dotimes (slot *mod-rule-slot-count*)
    (mod-rule-deactivate-slot slot))
  (mod-clear-all-timed-punishments)
  (dotimes (slot 3)
    (set! (-> *mod-unique-enemy-killed-types* slot) #f))
  (mod-clear-player-hit-cache)
  (mod-rule-clear-recent-rolls)
  (mod-trivia-clear-used)
  (set! (-> *MOD-rule-context-bank* last-kill-time) 0)
  (set! (-> *MOD-rule-context-bank* twist-pending-count) -1)
  (set! (-> *MOD-rule-context-bank* twist-marked-slot) -1)
  (set! (-> *MOD-rule-context-bank* palate-change-grace-until) 0)
  (set! (-> *MOD-rule-context-bank* red-shockwave-until) 0)
  (set! *mod-rule-idle-recheck-time* 0)
  (set! (-> *MOD-rule-context-bank* roll-possible?) #f)
  (mod-rule-clear-slot-outcomes!)
  (set! (-> *MOD-rule-context-bank* qte-target-button) 0)
  (set! (-> *MOD-rule-context-bank* hang-time-air-start) 0)
  (set! (-> *MOD-rule-context-bank* get-a-grip-last-grab) 0)
  (set! (-> *MOD-rule-context-bank* bus-driver-activate-time) 0)
  (set! (-> *MOD-rule-context-bank* mean-look-clear-time) 0)
  (dotimes (slot *mod-rule-slot-count*)
    (set! (mod-slot-ref saved-remaining-times slot) -1)
    (set! (mod-slot-ref saved-punishments slot) #f)
    (set! (mod-slot-ref saved-pending slot) #f)
    (set! (mod-slot-ref saved-roll-tenths slot) -1))
  (dotimes (slot *mod-timed-punishment-slot-count*)
    (set! (-> (-> *MOD-punishment-bank* timed-saved-ids) slot) #f)
    (set! (-> (-> *MOD-punishment-bank* timed-saved-tenths) slot) -1))
  (none))

;; Reset rules and stats. Keeps countdown.
(defun mod-rules-reset ()
  (mod-rules-reset-core)
  (mod-stats-reset!)
  (none))

;; Stop the countdown process and clear rules after the game is beaten.
(defun mod-run-freeze-for-game-beaten ()
  (kill-by-name 'global-countdown *active-pool*)
  (kill-by-name 'mod-rule-manager *active-pool*)
  (mod-rules-reset-core)
  (set! (-> *MOD-countdown-bank* active?) #f)
  (set! (-> *MOD-countdown-bank* lost?) #f)
  (none))

;; Format ticks as [H:]M:SS with 0-3 decimals.
(defun mod-format-time-frame ((tf time-frame) (decimal-digits int) (hours-mode symbol))
  (let* ((ticks (max 0 (the int tf)))
         (total-seconds (the int (/ ticks (seconds 1))))
         (hours (the int (/ total-seconds 3600)))
         (minutes-full (the int (/ total-seconds 60)))
         (minutes-part (the int (mod minutes-full 60)))
         (seconds-part (the int (mod total-seconds 60)))
         (show-hours? (or (eq? hours-mode 'always) (and (eq? hours-mode 'auto) (> hours 0))))
         (minutes-out (if show-hours? minutes-part minutes-full))
         (frac-tenths (the int (/ (* (mod ticks (seconds 1)) 10) (seconds 1))))
         (frac-hundredths (the int (/ (* (mod ticks (seconds 1)) 100) (seconds 1))))
         (frac-millis (the int (/ (* (mod ticks (seconds 1)) 1000) (seconds 1)))))
    (cond
      ((and show-hours? (= decimal-digits 3))
       (string-format "~D:~2,'0D:~2,'0D.~3,'0D" hours minutes-out seconds-part frac-millis))
      ((and show-hours? (= decimal-digits 2))
       (string-format "~D:~2,'0D:~2,'0D.~2,'0D" hours minutes-out seconds-part frac-hundredths))
      ((and show-hours? (= decimal-digits 1))
       (string-format "~D:~2,'0D:~2,'0D.~1,'0D" hours minutes-out seconds-part frac-tenths))
      (show-hours? (string-format "~D:~2,'0D:~2,'0D" hours minutes-out seconds-part))
      ((= decimal-digits 3) (string-format "~D:~2,'0D.~3,'0D" minutes-out seconds-part frac-millis))
      ((= decimal-digits 2) (string-format "~D:~2,'0D.~2,'0D" minutes-out seconds-part frac-hundredths))
      ((= decimal-digits 1) (string-format "~D:~2,'0D.~1,'0D" minutes-out seconds-part frac-tenths))
      (else (string-format "~D:~2,'0D" minutes-out seconds-part)))))

(defun mod-collected-money-for-level ((lvl-idx int))
  (-> *game-info* money-per-level lvl-idx))

(defun mod-max-money-for-level ((lvl-idx int))
  (-> *game-counts* data lvl-idx money-count))

(defun mod-collected-buzzer-for-level ((lvl-idx int))
  (buzzer-count *game-info*
                (-> *level-task-data* lvl-idx task-info (-> *level-task-data* lvl-idx buzzer-task-index) task-id)))

(defun mod-collected-fuel-for-level ((lvl-idx int))
  (let ((completed-task-count 0))
    (dotimes (task-idx (-> *level-task-data* lvl-idx nb-of-tasks))
      (if (= (get-task-status (-> *level-task-data* lvl-idx task-info task-idx task-id)) (task-status invalid))
        (+! completed-task-count 1)))
    completed-task-count))

(defun mod-max-fuel-for-level ((lvl-idx int))
  (-> *level-task-data* lvl-idx nb-of-tasks))

(defmacro def-current-level-wrapper (name for-level-fn)
  `(defun ,name ()
    (if (and *target* (-> *target* current-level))
      (let ((lvl-idx (-> *level-task-data-remap* (+ (-> *target* current-level info index) -1)))) (,for-level-fn lvl-idx))
      0)))

(def-current-level-wrapper mod-collected-money-current-level mod-collected-money-for-level)

(def-current-level-wrapper mod-max-money-current-level mod-max-money-for-level)

(def-current-level-wrapper mod-collected-buzzer-current-level mod-collected-buzzer-for-level)

(def-current-level-wrapper mod-collected-fuel-current-level mod-collected-fuel-for-level)

(def-current-level-wrapper mod-max-fuel-current-level mod-max-fuel-for-level)

(defun mod-target-fishing? ()
  (if (not *target*) #f (let ((mode (send-event *target* 'query 'mode))) (= mode 'target-fishing))))

(defun mod-target-billy-game? ()
  (if (not *target*) #f (let ((mode (send-event *target* 'query 'mode))) (= mode 'target-billy-game))))
