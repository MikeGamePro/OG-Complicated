;;-*-Lisp-*-
(in-package goal)

;; Push a rolled id onto the 8-entry recent-roll history.
(defun mod-rule-record-roll! ((id symbol))
  (when id
    (let ((slot 7))
      (while (> slot 0)
        (set! (-> *mod-rule-recent-rolls* slot) (-> *mod-rule-recent-rolls* (- slot 1)))
        (+! slot -1))
      (set! (-> *mod-rule-recent-rolls* 0) id)))
  (none))

;; Remove an id from the history (used when a rule is discarded by a twist).
(defun mod-rule-forget-roll! ((id symbol))
  (when id
    (let ((slot 0)
          (found -1))
      (while (and (< slot 8) (< found 0))
        (when (= (-> *mod-rule-recent-rolls* slot) id)
          (set! found slot))
        (+! slot 1))
      (when (>= found 0)
        (let ((i found))
          (while (< i 7)
            (set! (-> *mod-rule-recent-rolls* i) (-> *mod-rule-recent-rolls* (+ i 1)))
            (+! i 1))
          (set! (-> *mod-rule-recent-rolls* 7) #f)))))
  (none))

;; Recency factor: position in the history. Multiplied into a roll weight so recent rolls are less likely.
(defun mod-rule-recent-roll-factor ((id symbol))
  (let ((idx (mod-symbol-index *mod-rule-recent-rolls* id))) (if (>= idx 0) idx 8)))

;; True in places where Jak is always on the zoomer.
(defun sole-zoomer-level? ((level symbol))
  (or (string= (current-checkpoint-name) "firecanyon-start")
      (eq? level 'rolling)
      (string= (current-checkpoint-name) "ogre-race")))

(defun sparse-lurker-level? ((level symbol))
  (case level
    (('training 'village1 'jungleb 'firecanyon 'village2 'rolling 'ogre 'village3 'lavatube 'citadel 'finalboss) #t)
    (else #f)))

(defun sparse-hitlist-level? ((level symbol))
  (or (sparse-lurker-level? level)
      (case level
        (('citadel 'finalboss 'sunkenb) #t)
        (else #f))))

(defun sparse-crate-level? ((level symbol))
  (case level
    (('village3 'jungleb 'darkcave 'lavatube 'citadel 'finalboss) #t)
    (else #f)))

(defun sparse-green-eco-level? ((level symbol))
  (or (case level
        (('village3 'village1 'jungleb 'lavatube 'ogre 'citadel 'finalboss 'sunkenb 'firecanyon) #t)
        (else #f))
      (string= (current-checkpoint-name) "ogre-start")))

(defun red-eco-level? ((level symbol))
  (or (case level
        (('misty 'snow) #t)
        (else #f))
      (string= (current-checkpoint-name) "citadel-generator-start")))

(defun yellow-eco-level? ((level symbol))
  (or (case level
        (('swamp 'snow 'citadel 'finalboss 'lavatube 'maincave 'robocave 'darkcave) #t)
        (else #f))
      (and (eq? level 'ogre) (task-closed? (game-task snow-eggtop) (task-status need-resolution)))))

(defun sparse-blue-eco-level? ((level symbol))
  (or (and (eq? level 'firecanyon) (not (task-closed? (game-task jungle-eggtop) (task-status need-resolution))))
      (string= (current-checkpoint-name) "citadel-generator-start")
      (string= (current-checkpoint-name) "misty-bike")
      (case level
        (('maincave 'snow 'darkcave 'finalboss 'village3 'rolling 'lavatube) #t)
        (else #f))))

(defun hang-time-level? ((level symbol))
  (or (case level
        (('village1 'beach 'jungle 'misty 'swamp 'sunkenb 'snow 'maincave 'robocave) #t)
        (else #f))
      (string= (current-checkpoint-name) "citadel-start")
      (string= (current-checkpoint-name) "citadel-launch-start")
      (string= (current-checkpoint-name) "citadel-launch-end")))

(defun mod-all-bone-bridges-down? ()
  (let ((misty-level (level-get *level* 'misty))
        (bridge-count 0)
        (fallen-count 0))
    (when (and misty-level (= (-> misty-level status) 'active))
      (let ((actors (-> misty-level bsp actors)))
        (when (nonzero? actors)
          (dotimes (idx (-> actors length))
            (let ((actor (-> actors data idx actor)))
              (when (and (type-type? (-> actor type) entity-actor) (= (-> (the-as entity-actor actor) etype) mis-bone-bridge))
                (+! bridge-count 1)
                (when (logtest? (-> (the-as entity-actor actor) extra perm status) (entity-perm-status complete))
                  (+! fallen-count 1))))))))
    (and (> bridge-count 0) (= bridge-count fallen-count))))

(defun mod-rule-uncharted-level-visited? ((level-index level-task-data-index))
  (and *game-info* (not (zero? (-> *game-info* enter-level-time level-index)))))

(defun mod-rule-uncharted-can-roll? ((village symbol))
  (cond
    ((eq? village 'village1)
     (or (not (mod-rule-uncharted-level-visited? (level-task-data-index beach)))
         (not (mod-rule-uncharted-level-visited? (level-task-data-index jungle)))
         (and (task-closed? (game-task jungle-fishgame) (task-status need-resolution))
              (not (mod-rule-uncharted-level-visited? (level-task-data-index misty))))
         (not (mod-rule-uncharted-level-visited? (level-task-data-index firecanyon)))))
    ((eq? village 'village2)
     (or (not (mod-rule-uncharted-level-visited? (level-task-data-index firecanyon)))
         (not (mod-rule-uncharted-level-visited? (level-task-data-index sunken)))
         (not (mod-rule-uncharted-level-visited? (level-task-data-index swamp)))
         (and (>= (-> *game-info* fuel) 45.0) (not (mod-rule-uncharted-level-visited? (level-task-data-index ogre))))
         (not (mod-rule-uncharted-level-visited? (level-task-data-index rolling)))))
    ((eq? village 'village3)
     (or (not (mod-rule-uncharted-level-visited? (level-task-data-index ogre)))
         (and (task-closed? (game-task village3-button) (task-status need-hint))
              (not (mod-rule-uncharted-level-visited? (level-task-data-index snow))))
         (not (mod-rule-uncharted-level-visited? (level-task-data-index cave)))
         (not (mod-rule-uncharted-level-visited? (level-task-data-index lavatube)))))
    (else #f)))

(defun launcher-level? ((level symbol))
  (or (and (eq? level 'beach) (task-closed? (game-task jungle-eggtop) (task-status need-resolution)))
      (case level
        (('jungle 'jungleb 'swamp) #t)
        (else #f))
      (string= (current-checkpoint-name) "citadel-start")
      (string= (current-checkpoint-name) "citadel-launch-start")
      (string= (current-checkpoint-name) "citadel-launch-end")))

(defun grass-level? ((level symbol))
  (case level
    (('beach 'village1 'jungle 'village2) #t)
    (else #f)))

(defun sand-level? ((level symbol))
  (case level
    (('training 'beach 'village1) #t)
    (else #f)))

(defun no-drought-level? ((level symbol))
  (or (case level
        (('swamp 'snow 'lavatube 'jungleb 'citadel 'finalboss) #t)
        (else #f))
      (string= (current-checkpoint-name) "ogre-race")
      (string= (current-checkpoint-name) "firecanyon-start")))

(defun water-level? ((level symbol))
  (case level
    (('beach 'village1 'training 'misty 'jungle 'village2 'swamp 'sunken 'sunkenb) #t)
    (else #f)))

(defun button-level? ((level symbol))
  (or (case level
        (('jungle 'citadel 'village2) #t)
        (else #f))
      (and (eq? level 'jungleb) (not (task-complete? *game-info* (game-task jungle-eggtop))))
      (and (eq? level 'snow)
           (or (not (task-complete? *game-info* (game-task jungle-eggtop)))
               (task-complete? *game-info* (game-task beach-flutflut))))
      (and (not (mod-target-on-flut?)) (or (eq? level 'sunken) (eq? level 'sunkenb)))))

;; True if all villager and oracle cells in the area are bought.
(defun mod-cells-purchased? ((level symbol))
  (and (mod-villagers-closed? level) (mod-oracles-closed? level)))

(defun mod-cell-purchase-level? ((level symbol))
  (case level
    (('village1 'village2 'village3 'rolling) #t)
    (else #f)))

(defun half-price-level? ((level symbol))
  (and (mod-cell-purchase-level? level) (not (mod-cells-purchased? level))))

(defun burn-level? ((level symbol))
  (or (case level
        (('firecanyon 'village1 'lavatube 'village3 'village2 'sunken 'sunkenb) #t)
        (else #f))
      (string= (current-checkpoint-name) "ogre-start")))

;; Pairs of conditions that must never be active together.
(define *mod-rule-conflict-pairs*
  (new 'static
       'boxed-array
       :type
       symbol
       'rule-sniper 'rule-flop-this
       'rule-lurker-pressure 'rule-no-harm
       'rule-lurker-pressure 'complication-soul-bond
       'rule-no-harm 'rule-sniper
       'complication-soul-bond 'rule-sniper
       'rule-hitlist 'rule-no-harm
       'rule-double-kill 'rule-no-harm
       'complication-soul-bond 'complication-disassociate
       'rule-hitlist 'complication-soul-bond
       'rule-double-kill 'complication-soul-bond
       'rule-buzzer-pressure 'rule-distancing
       'complication-fuel-shortage 'rule-loyal-customer
       'rule-grounded 'rule-hang-time
       'rule-grounded 'rule-qte
       'rule-die 'rule-survivor
       'rule-red-light 'rule-qte
       'rule-management 'rule-qte
       'rule-management 'complication-joyride
       'rule-keep-it-low 'complication-joyride
       'complication-sizeable 'complication-joyride
       'complication-butter-fingers 'complication-joyride
       'rule-keep-rolling 'complication-joyride
       'complication-get-a-grip 'complication-joyride
       'rule-math-quiz 'rule-trivia
       'rule-landlubber 'complication-drought
       'rule-buzzer-pressure 'complication-unbreakable
       'rule-fuel-pressure 'complication-fuel-shortage
       'complication-rotten-eggs 'rule-money-pressure
       'rule-green-pilled 'complication-eco-allergy
       'complication-get-a-grip 'complication-butter-fingers
       'rule-red-light 'complication-bus-driver
       'complication-fuel-shortage 'complication-wings-tied
       'rule-for-billy 'rule-express-delivery
       'rule-survivor 'complication-ohko
       'rule-survivor 'complication-vibe-check
       'complication-rotten-eggs 'rule-loyal-customer
       'rule-orb-hunt 'complication-hidden-treasure
       'complication-glare 'rule-lurker-pressure
       'rule-die 'rule-touch-grass
       'rule-hang-time 'rule-sniper
       'rule-money-pressure 'rule-buzzer-pressure
       'rule-for-billy 'rule-sniper
       'rule-for-billy 'rule-buzzer-pressure
       'rule-for-billy 'rule-fuel-pressure
       'rule-for-billy 'rule-money-pressure
       'rule-one-frame 'rule-hang-time
       'complication-rotten-eggs 'rule-orb-hunt
       'rule-no-ledge 'complication-get-a-grip
       'rule-no-ledge 'complication-butter-fingers
       'rule-grounded 'complication-get-a-grip))

;; True if the twist state forbids rolling this id (rules while a twist is pending/marked, twist while one is already in progress).
(defun mod-rule-twist-blocks? ((id symbol))
  (cond
    ((eq? (mod-rule-type id) 'rule)
     (or (>= (-> *MOD-rule-context-bank* twist-marked-slot) 0) (mod-rule-active? 'complication-twisted)))
    ((eq? id 'complication-twisted)
     (or (>= (-> *MOD-rule-context-bank* twist-pending-count) 0)
         (mod-any-rule-active?)
         (>= (-> *MOD-rule-context-bank* twist-marked-slot) 0)))
    (else #f)))

(defun mod-rule-conflicts-with-active? ((id symbol))
  (let ((i 0)
        (hit #f))
    (while (and (< i (-> *mod-rule-conflict-pairs* length)) (not hit))
      (let ((a (-> *mod-rule-conflict-pairs* i))
            (b (-> *mod-rule-conflict-pairs* (+ i 1))))
        (when (or (and (= id a) (mod-rule-active? b)) (and (= id b) (mod-rule-active? a)))
          (set! hit #t)))
      (+! i 2))
    hit))

;; Roll weight for a condition.
(defun mod-rule-roll-priority ((id symbol))
  (if (not (mod-condition-enabled? id))
    0
    (let* ((checkpoint-name (current-checkpoint-name))
           (level-name (the symbol (current-level-name)))
           (on-racer (mod-target-on-racer?))
           (on-flut (mod-target-on-flut?))
           (fuel-left (- (mod-max-fuel-current-level) (mod-collected-fuel-current-level)))
           (money-left (- (mod-max-money-current-level) (mod-collected-money-current-level)))
           (buzzer-left (- 7 (mod-collected-buzzer-current-level)))
           (is-minigame (or (mod-target-fishing?) (mod-target-billy-game?)))
           (is-klaww (and (not (task-closed? (game-task ogre-boss) (task-status need-resolution))) (string= checkpoint-name "ogre-start")))
           (deep-lavatube (or (string= checkpoint-name "lavatube-middle") (string= checkpoint-name "lavatube-after-ribbon")))
           (racer-lavatube (or (and on-racer (string= checkpoint-name "lavatube-start")) deep-lavatube)))
      (if (mod-rule-twist-blocks? id)
        0
        (cond
          ((mod-rule-conflicts-with-active? id) 0)
          ;; Resources
          ((eq? id 'rule-supercharged)
           (if (string= checkpoint-name "snow-fort")
             107
             (if (or is-minigame
                     (and (mod-rule-active? 'complication-rgyb) (not (yellow-eco-level? level-name)))
                     (sparse-blue-eco-level? level-name))
               0
               64)))
          ((eq? id 'complication-critical) (if (or is-minigame (< fuel-left 1) (eq? level-name 'finalboss)) 0 47))
          ((eq? id 'rule-buzzer-pressure)
           (if (or (< buzzer-left 3)
                   is-minigame
                   is-klaww
                   (eq? level-name 'jungleb)
                   (eq? level-name 'robocave)
                   (eq? level-name 'finalboss)
                   (eq? level-name 'sunkenb))
             0
             47))
          ((eq? id 'rule-fuel-pressure)
           (cond
             ((or (< fuel-left 1)
                  (and (eq? level-name 'rolling) (< fuel-left 3))
                  (and (eq? level-name 'swamp) (< fuel-left 3))
                  (and (eq? level-name 'village1) (< fuel-left 3))
                  (and (eq? level-name 'village2) (< fuel-left 3))
                  (and (eq? level-name 'village3) (< fuel-left 4))
                  (and (eq? level-name 'jungle) (< fuel-left 4))
                  is-minigame
                  (eq? level-name 'ogre)
                  (eq? level-name 'firecanyon)
                  (eq? level-name 'jungleb)
                  (string= checkpoint-name "lavatube-start")
                  racer-lavatube
                  (eq? level-name 'finalboss))
              0)
             (else 53)))
          ((eq? id 'rule-money-pressure)
           (if (or (<= money-left 50) is-minigame is-klaww (eq? level-name 'finalboss) (eq? level-name 'jungleb) deep-lavatube) 0 45))
          ((eq? id 'complication-hidden-treasure)
           (if (or is-klaww (eq? level-name 'finalboss) (string= checkpoint-name "firecanyon-start") deep-lavatube) 0 50))
          ((eq? id 'rule-loyal-customer)
           (if (and (mod-cell-purchase-level? level-name)
                    (not (mod-oracles-closed? level-name))
                    (>= (+ (current-orb-count) money-left) (mod-cell-price-oracle))
                    (<= (- (mod-cell-price-oracle) (current-orb-count)) 20))
             119
             0))
          ;; Enemies
          ((or (eq? id 'complication-glare) (eq? id 'rule-lurker-pressure))
           (cond
             ((sparse-lurker-level? level-name) 0)
             ((eq? id 'complication-glare) 72)
             (is-minigame 0)
             (else 69)))
          ((eq? id 'rule-hitlist) (if (or (sparse-hitlist-level? level-name) is-minigame) 0 94))
          ((eq? id 'rule-double-kill)
           (if (or (sparse-lurker-level? level-name) is-minigame is-klaww (eq? level-name 'finalboss) (eq? level-name 'sunkenb)) 0 72))
          ((eq? id 'rule-no-harm) ;; disabled
           (if (or (sparse-lurker-level? level-name) is-minigame is-klaww (eq? level-name 'jungleb)) 0 74))
          ((eq? id 'complication-soul-bond)
           (if (or (sparse-lurker-level? level-name)
                   is-minigame
                   is-klaww
                   (eq? level-name 'jungleb)
                   (string= checkpoint-name "sunkenb-helix"))
             0
             60))
          ((eq? id 'rule-sniper)
           (if (or (case level-name
                     (('swamp 'beach 'snow 'robocave 'darkcave) #t)
                     (else #f))
                   (and (eq? level-name 'maincave) (not (task-closed? (game-task cave-gnawers) (task-status need-resolution)))))
             100
             0))
          ((eq? id 'rule-flop-this)
           (if (or (case level-name
                     (('training 'lavatube 'village3 'village2 'village1 'rolling 'ogre 'finalboss) #t)
                     (else #f))
                   (mod-target-billy-game?))
             0
             80))
          ((eq? id 'rule-uncharted) (if (mod-rule-uncharted-can-roll? level-name) 250 0))
          ((eq? id 'rule-vendetta)
           (if (or (sparse-lurker-level? level-name) (not (red-eco-level? level-name)) on-racer is-minigame) 0 190))
          ((eq? id 'rule-bonecracker) (if (and (eq? level-name 'misty) (not (mod-all-bone-bridges-down?))) 422 0))
          ((eq? id 'rule-orb-hunt) (if (or is-minigame (<= (mod-orb-hunt-spot-count level-name) 0)) 0 35))
          ((eq? id 'complication-eco-reserve)
           (cond
             ((or (eq? level-name 'finalboss) is-klaww) 104)
             ((yellow-eco-level? level-name) 43)
             (else 0)))
          ((eq? id 'complication-red-stop) ;; disabled
           (if (red-eco-level? level-name) 180 0))
          ((eq? id 'complication-ohko) (if (mod-timed-punishment-active? 'punishment-ohko) 0 36)) ;; disabled
          ((eq? id 'complication-invisible-man) (if on-racer 0 50))
          ((eq? id 'complication-double-aphids) ;; disabled
           (if (and (not (task-closed? (game-task jungle-plant) (task-status need-resolution))) (eq? level-name 'jungleb)) 307 0))
          ;; Crates
          ((eq? id 'rule-crate-break)
           (if (or (eq? level-name 'ogre) is-minigame (string= checkpoint-name "sunkenb-helix") (sparse-crate-level? level-name)) 0 65))
          ((eq? id 'rule-hands-on)
           (case level-name
             (('darkcave 'jungleb 'firecanyon 'finalboss 'village3 'ogre 'rolling 'lavatube) 0)
             (else 61)))
          ((or (eq? id 'complication-unbreakable) (eq? id 'rule-distancing))
           (if (or (< buzzer-left 1) is-klaww (eq? level-name 'training) (eq? level-name 'jungleb) (eq? level-name 'finalboss)) 0 42))
          ;; Movement
          ((eq? id 'complication-no-double-jump) (if on-racer 0 (if on-flut 105 52)))
          ((eq? id 'complication-jak-rabbit) (if on-racer 0 48))
          ((eq? id 'complication-jak-be-nimble) (if (or on-racer on-flut) 0 46))
          ((eq? id 'rule-keep-rolling)
           (if (or is-minigame is-klaww racer-lavatube (sole-zoomer-level? level-name) on-racer on-flut) 0 68))
          ((eq? id 'complication-quicksand) (if (sand-level? level-name) 146 0))
          ((eq? id 'complication-invert) 36)
          ((eq? id 'complication-cumbersome) (if (or is-minigame on-racer on-flut (< (current-orb-count) 20)) 0 64))
          ((eq? id 'complication-shifty) (if (or is-klaww is-minigame) 0 40))
          ((or (eq? id 'rule-grounded) (eq? id 'rule-die))
           (cond
             ((or (eq? level-name 'training) (string= checkpoint-name "finalboss-fight")) 0)
             (is-minigame 0)
             ((and (eq? id 'rule-grounded) is-klaww) 15)
             ((eq? id 'rule-grounded) 37)
             ((or (eq? level-name 'beach) (eq? level-name 'rolling)) (if (eq? id 'rule-die) 15 16))
             (is-klaww (if (eq? id 'rule-die) 11 12))
             (else 27)))
          ((eq? id 'rule-red-light)
           (cond
             (is-minigame 0)
             ((or (string= checkpoint-name "finalboss-fight") is-klaww) 8)
             (else 24)))
          ((eq? id 'complication-butter-fingers) ;; disabled
           (cond
             ((or (sole-zoomer-level? level-name) on-racer on-flut racer-lavatube) 0)
             ((eq? level-name 'training) 27)
             (else 52)))
          ((or (eq? id 'rule-keep-it-low) (eq? id 'complication-sizeable))
           (if (or racer-lavatube on-racer on-flut (sole-zoomer-level? level-name))
             0
             (if (eq? id 'rule-keep-it-low) (if (mod-timed-punishment-active? 'punishment-kick) 0 55) 60)))
          ((eq? id 'rule-management) (if (or racer-lavatube on-racer on-flut (sole-zoomer-level? level-name)) 0 55))
          ((eq? id 'complication-bad-ping) (if (mod-timed-punishment-active? 'punishment-delay) 0 36))
          ((eq? id 'complication-loose-pockets)
           (if (or (< (current-orb-count) 20) (eq? level-name 'finalboss) (eq? level-name 'citadel) (eq? level-name 'lavatube)) 0 52))
          ((eq? id 'rule-no-ledge)
           (if (or on-racer
                   on-flut
                   (eq? level-name 'finalboss)
                   (sole-zoomer-level? level-name)
                   (mod-timed-punishment-active? 'punishment-edge))
             0
             50))
          ;; Water
          ((eq? id 'complication-drought)
           (cond
             ((no-drought-level? level-name) 0)
             ((or (eq? level-name 'rolling) (eq? level-name 'training)) 41)
             (else 87)))
          ((eq? id 'rule-landlubber)
           (if (and *target* (logtest? (-> *target* control status) (cshape-moving-flags on-water)))
             0
             (cond
               ((water-level? level-name) 95)
               ((or (eq? level-name 'misty)
                    (and (not (task-closed? (game-task cave-dark-crystals) (task-status need-resolution))) (eq? level-name 'darkcave)))
                86)
               (else 0))))
          ;; Special
          ((eq? id 'rule-hang-time) (if (or is-minigame (not (hang-time-level? level-name))) 0 71))
          ((eq? id 'complication-vibe-check)
           (cond
             ((or is-minigame (string= checkpoint-name "finalboss-fight")) 0)
             ((eq? level-name 'citadel) 10)
             ((and *target* (< (-> (the-as fact-info-target (-> *target* fact)) health) 2.0)) 55)
             (else 24)))
          ((eq? id 'rule-express-delivery)
           (cond
             ((task-closed? (game-task misty-muse) (task-status need-resolution)) 0)
             ((eq? level-name 'misty) 135)
             ((task-closed? (game-task misty-muse) (task-status need-introduction)) 200)
             (else 0)))
          ((eq? id 'rule-side-to-side) (if is-klaww 640 0))
          ((eq? id 'complication-mirror) (if is-klaww 0 37))
          ((eq? id 'complication-income-tax) (if (eq? level-name 'finalboss) 0 29))
          ((eq? id 'complication-half-price) (if (half-price-level? level-name) 40 0))
          ((eq? id 'rule-button-pusher)
           (if (or (not (button-level? level-name)) is-minigame) 0 (if (or (eq? level-name 'jungle) (eq? level-name 'village2)) 49 181)))
          ((eq? id 'rule-cooked)
           (if (or on-racer racer-lavatube (not (burn-level? level-name))) 0 (if (eq? level-name 'village1) 81 182)))
          ((eq? id 'complication-get-a-grip)
           (if (or (sole-zoomer-level? level-name)
                   (string= checkpoint-name "swamp-cave1")
                   (string= checkpoint-name "citadel-elevator")
                   is-minigame
                   (eq? level-name 'ogre)
                   (eq? level-name 'finalboss)
                   (eq? level-name 'lavatube)
                   (mod-timed-punishment-active? 'punishment-edge)
                   on-racer
                   on-flut)
             0
             32))
          ((eq? id 'rule-green-pilled) (if (or (sparse-green-eco-level? level-name) is-minigame) 0 65))
          ((eq? id 'complication-joyride)
           (if (or on-racer
                   on-flut
                   is-minigame
                   (eq? level-name 'finalboss)
                   (and (mod-rule-active? 'rule-button-pusher) (or (eq? level-name 'sunken) (eq? level-name 'sunkenb)))
                   (string= checkpoint-name "firecanyon-start")
                   (eq? level-name 'lavatube))
