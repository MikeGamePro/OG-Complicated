           (if (and (mod-target-fishing?) (< (-> *MOD-rule-context-bank* fisher-missed) 15)) 1290 0))
          ((eq? id 'rule-sagging-sails)
           (if (and (mod-target-fishing?)
                    (< (-> *MOD-rule-context-bank* fisher-missed) 5)
