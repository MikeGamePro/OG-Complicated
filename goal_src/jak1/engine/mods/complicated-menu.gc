(defun float-floor ((value float))
  (let ((truncated (the float (the int value))))
    (if (and (< value 0.0) (!= truncated value)) (- truncated 1.0) truncated)))

(defun snap-to-step ((value float) (step float))
  (* (float-floor (+ (/ value step) 0.0001)) step))

(defmethod load-from-file ((obj complicated-settings))
  (format (clear *pc-temp-string-1*) "~S/complicated-settings.gc" *pc-settings-folder*)
  (cond
    ((pc-filepath-exists? *pc-temp-string-1*) (unless (read-from-file obj *pc-temp-string-1*) (reset obj)))
    (else (reset obj) (commit-to-file obj)))
  (none))

(defmethod write-to-file ((obj complicated-settings) (filename string))
  (if (not filename) (return #f))
  (let ((file (new 'stack 'file-stream filename 'write)))
    (if (not (file-stream-valid? file)) (return #f))
    (format file "(complicated-settings~%")
    ;; add new options here
    (format file "  (show-countup-timer? ~A)~%" (-> obj show-countup-timer?))
    (format file "  (punishment-toggle-fall-damage? ~A)~%" (-> obj punishment-toggle-fall-damage?))
    (format file "  (punishment-toggle-trip? ~A)~%" (-> obj punishment-toggle-trip?))
    (format file "  (punishment-toggle-edge? ~A)~%" (-> obj punishment-toggle-edge?))
    (format file "  (punishment-toggle-money? ~A)~%" (-> obj punishment-toggle-money?))
    (format file "  (punishment-toggle-warp? ~A)~%" (-> obj punishment-toggle-warp?))
    (format file "  (punishment-toggle-revert-cell? ~A)~%" (-> obj punishment-toggle-revert-cell?))
    (format file "  (punishment-toggle-extra-rule? ~A)~%" (-> obj punishment-toggle-extra-rule?))
    (format file "  (punishment-toggle-crash? ~A)~%" (-> obj punishment-toggle-crash?))
    (format file "  (punishment-toggle-delay? ~A)~%" (-> obj punishment-toggle-delay?))
    (format file "  (punishment-toggle-blind? ~A)~%" (-> obj punishment-toggle-blind?))
    (format file "  (punishment-toggle-iframes? ~A)~%" (-> obj punishment-toggle-iframes?))
    (format file "  (punishment-toggle-camera? ~A)~%" (-> obj punishment-toggle-camera?))
    (format file "  (punishment-toggle-ohko? ~A)~%" (-> obj punishment-toggle-ohko?))
    (format file "  (punishment-toggle-reset? ~A)~%" (-> obj punishment-toggle-reset?))
    (format file "  (punishment-toggle-countdown? ~A)~%" (-> obj punishment-toggle-countdown?))
    (format file "  (klaww-assist? ~A)~%" (-> obj klaww-assist?))
    (format file "  (fish-assist? ~A)~%" (-> obj fish-assist?))
    (format file "  (rule-grounded? ~A)~%" (-> obj rule-grounded?))
    (format file "  (rule-die? ~A)~%" (-> obj rule-die?))
    (format file "  (rule-lurker-pressure? ~A)~%" (-> obj rule-lurker-pressure?))
    (format file "  (rule-hitlist? ~A)~%" (-> obj rule-hitlist?))
    (format file "  (rule-crate-break? ~A)~%" (-> obj rule-crate-break?))
    (format file "  (complication-brittle-bones? ~A)~%" (-> obj complication-brittle-bones?))
    (format file "  (complication-rotten-eggs? ~A)~%" (-> obj complication-rotten-eggs?))
    (format file "  (rule-keep-it-low? ~A)~%" (-> obj rule-keep-it-low?))
