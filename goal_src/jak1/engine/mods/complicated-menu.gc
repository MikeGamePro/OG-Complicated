    (format file "  (rule-hang-time? ~A)~%" (-> obj rule-hang-time?))
    (format file "  (complication-unbreakable? ~A)~%" (-> obj complication-unbreakable?))
    (format file "  (complication-get-a-grip? ~A)~%" (-> obj complication-get-a-grip?))
    (format file "  (complication-torrent? ~A)~%" (-> obj complication-torrent?))
    (format file "  (complication-palate-change? ~A)~%" (-> obj complication-palate-change?))
    (format file "  (complication-jak-be-nimble? ~A)~%" (-> obj complication-jak-be-nimble?))
    (format file "  (countdown-start-seconds ~f)~%" (the float (the int (-> obj countdown-start-seconds))))
    (format file "  (cell-increment ~f)~%" (the float (the int (-> obj cell-increment))))
    (format file "  (orb-increment ~f)~%" (snap-to-step (-> obj orb-increment) 0.1))
    (format file "  (fly-increment ~f)~%" (the float (the int (-> obj fly-increment))))
    (format file "  (time-limit-multiplier ~f)~%" (snap-to-step (-> obj time-limit-multiplier) 0.1))
    (format file "  )~%")
    (file-stream-close file))
  #t)

(defmethod commit-to-file ((obj complicated-settings))
  (format (clear *pc-temp-string-1*) "~S/complicated-settings.gc" *pc-settings-folder*)
  (write-to-file obj *pc-temp-string-1*)
  (none))

(defmethod new complicated-settings ((allocation symbol) (type-to-make type))
  (let ((obj (object-new allocation type-to-make (the-as int (-> type-to-make size))))) (load-from-file obj) obj))

(define *complicated-settings* (the complicated-settings #f))

(define-once *complicated-settings* (new 'global 'complicated-settings))

;; add new options here (handler) - ONLY memory updates here
(defun countup-timer-setting-changed! ((new-val symbol))
  (set! (-> *complicated-settings* show-countup-timer?) new-val)
  (none))

(defun time-limit-multiplier-changed! ((new-val float))
  (set! (-> *complicated-settings* time-limit-multiplier) (+ (snap-to-step new-val 0.05) 0.001))
  (none))

(defun apply-easy-preset! ()
  (when *complicated-settings*
    (set! (-> *complicated-settings* cell-increment) 40.0)
    (set! (-> *complicated-settings* orb-increment) 2.0)
    (set! (-> *complicated-settings* fly-increment) 15.0)
    (set! (-> *complicated-settings* countdown-start-seconds) 30.0)
    (set! (-> *complicated-settings* time-limit-multiplier) 1.5)
    (set! (-> *complicated-settings* rule-one-frame?) #f)
    (set! (-> *complicated-settings* complication-rotten-eggs?) #f)
    (set! (-> *complicated-settings* complication-heating-balloons?) #f)
    (set! (-> *complicated-settings* rule-hang-time?) #f)
    (set! (-> *complicated-settings* rule-qte?) #f)
    (set! (-> *complicated-settings* complication-get-a-grip?) #f)
    (set! (-> *complicated-settings* complication-torrent?) #f)
    (commit-to-file *complicated-settings*))
  (none))

(defun apply-medium-preset! ()
  (when *complicated-settings*
    (set! (-> *complicated-settings* cell-increment) 30.0)
    (set! (-> *complicated-settings* orb-increment) 1.0)
    (set! (-> *complicated-settings* fly-increment) 10.0)
    (set! (-> *complicated-settings* countdown-start-seconds) 30.0)
    (set! (-> *complicated-settings* time-limit-multiplier) 1.2)
    (set! (-> *complicated-settings* rule-one-frame?) #f)
    (set! (-> *complicated-settings* complication-rotten-eggs?) #t)
    (set! (-> *complicated-settings* complication-heating-balloons?) #t)
    (set! (-> *complicated-settings* rule-hang-time?) #f)
    (set! (-> *complicated-settings* rule-qte?) #t)
    (set! (-> *complicated-settings* complication-get-a-grip?) #t)
    (set! (-> *complicated-settings* complication-torrent?) #t)
    (commit-to-file *complicated-settings*))
  (none))

