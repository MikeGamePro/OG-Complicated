;; ---- Main Complicated Options Submenu --------------------------------------
(define *complicated-options*
  (new 'static
       'boxed-array
       :type
       game-option
       ;; [0] INCREMENT OPTIONS SUBMENU
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id complicated-opts-increment-title)
            :scale #t
            :param3 (game-option-menu comp-timer-options))
       ;; [1] CONDITION TOGGLE SUBMENU
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id complicated-opts-cond-toggles-title)
            :scale #t
            :param3 (game-option-menu condition-toggle-options))
       ;; [2] PUNISHMENT TOGGLES SUBMENU
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id complicated-opts-punishment-toggles-title)
            :scale #t
            :param3 (game-option-menu punishment-toggle-options))
       ;; [3] DIFFICULTY PRESETS SUBMENU
       (new 'static
            'game-option
            :option-type (game-option-type menu)
            :name (text-id complicated-opts-difficulty-presets-title)
            :scale #t
            :param3 (game-option-menu difficulty-preset-options))
       ;; [4] SPEEDRUN TIMER toggle
       (new 'static
            'game-option
            :option-type (game-option-type on-off)
            :name (text-id complicated-opts-show-timer)
            :scale #t
            :on-change
            (lambda ((val object))
              (countup-timer-setting-changed! (the-as symbol val))
              (none))
            :on-confirm
            (lambda ()
              (commit-to-file *complicated-settings*)
              (none)))
       ;; [5] KLAWW ASSIST
       (new 'static
            'game-option
            :option-type (game-option-type on-off)
            :name (text-id complicated-opts-klaww-assist)
            :scale #t
            :on-change
            (lambda ((val object))
              (klaww-assist-changed! (the-as symbol val))
              (none))
            :on-confirm
            (lambda ()
              (commit-to-file *complicated-settings*)
              (none)))
       ;; [6] FISH ASSIST
       (new 'static
            'game-option
            :option-type (game-option-type on-off)
            :name (text-id complicated-opts-fish-assist)
            :scale #t
            :on-change
            (lambda ((val object))
              (fish-assist-changed! (the-as symbol val))
              (none))
            :on-confirm
            (lambda ()
              (commit-to-file *complicated-settings*)
              (none)))
       ;; [7] BACK
       (new 'static
            'game-option
            :option-type (game-option-type button)
            :name (text-id back)
            :scale #t
            :on-confirm
            (lambda ()
              (commit-to-file *complicated-settings*)
              (none)))))

