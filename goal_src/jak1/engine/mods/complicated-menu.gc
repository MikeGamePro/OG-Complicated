(defmethod read-from-file ((obj complicated-settings) (filename string))
  (if (not filename) (return #f))
  (reset obj)
  (let ((file (new 'stack 'file-stream filename 'read)))
    (when (not (file-stream-valid? file))
      (return #f))
    (with-settings-scope (file)
                         (case-str (file-stream-read-word file)
                           (("complicated-settings")
                            (dosettings (file)
                                        (case-str *pc-temp-string*
                                          ;; add new options here
                                          (("show-countup-timer?") (set! (-> obj show-countup-timer?) (file-stream-read-symbol file)))
                                          ;; retired condition-menu toggles; do not restore these as real fields.
                                          (("one-frame-toggle?" "invert-controls-toggle?" "math-quiz-toggle?" "trivia-toggle?") (file-stream-read-symbol file))
                                          (("crash-toggle?") (set! (-> obj punishment-toggle-crash?) (file-stream-read-symbol file)))
                                          (("punishment-toggle-fall-damage?") (set! (-> obj punishment-toggle-fall-damage?) (file-stream-read-symbol file)))
                                          (("punishment-toggle-trip?") (set! (-> obj punishment-toggle-trip?) (file-stream-read-symbol file)))
                                          (("punishment-toggle-edge?") (set! (-> obj punishment-toggle-edge?) (file-stream-read-symbol file)))
                                          (("punishment-toggle-money?") (set! (-> obj punishment-toggle-money?) (file-stream-read-symbol file)))
                                          (("punishment-toggle-warp?") (set! (-> obj punishment-toggle-warp?) (file-stream-read-symbol file)))
                                          (("punishment-toggle-revert-cell?") (set! (-> obj punishment-toggle-revert-cell?) (file-stream-read-symbol file)))
                                          (("punishment-toggle-extra-rule?") (set! (-> obj punishment-toggle-extra-rule?) (file-stream-read-symbol file)))
