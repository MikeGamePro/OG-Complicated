;; add new options here (getter)
(defun show-countup-timer-enabled? ()
  (the symbol (and *complicated-settings* (-> *complicated-settings* show-countup-timer?))))

(defun time-limit-multiplier ()
  (if *complicated-settings* (snap-to-step (-> *complicated-settings* time-limit-multiplier) 0.1) 1.2))

(defun punishment-toggle-enabled? ((punishment symbol))
  (the symbol
       (cond
         ((not *complicated-settings*) #t)
         ((eq? punishment 'punishment-fall-damage) (-> *complicated-settings* punishment-toggle-fall-damage?))
         ((eq? punishment 'punishment-trip) (-> *complicated-settings* punishment-toggle-trip?))
         ((eq? punishment 'punishment-edge) (-> *complicated-settings* punishment-toggle-edge?))
         ((eq? punishment 'punishment-money) (-> *complicated-settings* punishment-toggle-money?))
         ((eq? punishment 'punishment-warp) (-> *complicated-settings* punishment-toggle-warp?))
         ((eq? punishment 'punishment-revert-cell) (-> *complicated-settings* punishment-toggle-revert-cell?))
         ((eq? punishment 'punishment-extra-rule) (-> *complicated-settings* punishment-toggle-extra-rule?))
         ((eq? punishment 'punishment-crash) (-> *complicated-settings* punishment-toggle-crash?))
         ((eq? punishment 'punishment-delay) (-> *complicated-settings* punishment-toggle-delay?))
         ((eq? punishment 'punishment-blind) (-> *complicated-settings* punishment-toggle-blind?))
         ((eq? punishment 'punishment-iframes) (-> *complicated-settings* punishment-toggle-iframes?))
         ((eq? punishment 'punishment-camera) (-> *complicated-settings* punishment-toggle-camera?))
         ((eq? punishment 'punishment-ohko) (-> *complicated-settings* punishment-toggle-ohko?))
         ((eq? punishment 'punishment-reset) (-> *complicated-settings* punishment-toggle-reset?))
         ((eq? punishment 'punishment-countdown) (-> *complicated-settings* punishment-toggle-countdown?))
         (else #t))))

(defun klaww-assist-enabled? ()
  (the symbol (and *complicated-settings* (-> *complicated-settings* klaww-assist?))))

(defun fish-assist-enabled? ()
  (the symbol (and *complicated-settings* (-> *complicated-settings* fish-assist?))))

(defun orb-increment-value ()
  (if *complicated-settings* (snap-to-step (-> *complicated-settings* orb-increment) 0.1) 1.0))

(defun cell-increment-value ()
  (if *complicated-settings* (the float (the int (-> *complicated-settings* cell-increment))) 30.0))

(defun fly-increment-value ()
  (if *complicated-settings* (the float (the int (-> *complicated-settings* fly-increment))) 10.0))

(defun countdown-start-seconds-value ()
  (if *complicated-settings* (the float (the int (-> *complicated-settings* countdown-start-seconds))) 30.0))

(defun mod-rule-condition-enabled? ((id symbol))
  (the symbol
       (cond
         ((eq? id 'rule-grounded) (-> *complicated-settings* rule-grounded?))
         ((eq? id 'rule-die) (-> *complicated-settings* rule-die?))
         ((eq? id 'rule-lurker-pressure) (-> *complicated-settings* rule-lurker-pressure?))
