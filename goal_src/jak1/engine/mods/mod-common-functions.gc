(defun mod-symbol-at ((ids (array symbol)) (idx int))
  (if (and (>= idx 0) (< idx (-> ids length))) (-> ids idx) #f))

(defun mod-symbol-index ((ids (array symbol)) (id symbol))
  (let ((i 0)) (while (< i (-> ids length)) (when (= (-> ids i) id) (return i)) (+! i 1)) -1))

;; Pack one byte per entry (index into ids, #xff = empty) into a uint. Save format: do not change.
(defun mod-pack-symbols ((arr (array symbol)) (ids (array symbol)) (n int))
  (let ((result (the uint 0))
        (i 0))
    (while (< i n)
      (let* ((sym (-> arr i))
             (idx (if sym (mod-symbol-index ids sym) -1))
             (byte-val (if (>= idx 0) (the uint idx) (the uint #xff))))
        (set! result (logior result (shl byte-val (* i 8)))))
      (+! i 1))
    (the int result)))

(defun mod-unpack-symbol ((bits uint) (slot int) (ids (array symbol)))
  (mod-symbol-at ids (the int (logand (shr bits (* slot 8)) (the uint #xff)))))

(defun mod-seconds->ms ((secs float))
  (the int (+ 0.5 (* secs 1000.0))))

(defun mod-rule-id-from-index ((idx int))
  (mod-symbol-at *mod-rule-ids* idx))

(defun mod-punishment-id-from-index ((idx int))
  (mod-symbol-at *mod-punishment-ids* idx))

(defun mod-enabled-condition-count ()
  (let ((count 0))
    (dotimes (i *mod-rule-id-count*)
      (when (mod-condition-enabled? (mod-rule-id-from-index i))
        (+! count 1)))
    count))

(defun mod-enabled-condition-fraction ()
  (/ (the float (mod-enabled-condition-count)) (the float *mod-rule-id-count*)))

(defun mod-punishment-toggle-enabled-count ()
  (let ((count 0))
    (dotimes (i *mod-punishment-id-count*)
      (let ((id (mod-punishment-id-from-index i))) (when (punishment-toggle-enabled? id) (+! count 1))))
    count))

(defun mod-punishment-toggle-enabled-fraction ()
  (/ (the float (mod-punishment-toggle-enabled-count)) (the float *mod-punishment-id-count*)))

(define *mod-score-max-inc* 35780.0)

(define *mod-score-time-scale* 5400.0)

(define *mod-rule-follow-estimate* 40.0)

(defun mod-collectable-inc-total ()
  (+ (* 101.0 (cell-increment-value)) (* 2000.0 (orb-increment-value)) (* 112.0 (fly-increment-value))))

(defun mod-inc-total ()
  (+ (mod-collectable-inc-total)
     (countdown-start-seconds-value)
     (* *mod-rule-follow-estimate* (compliance-increment-value))))

(defun mod-calc-run-score ()
  (let* ((inc-total (mod-inc-total))
         (inc-norm (/ inc-total *mod-score-max-inc*))
         (final-time-seconds (/ (the float (-> *MOD-stats-bank* final-time)) (the float TICKS_PER_SECOND)))
         (time-factor (/ *mod-score-time-scale* (+ *mod-score-time-scale* final-time-seconds)))
         (raw-mult (fmax 0.01 (time-limit-multiplier)))
         (max-score 100000.0)
         (mult-weight 0.0175)
         (time-weight 0.2)
         (score-weight 0.8)
         (conditions-weight 0.055)
         (punishments-weight 0.012)
         (effective-mult (+ 1.0 (* (- raw-mult 1.0) mult-weight)))
         (effective-conditions-mult (+ 1.0 (* (- 1.0 (mod-enabled-condition-fraction)) conditions-weight)))
         (effective-punishments-mult (+ 1.0 (* (- 1.0 (mod-punishment-toggle-enabled-fraction)) punishments-weight)))
         (score 0.0))
    (set! inc-norm (fmax 0.0 (fmin 1.0 inc-norm)))
    (let ((base-score (* max-score (+ (* time-weight time-factor) (* score-weight (- 1.0 inc-norm))))))
      (set! score (/ (/ (/ base-score effective-mult) effective-conditions-mult) effective-punishments-mult)))
    (format #t
            "mod-score: inc-total ~f inc-norm ~f final-time-s ~f time-factor ~f "
            inc-total
            inc-norm
            final-time-seconds
            time-factor)
    (format #t
            "eff-mult ~f eff-cond-mult ~f eff-punish-mult ~f score ~f~%"
            effective-mult
            effective-conditions-mult
            effective-punishments-mult
            score)
    score))

(defun mod-game-beaten-resume-from-save ((value int))
  (set! (-> *MOD-rule-context-bank* game-beaten?) (not (= value 0)))
  (none))

(defun mod-game-beaten-save-value ()
  (if (-> *MOD-rule-context-bank* game-beaten?) 1 0))

;; mod: setter used by other files (e.g. robotboss.gc, game-save.gc)
(defun mod-game-beaten-set! ((val symbol))
  (set! (-> *MOD-rule-context-bank* game-beaten?) val)
  (none))

;; mod: called by robotboss.gc when the final light eco is picked up
(defun mod-finalize-run-stats! ()
  (set! (-> *MOD-stats-bank* final-remaining-time) (-> *MOD-countdown-bank* remaining-time))
  (set! (-> *MOD-stats-bank* final-time) (-> *MOD-countdown-bank* countup-timer))
  (set! (-> *MOD-stats-bank* final-score) (the int (mod-calc-run-score)))
  (none))

(defun mod-difficulty-display-name ()
  (case *complicated-difficulty-preset*
    (('easy) "Simple")
    (('medium) "Complicated")
    (('esoteric) "Esoteric")
    (('unfathomable) "Unfathomable")
    (else "Custom")))

;; mod: called by pckernel.gc's update-discord-rpc
(defun mod-discord-info-fill! ((info discord-info))
  (set! (-> info difficulty) (mod-difficulty-display-name))
  (set! (-> info countdown-active?) (-> *MOD-countdown-bank* active?))
  (set! (-> info countdown-lost?) (-> *MOD-countdown-bank* lost?))
  (set! (-> info game-beaten?) (-> *MOD-rule-context-bank* game-beaten?))
  (set! (-> info time-remaining)
        (if (-> *MOD-rule-context-bank* game-beaten?)
          (-> *MOD-stats-bank* final-remaining-time)
          (-> *MOD-countdown-bank* remaining-time)))
  (set! (-> info completion) (calculate-completion (the-as progress #f)))
  (set! (-> info rules-followed) (-> *MOD-stats-bank* rules-followed))
  (set! (-> info rules-broken) (-> *MOD-stats-bank* rules-broken))
  (none))

(defun mod-final-time-save-value ()
  (-> *MOD-stats-bank* final-time))

(defun mod-final-time-resume-from-save ((value int))
  (set! (-> *MOD-stats-bank* final-time) value)
  (none))

(defun mod-final-remaining-time-save-value ()
  (-> *MOD-stats-bank* final-remaining-time))

(defun mod-final-remaining-time-resume-from-save ((value int))
