(defun mod-trivia-used-word-save-value ((word int))
  (let ((result (the uint 0))
        (start (* word 64))
        (end (min (length *trivia-questions-used*) (+ (* word 64) 64)))
        (i 0))
    (set! i start)
    (while (< i end)
      (when (-> *trivia-questions-used* i)
        (set! result (logior result (shl (the uint 1) (- i start)))))
      (+! i 1))
    (the int result)))

(defun mod-trivia-used-word-resume-from-save ((word int) (val int))
  (let ((bits (the uint val))
        (start (* word 64))
        (end (min (length *trivia-questions-used*) (+ (* word 64) 64)))
        (i 0))
    (set! i start)
    (while (< i end)
      (set! (-> *trivia-questions-used* i) (= (logand (shr bits (- i start)) (the uint 1)) (the uint 1)))
      (+! i 1)))
  (none))

(def-save-index-pair mod-trivia-used-word0-save-value
                     mod-trivia-used-word0-resume-from-save
