(defun mod-rule-goal-kind ((id symbol))
  (cond
    ((eq? id 'rule-lurker-pressure) 'counter)
    ((eq? id 'rule-hitlist) 'counter)
    ((eq? id 'rule-double-kill) 'event-once)
    ((eq? id 'rule-crate-break) 'counter)
    ((eq? id 'rule-money-pressure) 'counter)
    ((eq? id 'rule-fuel-pressure) 'event-once)
    ((eq? id 'rule-sniper) 'event-once)
    ((eq? id 'rule-buzzer-pressure) 'counter)
    ((eq? id 'rule-die) 'event-once)
    ((eq? id 'rule-one-frame) 'event-once)
    ((eq? id 'rule-vendetta) 'event-once)
    ((eq? id 'rule-for-billy) 'event-once)
    ((eq? id 'rule-speed) 'event-once)
    ((eq? id 'rule-green-pilled) 'counter)
    ((eq? id 'rule-button-pusher) 'event-once)
    ((eq? id 'rule-loyal-customer) 'event-once)
    ((eq? id 'rule-cooked) 'event-once)
    ((eq? id 'rule-sagging-sails) 'counter)
    ((eq? id 'rule-express-delivery) 'event-once)
    ((eq? id 'rule-qte) 'event-once)
    ((eq? id 'rule-touch-grass) 'event-once)
    ((eq? id 'rule-hang-time) 'counter)
    (else 'none)))

(defun mod-rule-counter-goal ((id symbol))
  (cond
    ((eq? (mod-rule-goal-kind id) 'event-once) 1)
    ((eq? id 'rule-lurker-pressure) 6)
    ((eq? id 'rule-hitlist) 3)
    ((eq? id 'rule-crate-break) 5)
    ((eq? id 'rule-money-pressure) 20)
    ((eq? id 'rule-buzzer-pressure) 2)
    ((eq? id 'rule-green-pilled) 50)
    ((eq? id 'rule-sagging-sails) 3)
    ((eq? id 'rule-hang-time) 2)
    (else 0)))

(defun mod-rule-type ((id symbol))
  (cond
    ((or (eq? id 'rule-keep-it-low)
         (eq? id 'rule-die)
         (eq? id 'rule-lurker-pressure)
         (eq? id 'rule-hitlist)
         (eq? id 'rule-double-kill)
         (eq? id 'rule-sniper)
         (eq? id 'rule-crate-break)
         (eq? id 'rule-money-pressure)
         (eq? id 'rule-fuel-pressure)
         (eq? id 'rule-buzzer-pressure)
         (eq? id 'rule-flop-this)
         (eq? id 'rule-grounded)
         (eq? id 'rule-survivor)
         (eq? id 'rule-management)
         (eq? id 'rule-vendetta)
         (eq? id 'rule-hands-on)
         (eq? id 'rule-one-frame)
         (eq? id 'rule-distancing)
         (eq? id 'rule-red-light)
         (eq? id 'rule-for-billy)
         (eq? id 'rule-cold-feet)
         (eq? id 'rule-speed)
         (eq? id 'rule-math-quiz)
         (eq? id 'rule-trivia)
         (eq? id 'rule-green-pilled)
         (eq? id 'rule-button-pusher)
         (eq? id 'rule-loyal-customer)
         (eq? id 'rule-cooked)
         (eq? id 'rule-sagging-sails)
         (eq? id 'rule-side-to-side)
         (eq? id 'rule-landlubber)
         (eq? id 'rule-express-delivery)
         (eq? id 'rule-qte)
         (eq? id 'rule-touch-grass)
         (eq? id 'rule-hang-time)
         (eq? id 'rule-no-harm))
     'rule)
    ((or (eq? id 'complication-brittle-bones)
         (eq? id 'complication-rotten-eggs)
         (eq? id 'complication-eco-allergy)
         (eq? id 'complication-sizeable)
         (eq? id 'complication-cumbersome)
         (eq? id 'complication-ohko)
         (eq? id 'complication-critical)
         (eq? id 'complication-heating-balloons)
         (eq? id 'complication-glare)
         (eq? id 'complication-disassociate)
         (eq? id 'complication-bus-driver)
         (eq? id 'complication-wings-tied)
         (eq? id 'complication-fuel-shortage)
         (eq? id 'complication-jak-rabbit)
         (eq? id 'complication-hidden-treasure)
         (eq? id 'complication-drought)
         (eq? id 'complication-eco-reserve)
         (eq? id 'complication-red-stop)
         (eq? id 'complication-rgyb)
         (eq? id 'complication-butter-fingers)
