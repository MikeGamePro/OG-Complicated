(defun mod-rule-trigger-sizeable ()
  (if (mod-rule-active? 'complication-sizeable)
    (if (>= (current-orb-count) 2.0) (begin   (set! (-> *game-info* money) (- (current-orb-count) 2.0))   #t) #f)
    #t))

(defun mod-rule-trigger-ohko ()
  (when (and (> (-> (the-as fact-info-target (-> *target* fact)) health) 1.0)
             (and (or (mod-rule-active? 'rule-survivor) (mod-rule-active? 'complication-ohko)) *target*))
    (set! (-> (the-as fact-info-target (-> *target* fact)) health) 1.0))
  (none))

(defun mod-rule-trigger-glare ()
  (when (mod-rule-active? 'complication-glare)
    (logior! (-> *target* mask) (process-mask sleep))
    (set! (-> *MOD-rule-context-bank* mean-look-clear-time) (+ (current-time) (* 3 300))))
  (none))

(defun mod-rule-trigger-shifty ()
  (when (and (mod-rule-active? 'complication-shifty) (>= (current-time) (-> *MOD-rule-context-bank* shifty-next-time)))
    (when (and *target* (not (movie?)))
      (let ((dx (mod-rand-float-range 1.5 5.0))
            (dz (mod-rand-float-range 1.5 5.0))
            (sfx (mod-rand-int-range 0 3)))
        (when (= (mod-rand-int-range 0 2) 0)
          (set! dx (- dx)))
        (when (= (mod-rand-int-range 0 2) 0)
          (set! dz (- dz)))
        (set! (-> (target-pos 0) x) (+ (-> (target-pos 0) x) (meters dx)))
        (set! (-> (target-pos 0) z) (+ (-> (target-pos 0) z) (meters dz)))
        (cond
          ((= sfx 0) (play-custom-sfx "warp1.mp3" 60.0))
          ((= sfx 1) (play-custom-sfx "warp2.mp3" 60.0))
          ((= sfx 2) (play-custom-sfx "warp3.mp3" 60.0)))))
    (set! (-> *MOD-rule-context-bank* shifty-next-time) (+ (current-time) (seconds (mod-rand-int-range 1 11)))))
  (none))

(defun mod-rule-trigger-lurker-pressure ()
