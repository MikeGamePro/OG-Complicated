;;-*-Lisp-*-
(in-package goal)
(require "engine/mods/mod-banks.gc")
(defconstant MOD_TICKS_PER_TENTH 30)

;; mask passed to update-perm! when un-collecting a fuel cell
(defconstant MOD_REVERT_PERM_STATUS 1919)

;; name: mod-common-functions.gc
;; name in dgo: mod-common-functions
;; dgos: TODO

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; What is this file for.
;;;;;;;;;;;;;;;;;;;;;;;;;;

#|
 This file is a place where you can define custom functions and GOAL code
 to call inside of mod-custom-code.gc for example I have defined a function that increases
 the powercell count by one when it is called
|#

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Useful GOAL modding documentation
;;;;;;;;;;;;;;;;;;;;;;;;;;

#|
Checks the condition and if it is true it does first argument if false it does optional second argument
(if (condition) (do if true) (do if false))

Gives a random FLOAT or INT between the provided ranges when called
(rand-vu-float-range 0.0 2.0)
(rand-vu-int-range 0 10)

if the result of rand-vu-int-range is 1, then DANCE! if it is not 1, then Don't dance
(if (= (rand-vu-int-range 0 10) 1) (DANCE!) (Don't dance))
|#

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Define Custom Variables to use in mods
;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Define Custom Functions to call in mods
;;;;;;;;;;;;;;;;;;;;;;;;;;

;; add your own unique custom functions here!

;; COMMAND/FUNCTION REFERENCE
;; Start game: (global-countdown-start)
;; Stop game: (mod-global-countdown-reset)
;; Force specific rule: (mod-rule-activate-slot 0 'rule-grounded)
;; Check if a specific slot is active: (mod-rule-slot-active? 0)

;; add new options here (getter)
(define-extern show-countup-timer-enabled? (function symbol))

(define-extern punishment-toggle-enabled? (function symbol symbol))

(define-extern klaww-assist-enabled? (function symbol))

(define-extern fish-assist-enabled? (function symbol))

(define-extern orb-increment-value (function float))

(define-extern fly-increment-value (function float))

(define-extern cell-increment-value (function float))

(define-extern countdown-start-seconds-value (function float))

(define-extern compliance-increment-value (function float))

(define-extern pass-credits-required-value (function int))

(define-extern *complicated-difficulty-preset* symbol)

(define-extern time-limit-multiplier (function float))

(define-extern text-scale-multiplier (function float))

(define-extern mod-rule-twist-check-and-mark! (function int symbol none))

(define-extern mod-rule-twist-marked-slot? (function int symbol))

(define-extern mod-rule-resolve! (function int symbol symbol none))

(define-extern mod-condition-enabled? (function symbol symbol))

(define-extern complicated-get-seed (function uint))

;; Macros can be used more-or-less just like functions
(defmacro current-cell-count ()
  `(-> *game-info* fuel))

(defmacro set-current-cell-count (count)
  `(set! (-> *game-info* fuel) ,count))

(defmacro current-checkpoint-name ()
  `(-> *game-info* current-continue name))

(defun set-current-checkpoint-by-name ((name string))
  (set-continue! *game-info* name))

(defmacro current-level-name ()
  `(-> (level-get-target-inside *level*) name))

(defmacro current-orb-count ()
  `(-> *game-info* money))

(defmacro current-cutscene ()
  `(-> *art-control* active-stream))

(defmacro set-cpad-pressed! (pad-idx &rest buttons)
  `(logior! (cpad-pressed ,pad-idx) (pad-buttons ,@buttons)))

(defmacro set-cpad-hold! (pad-idx &rest buttons)
  `(logior! (cpad-hold ,pad-idx) (pad-buttons ,@buttons)))

(defun increase-power-cell-by-one ()
  (set-current-cell-count (+ (current-cell-count) 1))
  ;; with the two macros defined above, this is equivalent to
  ;; (set! (-> *game-info* fuel) (+ (-> *game-info* fuel) 1))
  (none))

(defun mod-target-airborne? ()
  (and *target*
       (> (-> (the-as fact-info-target (-> *target* fact)) health) 0.0)
       (not (logtest? (-> *target* control status) (cshape-moving-flags onground)))
       (let ((state-name (-> *target* state name)))
         (not (or (= state-name 'target-edge-grab)
                  ;; (= state-name 'target-edge-grab-jump)
                  ;; (= state-name 'target-edge-grab-off)
                  (= state-name 'target-look-around)
                  (= state-name 'target-stance)
                  (= state-name 'target-walk)
                  (= state-name 'target-duck-stance)
                  (= state-name 'target-duck-walk)
                  (= state-name 'target-attack)
                  (= state-name 'target-hit-ground-hard)
                  (= state-name 'target-hit-ground)
                  (= state-name 'target-flop-hit-ground)
                  (= state-name 'target-slide-down))))))

