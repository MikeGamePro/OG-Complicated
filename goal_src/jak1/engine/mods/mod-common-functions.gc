(defun mod-rule-duration ((id symbol))
  (cond
    ((eq? id 'rule-grounded) (seconds 15)) ;; 15
    ((eq? id 'rule-management) (seconds 90)) ;; 90
    ((eq? id 'rule-die) (apply-time-limit-multiplier (seconds 20))) ;; 20
    ((eq? id 'rule-lurker-pressure) (apply-time-limit-multiplier (seconds 45))) ;; 45
    ((eq? id 'rule-hitlist) (apply-time-limit-multiplier (seconds 50))) ;; 50
    ((eq? id 'rule-double-kill) (apply-time-limit-multiplier (seconds 45))) ;; 45
    ((eq? id 'rule-sniper) (apply-time-limit-multiplier (seconds 75))) ;; 75
    ((eq? id 'rule-money-pressure) (apply-time-limit-multiplier (seconds 40))) ;; 40
    ((eq? id 'rule-fuel-pressure) (apply-time-limit-multiplier (seconds 35))) ;; 35
    ((eq? id 'rule-buzzer-pressure) (apply-time-limit-multiplier (seconds 40))) ;; 40
    ((eq? id 'rule-flop-this) (seconds 60)) ;; 60
    ((eq? id 'complication-brittle-bones) (seconds 50)) ;; 50
    ((eq? id 'complication-rotten-eggs) (seconds 45)) ;; 45
    ((eq? id 'complication-eco-allergy) (seconds 45)) ;; 45
    ((eq? id 'rule-keep-it-low) (seconds 90)) ;; 90
