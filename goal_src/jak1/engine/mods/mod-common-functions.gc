    (mod-rule-counter-add-progress 'rule-lurker-pressure 1))
  (none))

(defun mod-rule-trigger-double-kill ()
  (when (mod-rule-active? 'rule-double-kill)
    (let ((now (current-time)))
      (if (and (> (-> *MOD-rule-context-bank* last-kill-time) 0)
               (<= (- now (-> *MOD-rule-context-bank* last-kill-time)) (seconds 0.15)))
        (begin
          (mod-rule-counter-add-progress 'rule-double-kill 1)
          (set! (-> *MOD-rule-context-bank* last-kill-time) 0))
        (set! (-> *MOD-rule-context-bank* last-kill-time) now))))
  (none))

