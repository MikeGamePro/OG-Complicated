(defun mod-rule-active? ((id symbol))
  (let ((slot 0)
        (found #f))
    (while (and (< slot *mod-rule-slot-count*) (not found))
      (when (= (-> (-> *MOD-rule-slot-bank* active-slots) slot) id)
        (set! found #t))
      (+! slot 1))
    found))

(defun mod-rule-pending? ((id symbol))
  (let ((slot 0)
        (found #f))
    (while (and (< slot *mod-rule-slot-count*) (not found))
      (when (= (-> (-> *MOD-rule-slot-bank* pending-slots) slot) id)
        (set! found #t))
      (+! slot 1))
    found))

(defun mod-rule-active-slot-count ()
  "Count active and pending slots. Do not cache this: pending rolls are state too."
  (let ((slot 0)
        (count 0))
    (while (< slot *mod-rule-slot-count*)
      (when (or (-> (-> *MOD-rule-slot-bank* active-slots) slot) (-> (-> *MOD-rule-slot-bank* pending-slots) slot))
        (+! count 1))
      (+! slot 1))
    count))

(defun mod-rule-any-rule-active? ()
  (let ((slot 0)
        (found #f))
    (while (and (< slot *mod-rule-slot-count*) (not found))
      (let ((id (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
        (when (and id (eq? (mod-rule-type id) 'rule))
          (set! found #t)))
      (+! slot 1))
    found))

(defun mod-rule-first-free-slot ()
  (let ((slot 0)
        (result -1))
    (while (and (< slot *mod-rule-slot-count*) (< result 0))
      (when (and (not (-> (-> *MOD-rule-slot-bank* active-slots) slot)) (not (-> (-> *MOD-rule-slot-bank* pending-slots) slot)))
        (set! result slot))
      (+! slot 1))
    result))

(defun mod-rule-first-occupied-slot ()
  (let ((slot 0)
        (result -1))
    (while (and (< slot *mod-rule-slot-count*) (< result 0))
      (when (or (-> (-> *MOD-rule-slot-bank* active-slots) slot) (-> (-> *MOD-rule-slot-bank* pending-slots) slot))
        (set! result slot))
      (+! slot 1))
    result))

(defun mod-rule-find-active-slot ((id symbol))
  (let ((slot 0)
        (result -1))
    (while (and (< slot *mod-rule-slot-count*) (< result 0))
      (when (= (-> (-> *MOD-rule-slot-bank* active-slots) slot) id)
        (set! result slot))
      (+! slot 1))
    result))

(defun mod-rule-clear-slot ((slot int))
  (when (and (>= slot 0) (< slot *mod-rule-slot-count*))
    (set! (-> (-> *MOD-rule-slot-bank* active-slots) slot) #f)
    (set! (-> (-> *MOD-rule-slot-bank* pending-slots) slot) #f)
    (set! (-> (-> *MOD-rule-slot-bank* slot-punishments) slot) #f)
    (set! (-> (-> *MOD-rule-slot-bank* slot-goals) slot) 0)
    (set! (-> (-> *MOD-rule-slot-bank* slot-progress) slot) 0)
    (set! (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) 0)
    (set! (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot) 0)
    (set! (-> (-> *MOD-rule-slot-bank* slot-grace-periods) slot) 0))
  (none))

(defun mod-rule-punishment-duration ((punishment symbol))
  (cond
    ((eq? punishment 'punishment-blind) (seconds 10))
    ((eq? punishment 'punishment-fall-damage) (seconds 120))
    ((eq? punishment 'punishment-trip) (seconds 120))
    ((eq? punishment 'punishment-edge) (seconds 240))
    ((eq? punishment 'punishment-delay) (seconds 60))
    ((eq? punishment 'punishment-iframes) (seconds 180))
    ((eq? punishment 'punishment-camera) (seconds 120))
    ((eq? punishment 'punishment-ohko) (seconds 120))
    (else 0)))

(defun mod-rule-find-timed-punishment-slot ((punishment symbol))
  (let ((slot 0)
        (result -1))
    (while (and (< slot *mod-rule-timed-punishment-slot-count*) (< result 0))
      (when (= (-> (-> *MOD-rule-punishment-bank* timed-punishments) slot) punishment)
        (set! result slot))
      (+! slot 1))
    result))

(defun mod-rule-first-free-timed-punishment-slot ()
  (let ((slot 0)
        (result -1))
    (while (and (< slot *mod-rule-timed-punishment-slot-count*) (< result 0))
      (when (not (-> (-> *MOD-rule-punishment-bank* timed-punishments) slot))
        (set! result slot))
      (+! slot 1))
    result))

(defun mod-rule-start-timed-punishment ((punishment symbol))
  (let ((duration (mod-rule-punishment-duration punishment)))
    (when (> duration 0)
      (let ((slot (mod-rule-find-timed-punishment-slot punishment)))
        (when (< slot 0)
          (set! slot (mod-rule-first-free-timed-punishment-slot)))
        (when (>= slot 0)
          (set! (-> (-> *MOD-rule-punishment-bank* timed-punishments) slot) punishment)
          (set! (-> (-> *MOD-rule-punishment-bank* timed-end-times) slot) (+ (current-time) duration))
          (set! (-> (-> *MOD-rule-punishment-bank* timed-next-ticks) slot) (+ (current-time) (seconds 1)))))))
  (none))

(defun mod-rule-timed-punishment-active? ((punishment symbol))
  (let ((slot (mod-rule-find-timed-punishment-slot punishment)))
    (and (>= slot 0) (> (-> (-> *MOD-rule-punishment-bank* timed-end-times) slot) (current-time)))))

(defun mod-rule-clear-timed-punishment-slot ((slot int))
  (set! (-> (-> *MOD-rule-punishment-bank* timed-punishments) slot) #f)
  (set! (-> (-> *MOD-rule-punishment-bank* timed-end-times) slot) 0)
  (set! (-> (-> *MOD-rule-punishment-bank* timed-next-ticks) slot) 0)
  (none))

(defun mod-rule-end-timed-punishment ((punishment symbol))
  (case punishment
    (('punishment-fall-damage)
     (set! (-> *TARGET-bank* fall-far) (meters 30))
     (set! (-> *TARGET-bank* fall-far-inc) (meters 20)))
    (('punishment-delay) (input-delay-enable! #f 0.0))
    (('punishment-iframes) (set! (-> *TARGET-bank* hit-invulnerable-timeout) (seconds 3))))
  (none))

(defun mod-rule-update-timed-punishments ()
  (dotimes (slot *mod-rule-timed-punishment-slot-count*)
    (let ((punishment (-> (-> *MOD-rule-punishment-bank* timed-punishments) slot)))
      (when punishment
        (if (>= (current-time) (-> (-> *MOD-rule-punishment-bank* timed-end-times) slot))
          (begin
            (mod-rule-end-timed-punishment punishment)
            (mod-rule-clear-timed-punishment-slot slot))
          (begin
            (when (and (eq? punishment 'punishment-trip) (>= (current-time) (-> (-> *MOD-rule-punishment-bank* timed-next-ticks) slot)))
              (set! (-> (-> *MOD-rule-punishment-bank* timed-next-ticks) slot)
                    (+ (-> (-> *MOD-rule-punishment-bank* timed-next-ticks) slot) (seconds 1)))
              (when (= (mod-rand-punish-int-range 0 12) 0)
                (send-event *target* 'loading))))))))
  (none))

(defun mod-rule-update-hang-time ()
  (when (mod-rule-active? 'rule-hang-time)
    (let ((slot (mod-rule-find-active-slot 'rule-hang-time)))
      (when (>= slot 0)
        (let ((goal-frames (* (mod-rule-counter-goal 'rule-hang-time) (seconds 1))))
          (if (mod-rule-target-airborne?)
            (let* ((elapsed (- (current-time) (-> *MOD-rule-context-bank* hang-time-air-start)))
                   (whole-seconds (min (mod-rule-counter-goal 'rule-hang-time) (the int (/ elapsed (seconds 1))))))
              (set! (-> (-> *MOD-rule-slot-bank* slot-progress) slot) whole-seconds)
              (when (>= elapsed goal-frames)
                (mod-rule-resolve! slot 'success #f)))
            (begin
              (set! (-> *MOD-rule-context-bank* hang-time-air-start) (current-time))
              (set! (-> (-> *MOD-rule-slot-bank* slot-progress) slot) 0)))))))
  (none))

(defun mod-rule-schedule-slot ((slot int) (id symbol) (apply-buffer symbol))
  (when (and (>= slot 0) (< slot *mod-rule-slot-count*) id)
    (set! (-> (-> *MOD-rule-slot-bank* pending-slots) slot) id)
    (set! (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot)
          (+ (current-time) (if apply-buffer (-> *MOD-tuning-bank* roll-buffer-time) 0))))
  (none))

(defun mod-rule-current-active-id ()
  (let ((slot 0)
        (found #f)
        (result #f))
    (while (and (< slot *mod-rule-slot-count*) (not found))
      (let ((candidate (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
        (when candidate
          (set! result candidate)
          (set! found #t)))
      (+! slot 1))
    result))

(defun mod-rule-current-time-left ()
  (let ((slot 0)
        (found #f)
        (result 0))
    (while (and (< slot *mod-rule-slot-count*) (not found))
      (let ((candidate (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
        (when candidate
          (set! result (max 0 (- (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (current-time))))
          (set! found #t)))
      (+! slot 1))
    result))

(defun mod-rule-task-has-fuel-cell-entity? ((task game-task))
  (let ((level-idx 0)
        (found #f))
    (while (and (< level-idx (-> *level* length)) (not found))
      (let* ((lev (-> *level* level level-idx))
             (entities (-> lev bsp level entity))
             (entity-idx 0))
        (while (and (< entity-idx (-> entities length)) (not found))
          (let ((ent (-> entities data entity-idx entity)))
            (when (and ent
                       (type-type? (-> ent type) entity-actor)
                       (= (-> (the-as entity-actor ent) etype) fuel-cell)
                       (= (-> ent extra perm task) task))
              (set! found #t)))
          (+! entity-idx 1)))
      (+! level-idx 1))
    found))

(defun mod-rule-cell-task-complete? ((task game-task))
  (and (nonzero? task) (!= task (game-task complete)) (task-complete? *game-info* task)))

(defun mod-rule-cell-task-blacklisted? ((task game-task))
  (let ((idx 0)
        (blocked #f))
    (while (and (< idx (length *mod-rule-revert-cell-task-blacklist*)) (not blocked))
      (when (= (-> *mod-rule-revert-cell-task-blacklist* idx) task)
        (set! blocked #t))
      (+! idx 1))
    blocked))

(defun mod-rule-cell-task-revert-eligible? ((task game-task))
  (and (mod-rule-cell-task-complete? task) (not (mod-rule-cell-task-blacklisted? task))))

(defun mod-rule-collected-cell-candidate-count ()
  (let ((idx 0)
        (count 0))
    (while (< idx (length *mod-rule-all-cell-tasks*))
      (when (mod-rule-cell-task-revert-eligible? (-> *mod-rule-all-cell-tasks* idx))
        (+! count 1))
      (+! idx 1))
    count))

(defun mod-rule-can-revert-collected-cell? ()
  (> (mod-rule-collected-cell-candidate-count) 0))

(defun mod-rule-reopen-task-stage ((task game-task))
  ;; (when (task-closed? task (task-status need-hint))
  ;;   (open-specific-task! task (task-status need-hint)))
  ;; (when (task-closed? task (task-status need-introduction))
  ;;   (open-specific-task! task (task-status need-introduction)))
  ;; (when (task-closed? task (task-status need-reminder-a))
  ;;   (open-specific-task! task (task-status need-reminder-a)))
  ;; (when (task-closed? task (task-status need-reminder))
  ;;   (open-specific-task! task (task-status need-reminder)))
  (when (task-closed? task (task-status need-reward-speech))
    (open-specific-task! task (task-status need-reward-speech)))
  (when (task-closed? task (task-status need-resolution))
    (open-specific-task! task (task-status need-resolution)))
  (when (task-closed? task (task-status unknown))
    (open-specific-task! task (task-status unknown)))
  (none))

(defun mod-rule-force-open-task-stage ((task game-task))
  ;; (when (task-exists? task (task-status need-hint))
  ;;   (open-specific-task! task (task-status need-hint)))
  ;; (when (task-exists? task (task-status need-introduction))
  ;;   (open-specific-task! task (task-status need-introduction)))
  ;; (when (task-exists? task (task-status need-reminder-a))
  ;;   (open-specific-task! task (task-status need-reminder-a)))
  ;; (when (task-exists? task (task-status need-reminder))
  ;;   (open-specific-task! task (task-status need-reminder)))
  (when (task-exists? task (task-status need-reward-speech))
    (open-specific-task! task (task-status need-reward-speech)))
  (when (task-exists? task (task-status need-resolution))
    (open-specific-task! task (task-status need-resolution)))
  (when (task-exists? task (task-status unknown))
    (open-specific-task! task (task-status unknown)))
  (none))

(defun mod-rule-revert-random-collected-cell ()
  (let ((candidate-count (mod-rule-collected-cell-candidate-count)))
    (when (> candidate-count 0)
      (let* ((pick (mod-rand-punish-int-range 0 candidate-count))
             (remaining pick)
             (idx 0)
             (chosen-task (game-task none)))
        (while (and (< idx (length *mod-rule-all-cell-tasks*)) (= chosen-task (game-task none)))
          (let ((task (-> *mod-rule-all-cell-tasks* idx)))
            (when (mod-rule-cell-task-revert-eligible? task)
              (if (= remaining 0) (set! chosen-task task) (+! remaining -1))))
          (+! idx 1))
        (when (!= chosen-task (game-task none))
          (update-perm! (-> *game-info* task-perm-list data chosen-task) 'game (the-as entity-perm-status 1919))
          (logclear! (-> *game-info* task-perm-list data chosen-task status) (entity-perm-status real-complete))
          (mod-rule-reopen-task-stage chosen-task)
          (mod-rule-force-open-task-stage chosen-task)
          (let ((perm-list (-> *game-info* perm-list))
                (idx2 0))
            (while (< idx2 (-> perm-list length))
              (let ((perm2 (-> perm-list data idx2)))
                (when (= (-> perm2 task) chosen-task)
                  (update-perm! perm2 'game (the-as entity-perm-status 1919))))
              (+! idx2 1)))
          (let ((level-idx 0)
                (spawned #f))
            (while (< level-idx (-> *level* length))
              (let ((lev (-> *level* level level-idx)))
                (when (= (-> lev status) 'active)
                  (let ((entities (-> lev bsp level entity))
                        (entity-idx 0))
                    (while (< entity-idx (-> entities length))
                      (let ((ent (-> entities data entity-idx entity)))
                        (when (and ent
                                   (type-type? (-> ent type) entity-actor)
                                   (= (-> (the-as entity-actor ent) etype) fuel-cell)
                                   (= (-> ent extra perm task) chosen-task))
                          (update-perm! (-> ent extra perm) 'game (the-as entity-perm-status 1919))
                          (when (not spawned)
                            (entity-birth-no-kill ent)
                            (set! spawned #t))))
                      (+! entity-idx 1)))))
              (+! level-idx 1)))
          (set! (-> *game-info* fuel) (max 0.0 (- (-> *game-info* fuel) 1.0)))
          (set! (-> *MOD-rule-context-bank* last-reverted-cell-task) (the int chosen-task))
          (set! (-> *MOD-rule-context-bank* last-reverted-cell-until) (+ (current-time) (seconds 5)))))))
  (none))

(defun target-on-racer? ()
  (if (not *target*) #f (let ((mode (send-event *target* 'query 'mode))) (= mode 'racer))))

(defun target-on-flut? ()
  (if (not *target*) #f (let ((mode (send-event *target* 'query 'mode))) (= mode 'flut))))

(defun target-on-racer-or-flut? ()
  (or (target-on-racer?) (target-on-flut?)))

(defun mod-rule-trigger-red-light ()
  (when (mod-rule-active? 'rule-red-light)
    (when (or (and (not (target-on-racer?)) (or (cpad-pressed? 0 circle) (cpad-pressed? 0 square) (cpad-pressed? 0 x)))
              (cpad-pressed? 0 l1)
              (cpad-pressed? 0 r1)
              (!= (-> *cpad-list* cpads 0 stick0-speed) 0.0)
              (and (target-on-racer?) (cpad-hold? 0 x)))
      (mod-rule-trigger-failure 'rule-red-light)))
  (none))

(defun target-mesh-invis-set! ((on symbol))
  (when (and on (not (-> *MOD-target-mesh-bank* invis-active?)))
    (set! (-> *MOD-target-mesh-bank* invis-active?) #t)
    (let* ((lods (-> *target* draw lod-set))
           (max-lod (-> lods max-lod))
           (idx 0))
      (dotimes (i (+ max-lod 1))
        (let* ((ctrl (-> lods lod i geo))
               (effect-count (-> ctrl header effect-count)))
          (dotimes (j effect-count)
            (let ((eff (-> ctrl effect j)))
              (set! (-> *MOD-target-mesh-bank* envmap-save idx) (the-as int (-> eff envmap-usage)))
              (set! (-> eff envmap-usage) 0))
            (set! idx (+ idx 1)))))))
  (when (and (not on) (-> *MOD-target-mesh-bank* invis-active?))
    (set! (-> *MOD-target-mesh-bank* invis-active?) #f)
    (let* ((lods (-> *target* draw lod-set))
           (max-lod (-> lods max-lod))
           (idx 0))
      (dotimes (i (+ max-lod 1))
        (let* ((ctrl (-> lods lod i geo))
               (effect-count (-> ctrl header effect-count)))
          (dotimes (j effect-count)
            (let ((eff (-> ctrl effect j))) (set! (-> eff envmap-usage) (the-as uint8 (-> *MOD-target-mesh-bank* envmap-save idx))))
            (set! idx (+ idx 1)))))))
  (none))

(defun mod-rule-punishment-used-by-active-slot? ((punishment symbol))
  (let ((slot 0)
        (used #f))
    (while (and (< slot *mod-rule-slot-count*) (not used))
      (when (and (-> (-> *MOD-rule-slot-bank* active-slots) slot)
                 (eq? (-> (-> *MOD-rule-slot-bank* slot-punishments) slot) punishment))
        (set! used #t))
      (+! slot 1))
    used))

(defun mod-rule-punishment-rollable? ((punishment symbol))
  (and (not (mod-rule-timed-punishment-active? punishment)) (not (mod-rule-punishment-used-by-active-slot? punishment))))

(defun mod-rule-random-available-punishment ((rule-id symbol))
  (let ((selected 'punishment-countdown)
        (running-total 0))
    (when (and (not (eq? rule-id 'rule-for-billy))
               (punishment-toggle-enabled? 'punishment-countdown)
               (mod-rule-punishment-rollable? 'punishment-countdown))
      (let ((w 10))
        (+! running-total w)
        (when (< (mod-rand-punish-int-range 0 running-total) w)
          (set! selected 'punishment-countdown))))
    (when (and (not (or (eq? (current-level-name) 'finalboss) (target-on-racer-or-flut?)))
               (punishment-toggle-enabled? 'punishment-fall-damage)
               (mod-rule-punishment-rollable? 'punishment-fall-damage))
      (let ((w 10))
        (+! running-total w)
        (when (< (mod-rand-punish-int-range 0 running-total) w)
          (set! selected 'punishment-fall-damage))))
    (when (and (not (target-on-racer-or-flut?))
               (punishment-toggle-enabled? 'punishment-trip)
               (mod-rule-punishment-rollable? 'punishment-trip))
      (let ((w 10))
        (+! running-total w)
        (when (< (mod-rand-punish-int-range 0 running-total) w)
          (set! selected 'punishment-trip))))
    (when (and (not (eq? (current-level-name) 'finalboss))
               (not (target-on-racer-or-flut?))
               (punishment-toggle-enabled? 'punishment-edge)
               (mod-rule-punishment-rollable? 'punishment-edge))
      (let ((w 10))
        (+! running-total w)
        (when (< (mod-rand-punish-int-range 0 running-total) w)
          (set! selected 'punishment-edge))))
    (when (and (>= (current-orb-count) 30.0)
               (not (or (eq? (current-level-name) 'citadel) (eq? (current-level-name) 'finalboss) (eq? (current-level-name) 'lavatube)))
               (punishment-toggle-enabled? 'punishment-money)
               (mod-rule-punishment-rollable? 'punishment-money))
      (let ((w 10))
        (+! running-total w)
        (when (< (mod-rand-punish-int-range 0 running-total) w)
          (set! selected 'punishment-money))))
    (when (and (!= (-> (level-get-target-inside *level*) name) 'training)
               (punishment-toggle-enabled? 'punishment-warp)
               (mod-rule-punishment-rollable? 'punishment-warp))
      (let ((w 8))
        (+! running-total w)
        (when (< (mod-rand-punish-int-range 0 running-total) w)
          (set! selected 'punishment-warp))))
    (when (and (mod-rule-can-revert-collected-cell?)
               (punishment-toggle-enabled? 'punishment-revert-cell)
               (mod-rule-punishment-rollable? 'punishment-revert-cell))
      (let ((w 10))
        (+! running-total w)
        (when (< (mod-rand-punish-int-range 0 running-total) w)
          (set! selected 'punishment-revert-cell))))
    (when (and (< (mod-rule-active-slot-count) 2)
               (punishment-toggle-enabled? 'punishment-extra-rule)
               (mod-rule-punishment-rollable? 'punishment-extra-rule))
      (let ((w 10))
        (+! running-total w)
        (when (< (mod-rand-punish-int-range 0 running-total) w)
          (set! selected 'punishment-extra-rule))))
    (when (and (not (eq? rule-id 'rule-qte))
               (punishment-toggle-enabled? 'punishment-crash)
               (mod-rule-punishment-rollable? 'punishment-crash))
      (let ((w 6))
        (+! running-total w)
        (when (< (mod-rand-punish-int-range 0 running-total) w)
          (set! selected 'punishment-crash))))
    (when (and (not (mod-rule-active? 'complication-bad-ping))
               (punishment-toggle-enabled? 'punishment-delay)
               (mod-rule-punishment-rollable? 'punishment-delay))
      (let ((w 10)) ;; disabled for zed
        (when (> w 0)
          (+! running-total w)
          (when (< (mod-rand-punish-int-range 0 running-total) w)
            (set! selected 'punishment-delay)))))
    (when (and (punishment-toggle-enabled? 'punishment-blind) (mod-rule-punishment-rollable? 'punishment-blind))
      (let ((w 10)) ;; disabled
        (when (> w 0)
          (+! running-total w)
          (when (< (mod-rand-punish-int-range 0 running-total) w)
            (set! selected 'punishment-blind)))))
    (when (and (punishment-toggle-enabled? 'punishment-iframes) (mod-rule-punishment-rollable? 'punishment-iframes))
      (let ((w 10)) ;; disabled
        (when (> w 0)
          (+! running-total w)
          (when (< (mod-rand-punish-int-range 0 running-total) w)
            (set! selected 'punishment-iframes)))))
    (when (and (punishment-toggle-enabled? 'punishment-camera) (mod-rule-punishment-rollable? 'punishment-camera))
      (let ((w 10)) ;; disabled
        (when (> w 0)
          (+! running-total w)
          (when (< (mod-rand-punish-int-range 0 running-total) w)
            (set! selected 'punishment-camera)))))
    (when (and (punishment-toggle-enabled? 'punishment-ohko) (mod-rule-punishment-rollable? 'punishment-ohko))
      (let ((w 10))
        (when (> w 0)
          (+! running-total w)
          (when (< (mod-rand-punish-int-range 0 running-total) w)
            (set! selected 'punishment-ohko)))))
    (when (and (not (eq? rule-id 'rule-qte))
               (punishment-toggle-enabled? 'punishment-reset)
               (mod-rule-punishment-rollable? 'punishment-reset))
      (let ((w 3))
        (when (> w 0)
          (+! running-total w)
          (when (< (mod-rand-punish-int-range 0 running-total) w)
            (set! selected 'punishment-reset)))))
    selected))

(defun play-custom-sfx ((filename string) (base-volume float))
  (let* ((sfx-vol (-> *setting-control* current sfx-volume))
         (scaled-vol (the int (* base-volume (/ sfx-vol 100.0)))))
    (play-sound-file filename scaled-vol)))

(defun mod-rule-reapply-slot-visual-effect ((id symbol))
  (cond
    ((eq? id 'complication-mirror) (set! *mod-mirror-active?* #t))
    ((eq? id 'complication-hidden-treasure) (refresh-money-actors))
    ((eq? id 'complication-cumbersome) (orb-weight-apply!))
    ((eq? id 'complication-interference) (when (mod-rule-low-res-should-apply?) (mod-rule-apply-low-res!)))
    ((eq? id 'complication-invisible-man)
     (target-mesh-invis-set! #t)
     (set-vector! (-> *target* draw color-mult) 1.0 1.0 1.0 0.0)
     (send-event *target* 'sidekick #f)
     (let ((v1-9 (-> *target* draw shadow-ctrl))) (logior! (-> v1-9 settings flags) (shadow-flags disable-draw))))
    ((eq? id 'complication-bad-ping) (input-delay-enable! #t 0.12))
    ((eq? id 'complication-jak-rabbit)
     (set! (-> *TARGET-bank* jump-height-min) (meters 2.02))
     (set! (-> *TARGET-bank* jump-height-max) (meters 7))
     (set! (-> *TARGET-bank* double-jump-height-min) (meters 2))
     (set! (-> *TARGET-bank* double-jump-height-max) (meters 5))
     (set! (-> *TARGET-bank* flip-jump-height-min) (meters 10))
     (set! (-> *TARGET-bank* flip-jump-height-max) (meters 14))
     (set! (-> *TARGET-bank* duck-jump-height-min) (meters 10))
     (set! (-> *TARGET-bank* duck-jump-height-max) (meters 14))
     (set! (-> *TARGET-bank* flop-jump-height-min) (meters 10))
     (set! (-> *TARGET-bank* flop-jump-height-max) (meters 14))
     (set! (-> *TARGET-bank* swim-jump-height-min) (meters 10))
     (set! (-> *TARGET-bank* swim-jump-height-max) (meters 10))
     (set! (-> *TARGET-bank* tube-jump-height-min) (meters 3.5))
     (set! (-> *TARGET-bank* tube-jump-height-max) (meters 5))
     (set! (-> *FLUT-bank* jump-height-min) (meters 10))
     (set! (-> *FLUT-bank* jump-height-max) (meters 14))
     (set! (-> *FLUT-bank* double-jump-height-min) (meters 2))
     (set! (-> *FLUT-bank* double-jump-height-max) (meters 4)))
    ((eq? id 'complication-jak-be-nimble)
     (mod-rule-refresh-movement-speeds! #t (if (mod-rule-active? 'complication-cumbersome) (orb-weight-multiplier) 1.0))
     (set! (-> *high-jump-mods* target-speed) 77777.0)
     (set! (-> *duck-attack-mods* target-speed) 77777.0)
     (set! (-> *flop-mods* target-speed) 77777.0)
     (set! (-> *stone-surface* target-speed) 1.25))
    ((eq? id 'complication-joyride) (send-event *target* 'change-mode 'flut #f))
    ((eq? id 'complication-shifty)
     (set! (-> *MOD-rule-context-bank* shifty-next-time) (+ (current-time) (seconds (mod-rand-int-range 1 9)))))
    (else (none)))
  (none))

(defun mod-rule-on-activate ((id symbol))
  (cond
    ((eq? id 'rule-qte) (set! (-> *MOD-rule-context-bank* qte-target-button) (mod-rand-int-range 0 4)))
    ((eq? id 'complication-twisted)
     (set! (-> *MOD-rule-context-bank* twist-pending-count) (+ (-> *MOD-stats-bank* rules-rolled) (mod-rand-int-range 2 4))))
    ((eq? id 'rule-hitlist) (dotimes (slot 3) (set! (-> *mod-rule-unique-enemy-killed-types* slot) #f)))
    ((eq? id 'rule-double-kill) (set! (-> *MOD-rule-context-bank* last-kill-time) 0))
    ((eq? id 'rule-distancing) (set! *closest-buzzer-dist* 1000000000.0))
    ((eq? id 'rule-hang-time) (set! (-> *MOD-rule-context-bank* hang-time-air-start) (current-time)))
    ((eq? id 'complication-get-a-grip) (set! (-> *MOD-rule-context-bank* get-a-grip-last-grab) (current-time)))
    ((eq? id 'complication-bus-driver) (set! (-> *MOD-rule-context-bank* bus-driver-activate-time) (current-time)))
    ((eq? id 'complication-shifty)
     (set! (-> *MOD-rule-context-bank* shifty-next-time) (+ (current-time) (seconds (mod-rand-int-range 1 9)))))
    ((eq? id 'complication-vibe-check)
     (play-custom-sfx "I like ya cut g.mp3" 30.0)
     (process-spawn-function process
       (lambda ()
         (let ((start-time (current-time))) (until (>= (- (current-time) start-time) (seconds 1.35)) (suspend)))
         (if (and (< (-> (the-as fact-info-target (-> *target* fact)) health) 2.0) (target-on-racer?))
           (target-attack-up *target* 'attack 'explode)
           (send-event *target* 'attack #f (static-attack-info ((shove-back (meters 999)) (shove-up (meters 20)))))))))
    ((eq? id 'rule-trivia)
     (set! (-> *MOD-quiz-bank* trivia-current-question) (mod-rule-trivia-pick-question))
     (set! (-> *MOD-quiz-bank* trivia-current-guess) -1)
     (set! (-> *MOD-quiz-bank* trivia-dynamic-seed) (mod-rand-int-range 0 4096)))
    ((eq? id 'rule-math-quiz)
     (set! (-> *MOD-quiz-bank* math-op) (mod-rand-int-range 0 3))
     (let ((min-val (if (= (-> *MOD-quiz-bank* math-op) 2) 2 10))
           (max-val (if (= (-> *MOD-quiz-bank* math-op) 2) 13 61)))
       (set! (-> *MOD-quiz-bank* math-val1) (mod-rand-int-range min-val max-val))
       (set! (-> *MOD-quiz-bank* math-val2) (mod-rand-int-range min-val max-val)))
     (set! (-> *MOD-quiz-bank* math-current-guess) 0)
     (cond
       ((= (-> *MOD-quiz-bank* math-op) 0)
        (set! (-> *MOD-quiz-bank* math-answer) (+ (-> *MOD-quiz-bank* math-val1) (-> *MOD-quiz-bank* math-val2))))
       ((= (-> *MOD-quiz-bank* math-op) 1)
        (set! (-> *MOD-quiz-bank* math-answer) (- (-> *MOD-quiz-bank* math-val1) (-> *MOD-quiz-bank* math-val2))))
       ((= (-> *MOD-quiz-bank* math-op) 2)
        (set! (-> *MOD-quiz-bank* math-answer) (* (-> *MOD-quiz-bank* math-val1) (-> *MOD-quiz-bank* math-val2))))))
    (else (none)))
  (mod-rule-reapply-slot-visual-effect id)
  (none))

(defun mod-rule-deactivate-slot ((slot int))
  (when (and (>= slot 0) (< slot *mod-rule-slot-count*))
    (when (= slot (-> *MOD-rule-context-bank* twist-marked-slot))
      (set! (-> *MOD-rule-context-bank* twist-marked-slot) -1))
    (let ((id (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
      (when id
        (cond
          ((and *target* (or (eq? id 'complication-ohko) (eq? id 'rule-survivor)))
           (set! (-> (the-as fact-info-target (-> *target* fact)) health) 3.0))
          ((eq? id 'complication-hidden-treasure) (refresh-money-actors))
          ((eq? id 'complication-mirror) (set! *mod-mirror-active?* #f))
          ((eq? id 'complication-cumbersome) (orb-weight-reset!))
          ((and *target* (eq? id 'complication-bad-ping)) (input-delay-enable! #f 0.0))
          ((and *target* (eq? id 'complication-joyride) (target-on-flut?)) (send-event *target* 'end-mode))
          ((and *target* (eq? id 'complication-invisible-man))
           (target-mesh-invis-set! #f)
           (set-vector! (-> *target* draw color-mult) 1.0 1.0 1.0 1.0)
           (send-event *target* 'sidekick #t)
           (let ((v1-9 (-> *target* draw shadow-ctrl))) (logclear! (-> v1-9 settings flags) (shadow-flags disable-draw))))
          ((eq? id 'complication-jak-rabbit)
           (set! (-> *TARGET-bank* jump-height-min) (meters 1.01))
           (set! (-> *TARGET-bank* jump-height-max) (meters 3.5))
           (set! (-> *TARGET-bank* double-jump-height-min) (meters 1))
           (set! (-> *TARGET-bank* double-jump-height-max) (meters 2.5))
           (set! (-> *TARGET-bank* flip-jump-height-min) (meters 5))
           (set! (-> *TARGET-bank* flip-jump-height-max) (meters 7))
           (set! (-> *TARGET-bank* duck-jump-height-min) (meters 5))
           (set! (-> *TARGET-bank* duck-jump-height-max) (meters 7))
           (set! (-> *TARGET-bank* flop-jump-height-min) (meters 5))
           (set! (-> *TARGET-bank* flop-jump-height-max) (meters 7))
           (set! (-> *TARGET-bank* swim-jump-height-min) (meters 5))
           (set! (-> *TARGET-bank* swim-jump-height-max) (meters 5))
           (set! (-> *TARGET-bank* tube-jump-height-min) (meters 1.75))
           (set! (-> *TARGET-bank* tube-jump-height-max) (meters 2.5))
           (set! (-> *FLUT-bank* jump-height-min) (meters 5))
           (set! (-> *FLUT-bank* jump-height-max) (meters 7))
           (set! (-> *FLUT-bank* double-jump-height-min) (meters 1))
           (set! (-> *FLUT-bank* double-jump-height-max) (meters 2)))
          ((eq? id 'complication-jak-be-nimble)
           (mod-rule-refresh-movement-speeds! #f (if (mod-rule-active? 'complication-cumbersome) (orb-weight-multiplier) 1.0))
           (set! (-> *high-jump-mods* target-speed) 26624.0)
           (set! (-> *duck-attack-mods* target-speed) 16384.0)
           (set! (-> *flop-mods* target-speed) 40960.0)
           (set! (-> *stone-surface* target-speed) 1.0)))))
    (mod-rule-clear-slot slot))
  (none))

(defun mod-rule-activate-slot ((slot int) (id symbol))
  (when (and (>= slot 0) (< slot *mod-rule-slot-count*) id)
    (mod-rule-deactivate-slot slot)
    (set! (-> (-> *MOD-rule-slot-bank* active-slots) slot) id)
    (set! (-> *MOD-rule-context-bank* last-outcome) 'none)
    (if (or (eq? id 'rule-qte)
            (eq? id 'rule-math-quiz)
            (eq? id 'rule-trivia)
            (eq? id 'complication-twisted)
            (eq? id 'rule-red-light)
            (eq? id 'complication-palate-change))
      (sound-play "warning")
      (sound-play "ecohit2"))
    (set! (-> (-> *MOD-rule-slot-bank* slot-goals) slot) (mod-rule-counter-goal id))
    (set! (-> (-> *MOD-rule-slot-bank* slot-progress) slot) 0)
    (if (eq? (mod-rule-type id) 'rule)
      (begin
        (set! (-> (-> *MOD-rule-slot-bank* slot-punishments) slot) (mod-rule-random-available-punishment id))
        (+! (-> *MOD-stats-bank* rules-rolled) 1)
        (mod-rule-twist-check-and-mark! slot id))
      (begin
        (set! (-> (-> *MOD-rule-slot-bank* slot-punishments) slot) #f)
        (+! (-> *MOD-stats-bank* complications-rolled) 1)))
    (set! (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (+ (current-time) (mod-rule-duration id)))
    (set! (-> (-> *MOD-rule-slot-bank* slot-grace-periods) slot) (+ (current-time) (seconds 1.25)))
    (mod-rule-on-activate id))
  (none))

(defun mod-rule-clear-all-timed-punishments ()
  (dotimes (slot *mod-rule-timed-punishment-slot-count*)
    (let ((punishment (-> (-> *MOD-rule-punishment-bank* timed-punishments) slot)))
      (when punishment
        (mod-rule-end-timed-punishment punishment))
      (mod-rule-clear-timed-punishment-slot slot)))
  (none))

(defun mod-rule-clear-player-hit-cache ()
  (dotimes (idx 64)
    (set! (-> *MOD-rule-hit-bank* player-hit-handles idx) (the-as handle #f))
    (set! (-> *MOD-rule-hit-bank* player-hit-modes idx) #f))
  (set! (-> *MOD-rule-hit-bank* player-hit-write-idx) 0)
  (none))

(defun mod-rule-clear-recent-rolls ()
  (dotimes (slot 8)
    (set! (-> *mod-rule-recent-rolls* slot) #f))
  (none))

(defun mod-rules-reset-core ()
  (dotimes (slot *mod-rule-slot-count*)
    (mod-rule-deactivate-slot slot))
  (mod-rule-clear-all-timed-punishments)
  (dotimes (slot 3)
    (set! (-> *mod-rule-unique-enemy-killed-types* slot) #f))
  (mod-rule-clear-player-hit-cache)
  (mod-rule-clear-recent-rolls)
  (mod-rule-clear-trivia-used)
  (set! (-> *MOD-rule-context-bank* current-slot) 0)
  (set! (-> *MOD-rule-context-bank* last-kill-time) 0)
  (set! (-> *MOD-rule-context-bank* twist-pending-count) -1)
  (set! (-> *MOD-rule-context-bank* twist-marked-slot) -1)
  (set! (-> *MOD-rule-context-bank* last-outcome) 'none)
  (set! (-> *MOD-rule-context-bank* qte-target-button) 0)
  (set! (-> *MOD-rule-context-bank* hang-time-air-start) 0)
  (set! (-> *MOD-rule-context-bank* get-a-grip-last-grab) 0)
  (set! (-> *MOD-rule-context-bank* bus-driver-activate-time) 0)
  (set! (-> *MOD-rule-context-bank* mean-look-clear-time) 0)
  (set! (-> *MOD-rule-context-bank* last-reverted-cell-task) 0)
  (set! (-> *MOD-rule-context-bank* last-reverted-cell-until) 0)
  (none))

(defun mod-rules-reset ()
  (mod-rules-reset-core)
  (mod-stats-reset!)
  (none))

(defun global-countdown-freeze-for-game-beaten ()
  (kill-by-name 'global-countdown *active-pool*)
  (mod-rules-reset-core)
  (set! (-> *MOD-countdown-bank* active?) #f)
  (set! (-> *MOD-countdown-bank* lost?) #f)
  (none))

(defun mod-format-time-frame ((tf time-frame) (decimal-digits int) (hours-mode symbol))
  (let* ((ticks (max 0 (the int tf)))
         (total-seconds (the int (/ ticks (seconds 1))))
         (hours (the int (/ total-seconds 3600)))
         (minutes-full (the int (/ total-seconds 60)))
         (minutes-part (the int (mod minutes-full 60)))
         (seconds-part (the int (mod total-seconds 60)))
         (show-hours? (or (eq? hours-mode 'always) (and (eq? hours-mode 'auto) (> hours 0))))
         (minutes-out (if show-hours? minutes-part minutes-full))
         (frac-tenths (the int (/ (* (mod ticks (seconds 1)) 10) (seconds 1))))
         (frac-hundredths (the int (/ (* (mod ticks (seconds 1)) 100) (seconds 1))))
         (frac-millis (the int (/ (* (mod ticks (seconds 1)) 1000) (seconds 1)))))
    (cond
      ((and show-hours? (= decimal-digits 3))
       (string-format "~D:~2,'0D:~2,'0D.~3,'0D" hours minutes-out seconds-part frac-millis))
      ((and show-hours? (= decimal-digits 2))
       (string-format "~D:~2,'0D:~2,'0D.~2,'0D" hours minutes-out seconds-part frac-hundredths))
      ((and show-hours? (= decimal-digits 1))
       (string-format "~D:~2,'0D:~2,'0D.~1,'0D" hours minutes-out seconds-part frac-tenths))
      (show-hours? (string-format "~D:~2,'0D:~2,'0D" hours minutes-out seconds-part))
      ((= decimal-digits 3) (string-format "~D:~2,'0D.~3,'0D" minutes-out seconds-part frac-millis))
      ((= decimal-digits 2) (string-format "~D:~2,'0D.~2,'0D" minutes-out seconds-part frac-hundredths))
      ((= decimal-digits 1) (string-format "~D:~2,'0D.~1,'0D" minutes-out seconds-part frac-tenths))
      (else (string-format "~D:~2,'0D" minutes-out seconds-part)))))

(defun collected-money-for-level ((lvl-idx int))
  (-> *game-info* money-per-level lvl-idx))

(defun max-money-for-level ((lvl-idx int))
  (-> *game-counts* data lvl-idx money-count))

(defun collected-buzzer-for-level ((lvl-idx int))
  (buzzer-count *game-info*
                (-> *level-task-data* lvl-idx task-info (-> *level-task-data* lvl-idx buzzer-task-index) task-id)))

(defun collected-fuel-for-level ((lvl-idx int))
  (let ((completed-task-count 0))
    (dotimes (task-idx (-> *level-task-data* lvl-idx nb-of-tasks))
      (if (= (get-task-status (-> *level-task-data* lvl-idx task-info task-idx task-id)) (task-status invalid))
        (+! completed-task-count 1)))
    completed-task-count))

(defun max-fuel-for-level ((lvl-idx int))
  (-> *level-task-data* lvl-idx nb-of-tasks))

(defmacro def-current-level-wrapper (name for-level-fn)
  `(defun ,name ()
    (if (and *target* (-> *target* current-level))
      (let ((lvl-idx (-> *level-task-data-remap* (+ (-> *target* current-level info index) -1)))) (,for-level-fn lvl-idx))
      0)))

(def-current-level-wrapper collected-money-current-level collected-money-for-level)

(def-current-level-wrapper max-money-current-level max-money-for-level)

(def-current-level-wrapper collected-buzzer-current-level collected-buzzer-for-level)

(def-current-level-wrapper collected-fuel-current-level collected-fuel-for-level)

(def-current-level-wrapper max-fuel-current-level max-fuel-for-level)

(defun target-fishing? ()
  (if (not *target*) #f (let ((mode (send-event *target* 'query 'mode))) (= mode 'target-fishing))))

(defun target-billy-game? ()
  (if (not *target*) #f (let ((mode (send-event *target* 'query 'mode))) (= mode 'target-billy-game))))

(defun mod-rule-record-roll! ((id symbol))
  (when id
    (let ((slot 7))
      (while (> slot 0)
        (set! (-> *mod-rule-recent-rolls* slot) (-> *mod-rule-recent-rolls* (- slot 1)))
        (+! slot -1))
      (set! (-> *mod-rule-recent-rolls* 0) id)))
  (none))

(defun mod-rule-recent-roll-factor ((id symbol))
  (let ((slot 0)
        (factor 8)
        (found #f))
    (while (and (< slot 8) (not found))
      (when (= (-> *mod-rule-recent-rolls* slot) id)
        (set! factor slot)
        (set! found #t))
      (+! slot 1))
    factor))

(defun sole-zoomer-level? ((level symbol))
  (or (string= (current-checkpoint-name) "firecanyon-start")
      (eq? level 'rolling)
      (string= (current-checkpoint-name) "ogre-race")))

(defun sparse-lurker-level? ((level symbol))
  (case level
    (('training 'village1 'jungleb 'firecanyon 'village2 'rolling 'ogre 'village3 'lavatube) #t)
    (else #f)))

(defun sparse-hitlist-level? ((level symbol))
  (case level
    (('training 'village1 'village2 'village3 'jungleb 'rolling 'firecanyon 'ogre 'lavatube 'citadel 'finalboss 'sunkenb) #t)
    (else #f)))

(defun sparse-crate-level? ((level symbol))
  (case level
    (('village3 'jungleb 'darkcave 'lavatube 'citadel 'finalboss) #t)
    (else #f)))

(defun sparse-green-eco-level? ((level symbol))
  (or (case level
        (('village3 'jungleb 'lavatube 'citadel 'finalboss 'sunkenb 'firecanyon) #t)
        (else #f))
      (string= (current-checkpoint-name) "ogre-start")))

(defun red-eco-level? ((level symbol))
  (or (case level
        (('misty 'snowy) #t)
        (else #f))
      (string= (current-checkpoint-name) "citadel-generator-start")))

(defun yellow-eco-level? ((level symbol))
  (or (case level
        (('swamp 'snowy 'citadel 'finalboss 'lavatube 'maincave 'robocave 'darkcave) #t)
        (else #f))
      (and (eq? level 'ogre) (task-closed? (game-task snow-eggtop) (task-status need-resolution)))))

(defun no-blue-eco-level? ((level symbol))
  (case level
    (('maincave 'darkcave 'firecanyon 'finalboss 'village3 'ogre 'rolling 'lavatube) #t)
    (else #f)))

(defun hang-time-level? ((level symbol))
  (or (case level
        (('beach 'jungle 'misty 'rolling 'swamp 'sunkenb 'snow 'maincave 'robocave) #t)
        (else #f))
      (string= (current-checkpoint-name) "citadel-start")
      (string= (current-checkpoint-name) "citadel-launch-start")
      (string= (current-checkpoint-name) "citadel-launch-end")))

(defun launcher-level? ((level symbol))
  (or (and (eq? level 'beach) (task-closed? (game-task jungle-eggtop) (task-status need-resolution)))
      (case level
        (('jungle 'jungleb 'swamp 'robocave) #t)
        (else #f))
      (string= (current-checkpoint-name) "citadel-start")
      (string= (current-checkpoint-name) "citadel-launch-start")
      (string= (current-checkpoint-name) "citadel-launch-end")))

(defun grass-level? ((level symbol))
  (case level
    (('beach 'village1 'jungle 'village2) #t)
    (else #f)))

(defun no-drought-level? ((level symbol))
  (or (case level
        (('swamp 'snow 'lavatube 'jungleb 'citadel 'finalboss) #t)
        (else #f))
      (string= (current-checkpoint-name) "ogre-race")
      (string= (current-checkpoint-name) "firecanyon-start")))

(defun water-level? ((level symbol))
  (case level
    (('beach 'village1 'training 'misty 'jungle 'village2 'swamp 'sunken 'sunkenb) #t)
    (else #f)))

(defun button-level? ((level symbol))
  (or (case level
        (('jungle 'citadel 'village2) #t)
        (else #f))
      (and (eq? level 'jungleb) (not (task-complete? *game-info* (game-task jungle-eggtop))))
      (and (eq? level 'snow)
           (or (not (task-complete? *game-info* (game-task jungle-eggtop)))
               (task-complete? *game-info* (game-task beach-flutflut))))
      (and (not (target-on-flut?)) (or (eq? level 'sunken) (eq? level 'sunkenb)))))

(defun oracle-level? ((level symbol))
  (case level
    (('village1 'village2 'village3) #t)
    (else #f)))

(defun burn-level? ((level symbol))
  (or (case level
        (('firecanyon 'village1 'lavatube 'village3 'village2 'sunken 'sunkenb) #t)
        (else #f))
      (string= (current-checkpoint-name) "ogre-start")))

(defun mod-rule-roll-priority ((id symbol))
  (if (not (mod-rule-condition-enabled? id))
    0
    (let* ((checkpoint-name (current-checkpoint-name))
           (level-name (the symbol (current-level-name)))
           (on-racer (target-on-racer?))
           (on-flut (target-on-flut?))
           (fuel-left (- (max-fuel-current-level) (collected-fuel-current-level)))
           (money-left (- (max-money-current-level) (collected-money-current-level)))
           (buzzer-left (- 7 (collected-buzzer-current-level)))
           (is-minigame (or (target-fishing?) (target-billy-game?)))
           (is-klaww (and (not (task-closed? (game-task ogre-boss) (task-status need-resolution))) (string= checkpoint-name "ogre-start")))
           (deep-lavatube (or (string= checkpoint-name "lavatube-middle") (string= checkpoint-name "lavatube-after-ribbon")))
           (racer-lavatube (or (and on-racer (string= checkpoint-name "lavatube-start")) deep-lavatube)))
      (if (and (eq? (mod-rule-type id) 'rule)
               (or (>= (-> *MOD-rule-context-bank* twist-marked-slot) 0) (mod-rule-active? 'complication-twisted)))
        0
        (cond
          ;; Resources
          ((eq? id 'complication-critical) (if (or (< fuel-left 1) (eq? level-name 'finalboss)) 0 7))
          ((eq? id 'rule-buzzer-pressure)
           (if (or (< buzzer-left 3)
                   (mod-rule-active? 'rule-distancing)
                   is-minigame
                   is-klaww
                   (eq? level-name 'jungleb)
                   (eq? level-name 'finalboss)
                   (eq? level-name 'sunkenb))
             0
             8))
          ((or (eq? id 'complication-unbreakable) (eq? id 'rule-distancing))
           (if (or (< buzzer-left 1)
                   (mod-rule-active? 'rule-buzzer-pressure)
                   is-klaww
                   (eq? level-name 'training)
                   (eq? level-name 'jungleb)
                   (eq? level-name 'finalboss))
             0
             6))
          ((eq? id 'rule-fuel-pressure)
           (cond
             ((or (< fuel-left 1)
                  is-minigame
                  is-klaww
                  (eq? level-name 'jungleb)
                  (string= checkpoint-name "lavatube-start")
                  racer-lavatube
                  (eq? level-name 'finalboss))
              0)
             ((or (eq? level-name 'village1)
                  (eq? level-name 'village2)
                  (eq? level-name 'village3)
                  (mod-rule-active? 'complication-fuel-shortage))
              3)
             (else 8)))
          ((eq? id 'rule-money-pressure)
           (if (or (< money-left 35) is-minigame is-klaww (eq? level-name 'finalboss) deep-lavatube) 0 6))
          ((eq? id 'complication-hidden-treasure)
           (if (or is-klaww (eq? level-name 'finalboss) (string= checkpoint-name "firecanyon-start") deep-lavatube) 0 6))
          ((eq? id 'rule-loyal-customer)
           (let ((oracles-closed? (cond
                                    ((eq? level-name 'village1)
                                     (and (task-closed? (game-task village1-oracle-money1) (task-status need-resolution))
                                          (task-closed? (game-task village1-oracle-money2) (task-status need-resolution))))
                                    ((eq? level-name 'village2)
                                     (and (task-closed? (game-task village2-oracle-money1) (task-status need-resolution))
                                          (task-closed? (game-task village2-oracle-money2) (task-status need-resolution))))
                                    ((eq? level-name 'village3)
                                     (and (task-closed? (game-task village3-oracle-money1) (task-status need-resolution))
                                          (task-closed? (game-task village3-oracle-money2) (task-status need-resolution))))
                                    (else #f))))
             (if (and (oracle-level? level-name)
                      (not oracles-closed?)
                      (>= (+ (current-orb-count) money-left) 120)
                      (<= (- 120 (current-orb-count)) 35)
                      (not (mod-rule-active? 'complication-fuel-shortage)))
               20
               0)))
          ;; Enemies
          ((or (eq? id 'complication-glare) (eq? id 'rule-lurker-pressure))
           (cond
             ((or (eq? level-name 'finalboss) (sparse-lurker-level? level-name)) 0)
             ((eq? id 'complication-glare) 8)
             ((or (target-fishing?)
                  (mod-rule-active? 'rule-no-harm)
                  (mod-rule-active? 'complication-soul-bond)
                  (eq? level-name 'finalboss))
              0)
             (else 8)))
          ((eq? id 'rule-hitlist) (if (or (sparse-hitlist-level? level-name) (mod-rule-active? 'rule-no-harm) is-minigame) 0 7))
          ((eq? id 'rule-double-kill)
           (if (or (and (not (eq? level-name 'citadel)) (sparse-lurker-level? level-name))
                   is-minigame
                   is-klaww
                   (eq? level-name 'finalboss)
                   (eq? level-name 'sunkenb)
                   (mod-rule-active? 'rule-no-harm))
             0
             7))
          ((eq? id 'rule-no-harm) ;; disabled
           (if (or (sparse-lurker-level? level-name)
                   is-minigame
                   is-klaww
                   (mod-rule-active? 'rule-hitlist)
                   (mod-rule-active? 'rule-lurker-pressure)
                   (mod-rule-active? 'rule-double-kill)
                   (eq? level-name 'jungleb)
                   (eq? level-name 'finalboss))
             0
             7))
          ((eq? id 'complication-soul-bond) ;; disabled
           (if (or (sparse-lurker-level? level-name)
                   is-minigame
                   is-klaww
                   (mod-rule-active? 'rule-lurker-pressure)
                   (mod-rule-active? 'complication-disassociate)
                   (eq? level-name 'jungleb)
                   (eq? level-name 'finalboss))
             0
             7))
          ((eq? id 'rule-sniper)
           (if (and (not (mod-rule-active? 'rule-flop-this))
                    (or (case level-name
                          (('swamp 'beach 'snow 'robocave 'darkcave) #t)
                          (else #f))
                        (and (eq? level-name 'maincave) (not (task-closed? (game-task cave-gnawers) (task-status need-resolution))))))
             7
             0))
          ((eq? id 'rule-flop-this)
           (if (or (case level-name
                     (('training 'lavatube 'village3 'village2 'village1 'rolling 'ogre 'finalboss) #t)
                     (else #f))
                   (target-billy-game?)
                   (mod-rule-active? 'rule-sniper))
             0
             9))
          ((eq? id 'rule-vendetta) (if (or (sparse-lurker-level? level-name) (not (red-eco-level? level-name)) is-minigame) 0 15))
          ((eq? id 'complication-eco-reserve)
           (cond
             ((or (eq? level-name 'finalboss) is-klaww) 15)
             ((yellow-eco-level? level-name) 5)
             (else 0)))
          ((eq? id 'complication-red-stop) ;; disabled
           (if (red-eco-level? level-name) 0 6))
          ((eq? id 'complication-ohko) 6) ;; disabled
          ((eq? id 'complication-invisible-man) (if on-racer 0 6))
          ((eq? id 'complication-double-aphids) ;; disabled
           (if (and (not (task-closed? (game-task jungle-plant) (task-status need-resolution))) (eq? level-name 'jungleb)) 20 0))
          ;; Crates
          ((eq? id 'rule-crate-break)
           (if (or is-klaww is-minigame (string= checkpoint-name "sunkenb-helix") (sparse-crate-level? level-name)) 0 6))
          ((eq? id 'rule-hands-on) (if (or (eq? level-name 'jungleb) (no-blue-eco-level? level-name)) 0 6))
          ;; Movement
          ((eq? id 'complication-jak-rabbit) (if on-racer 0 6))
          ((eq? id 'complication-jak-be-nimble) (if (target-on-racer-or-flut?) 0 6))
          ((eq? id 'complication-invert) 4)
          ((eq? id 'complication-cumbersome) (if (or is-minigame (target-on-racer-or-flut?) (< (current-orb-count) 20)) 0 7))
          ((eq? id 'complication-shifty) (if (or is-klaww is-minigame) 0 5))
          ((or (eq? id 'rule-grounded) (eq? id 'rule-die))
           (cond
             ((or (eq? level-name 'training) (eq? level-name 'finalboss)) 0)
             ((or is-minigame (mod-rule-active? 'rule-survivor)) 0)
             ((and (eq? id 'rule-grounded) (or (mod-rule-active? 'rule-hang-time) (mod-rule-active? 'rule-qte))) 0)
             ((and (eq? id 'rule-grounded) is-klaww) 2)
             ((eq? id 'rule-grounded) 7)
             ((or (eq? level-name 'beach) (eq? level-name 'rolling)) 3)
             (is-klaww 2)
             (else 5)))
          ((eq? id 'rule-red-light)
           (cond
             ((or (mod-rule-active? 'rule-qte) is-minigame) 0)
             ((or (eq? level-name 'finalboss) is-klaww) 1)
             (else 3)))
          ((eq? id 'complication-butter-fingers) ;; disabled
           (cond
             ((or (sole-zoomer-level? level-name) on-racer on-flut) 0)
             ((eq? level-name 'training) 3)
             (else 6)))
          ((or (eq? id 'rule-keep-it-low) (eq? id 'complication-sizeable))
           (if (or on-racer on-flut (sole-zoomer-level? level-name)) 0 7))
          ((eq? id 'rule-management) (if (or on-racer on-flut (sole-zoomer-level? level-name) (mod-rule-active? 'rule-qte)) 0 7))
          ((eq? id 'complication-bad-ping) ;; disabled for zed
           (if (mod-rule-timed-punishment-active? 'punishment-delay) 0 6))
          ((eq? id 'complication-loose-pockets)
           (if (or (< (current-orb-count) 20) (eq? level-name 'finalboss) (eq? level-name 'citadel) (eq? level-name 'lavatube)) 0 7))
          ;; Water
          ((eq? id 'complication-drought)
           (cond
             ((no-drought-level? level-name) 0)
             ((or (eq? level-name 'rolling) (eq? level-name 'training)) 3)
             (else 7)))
          ((eq? id 'rule-landlubber)
           (cond
             ((mod-rule-active? 'complication-drought) 0)
             ((water-level? level-name) 6)
             ((or (eq? level-name 'misty)
                  (and (not (task-closed? (game-task cave-dark-crystals) (task-status need-resolution))) (eq? level-name 'darkcave)))
              6)
             (else 0)))
          ;; Special
          ((eq? id 'rule-hang-time) (if (or is-minigame (mod-rule-active? 'rule-grounded) (not (hang-time-level? level-name))) 0 5))
          ((eq? id 'complication-vibe-check)
           (cond
             (is-minigame 0)
             ((< (-> (the-as fact-info-target (-> *target* fact)) health) 2.0) 4)
             (else 2)))
          ((eq? id 'rule-express-delivery)
           (if (or (and (not (task-closed? (game-task misty-muse) (task-status need-resolution)))
                        (task-closed? (game-task misty-muse) (task-status need-introduction)))
                   (eq? level-name 'misty))
             8
             0))
          ((eq? id 'rule-side-to-side) (if is-klaww 35 0))
          ((eq? id 'complication-mirror) 4)
          ((eq? id 'complication-income-tax) (if (eq? level-name 'finalboss) 0 3))
          ((eq? id 'rule-button-pusher) (if (or (not (button-level? level-name)) is-minigame) 0 10))
          ((eq? id 'rule-cooked) (if (or on-racer racer-lavatube (not (burn-level? level-name))) 0 9))
          ((eq? id 'complication-get-a-grip)
           (if (or (sole-zoomer-level? level-name)
                   (string= checkpoint-name "swamp-cave1")
                   (string= checkpoint-name "citadel-elevator")
                   is-minigame
                   is-klaww
                   (eq? level-name 'finalboss)
                   (eq? level-name 'lavatube)
                   (mod-rule-active? 'complication-joyride)
                   (mod-rule-timed-punishment-active? 'punishment-edge)
                   (target-on-racer-or-flut?))
             0
             4))
          ((eq? id 'rule-green-pilled) (if (or (sparse-green-eco-level? level-name) is-minigame) 0 4))
          ((eq? id 'complication-joyride)
           (if (or (target-on-racer-or-flut?)
                   is-minigame
                   (eq? level-name 'finalboss)
                   (and (mod-rule-active? 'rule-button-pusher) (or (eq? level-name 'sunken) (eq? level-name 'sunkenb)))
                   (string= checkpoint-name "firecanyon-start")
                   (eq? level-name 'lavatube))
             0
             4))
          ((or (eq? id 'complication-fast-reel) (eq? id 'complication-palate-change)) (if (target-fishing?) 50 0))
          ((eq? id 'rule-sagging-sails) (if (and (target-fishing?) (< (-> *MOD-rule-context-bank* fisher-missed-count) 5)) 50 0))
          ((eq? id 'rule-cold-feet) (if (eq? level-name 'snow) 20 0))
          ((eq? id 'rule-touch-grass)
           (if (or (and (eq? level-name 'jungleb) (task-closed? (game-task jungle-plant) (task-status need-resolution)))
                   (and (not (or (target-fishing?) (= (-> *target* control ground-pat material) (pat-material grass))))
                        (grass-level? level-name)))
             9
             0))
          ((eq? id 'rule-math-quiz) (if (or (mod-rule-active? 'rule-trivia) (eq? level-name 'training)) 0 3))
          ((eq? id 'rule-trivia) (if (or (mod-rule-active? 'rule-math-quiz) (eq? level-name 'training)) 0 3))
          ((eq? id 'complication-overclock)
           (if (and (eq? level-name 'citadel) (not (string= checkpoint-name "citadel-elevator"))) 20 0))
          ((eq? id 'rule-one-frame)
           (cond
             (is-minigame 0)
             ((string= checkpoint-name "sunkenb-helix") 6)
             ((eq? level-name 'finalboss) 3)
             ((launcher-level? level-name) 8)
             (else 0)))
          ((eq? id 'rule-for-billy)
           (if (and (not (task-closed? (game-task swamp-billy) (task-status need-resolution)))
                    (> (-> *MOD-countdown-bank* remaining-time) (seconds 240))
                    (or (string= checkpoint-name "swamp-game")
                        (string= checkpoint-name "swamp-cave2")
                        (string= checkpoint-name "swamp-dock2")))
             15
             0))
          ((eq? id 'complication-rgyb)
           (if (or (target-billy-game?)
                   (eq? level-name 'jungleb)
                   (eq? level-name 'training)
                   (eq? level-name 'finalboss)
                   (eq? level-name 'village3)
                   is-klaww
                   (string= checkpoint-name "lavatube-middle"))
             0
             7))
          ((eq? id 'rule-survivor)
           (cond
             ((or (mod-rule-active? 'rule-die) (eq? level-name 'training) (eq? level-name 'village1)) 0)
             ((or (eq? level-name 'village1) (eq? level-name 'village2)) 3)
             (else 6)))
          ((eq? id 'complication-eco-allergy)
           (cond
             ((or (eq? level-name 'finalboss) (eq? level-name 'village3)) 0)
             (is-klaww 2)
             (else 6)))
          ((eq? id 'complication-interference) (if (or (target-fishing?) (eq? level-name 'village3)) 0 6)) ;; disabled
          ((eq? id 'complication-heating-balloons)
           (if (or (string= checkpoint-name "firecanyon-start") (and (eq? level-name 'lavatube) on-racer)) 50 0))
          ((eq? id 'complication-bus-driver) (if (or (string= checkpoint-name "firecanyon-start") on-racer) 15 0))
          ((eq? id 'rule-speed) ;; disabled
           (if (or (string= checkpoint-name "firecanyon-start") on-racer) 25 0))
          ((eq? id 'complication-rotten-eggs) (if (or is-klaww (eq? level-name 'finalboss) deep-lavatube) 0 6))
          ((eq? id 'complication-disassociate)
           (if (and on-flut (not (or (mod-rule-active? 'complication-soul-bond) (sparse-lurker-level? level-name)))) 40 0))
          ((eq? id 'complication-wings-tied) (if (and on-flut (not (eq? level-name 'finalboss))) 20 0))
          ((eq? id 'complication-fuel-shortage)
           (if (or (eq? level-name 'training)
                   (eq? level-name 'finalboss)
                   (mod-rule-active? 'rule-loyal-customer)
                   (string= checkpoint-name "lavatube-middle")
                   (and (string= checkpoint-name "citadel-elevator")
                        (task-closed? (game-task citadel-sage-green) (task-status need-resolution))))
             0
             6))
          ((eq? id 'complication-brittle-bones)
           (cond
             ((or (eq? level-name 'finalboss) is-klaww) 4)
             (is-minigame 0)
             (else 6)))
          ((eq? id 'complication-twisted)
           (if (or (>= (-> *MOD-rule-context-bank* twist-pending-count) 0)
                   (mod-rule-any-rule-active?)
                   (>= (-> *MOD-rule-context-bank* twist-marked-slot) 0))
             0
             4))
          ((eq? id 'rule-qte)
           (if (or (mod-rule-active? 'rule-management) (mod-rule-active? 'rule-grounded) (mod-rule-active? 'rule-red-light)) 0 5))
          (else 6))))))

(defun mod-rule-fallback-candidate? ((candidate symbol))
  (and candidate
       (mod-rule-condition-enabled? candidate)
       (not (mod-rule-active? candidate))
       (not (mod-rule-pending? candidate))
       (not (and (eq? (mod-rule-type candidate) 'rule)
                 (or (>= (-> *MOD-rule-context-bank* twist-marked-slot) 0) (mod-rule-active? 'complication-twisted))))
       (not (and (eq? candidate 'complication-twisted)
                 (or (>= (-> *MOD-rule-context-bank* twist-pending-count) 0)
                     (mod-rule-any-rule-active?)
                     (>= (-> *MOD-rule-context-bank* twist-marked-slot) 0))))))

(defun mod-rule-pick-fallback-id ()
  (let ((idx 0)
        (count 0))
    (while (< idx *mod-rule-id-count*)
      (when (mod-rule-fallback-candidate? (mod-rule-id-from-index idx))
        (+! count 1))
      (+! idx 1))
    (when *debug-segment*
      (format #t "Fallback roll: ~D enabled+eligible candidates~%" count))
    (if (> count 0)
      (let ((pick (mod-rand-int-range 0 count))
            (idx 0)
            (remaining 0)
            (chosen #f))
        (set! remaining pick)
        (while (and (< idx *mod-rule-id-count*) (not chosen))
          (let ((candidate (mod-rule-id-from-index idx)))
            (when (mod-rule-fallback-candidate? candidate)
              (if (= remaining 0) (set! chosen candidate) (-! remaining 1))))
          (+! idx 1))
        (when *debug-segment*
          (format #t "Fallback roll chose: ~S~%" chosen))
        chosen)
      (begin
        (when *debug-segment*
          (format #t "Fallback roll: no enabled candidates, returning #f~%"))
        #f))))

(defun mod-rule-pick-weighted-id ()
  (let ((idx 0)
        (total 0))
    ;; Calculate total weight (weighted by recency)
    (while (< idx *mod-rule-id-count*)
      (let ((candidate (mod-rule-id-from-index idx)))
        (when (and candidate (not (mod-rule-active? candidate)) (not (mod-rule-pending? candidate)))
          (let ((priority (mod-rule-roll-priority candidate))
                (recent-factor (mod-rule-recent-roll-factor candidate))
                (weight 0))
            (set! weight (if (> priority 0) (* priority recent-factor) 0))
            (+! total weight))))
      (+! idx 1))
    ;; Fallback: only one condition is eligible and it's the one that was just rolled, 
    ;; ignore recency so something is rolled.
    (let ((use-fallback (= total 0)))
      (when use-fallback
        (set! idx 0)
        (while (< idx *mod-rule-id-count*)
          (let ((candidate (mod-rule-id-from-index idx)))
            (when (and candidate (not (mod-rule-active? candidate)) (not (mod-rule-pending? candidate)))
              (let ((priority (mod-rule-roll-priority candidate))) (+! total priority))))
          (+! idx 1))
        (when (and *debug-segment* (> total 0))
          (format #t "Weighted Roll Debug: only recently-rolled candidates eligible, ignoring recency~%")))
      ;; Debug Print
      (when (and *debug-segment* (> total 0))
        (format #t "--- Weighted Roll Debug (Total: ~D) ---~%" total)
        (let ((debug-idx 0))
          (while (< debug-idx *mod-rule-id-count*)
            (let ((candidate (mod-rule-id-from-index debug-idx)))
              (when (and candidate (not (mod-rule-active? candidate)) (not (mod-rule-pending? candidate)))
                (let* ((priority (mod-rule-roll-priority candidate))
                       (recent-factor (if use-fallback 1 (mod-rule-recent-roll-factor candidate)))
                       (weight (if (> priority 0) (* priority recent-factor) 0)))
                  (let ((percent (* 100.0 (/ (the float weight) (the float total)))))
                    (format #t "  ~S: Weight=~D (Prio: ~D, Rec: ~D) | ~2,1f%~%" candidate weight priority recent-factor percent)))))
            (+! debug-idx 1))))
      ;; Selection
      (if (> total 0)
        (let ((roll (mod-rand-int-range 0 total))
              (idx 0)
              (chosen #f))
          (while (and (< idx *mod-rule-id-count*) (not chosen))
            (let ((candidate (mod-rule-id-from-index idx)))
              (when (and candidate (not (mod-rule-active? candidate)) (not (mod-rule-pending? candidate)))
                (let ((priority (mod-rule-roll-priority candidate))
                      (recent-factor (if use-fallback 1 (mod-rule-recent-roll-factor candidate)))
                      (weight 0))
                  (set! weight (if (> priority 0) (* priority recent-factor) 0))
                  (when (> weight 0)
                    (if (< roll weight) (set! chosen candidate) (set! roll (- roll weight)))))))
            (+! idx 1))
          (when *debug-segment*
            (format #t "Weighted roll chose ~S~%" chosen))
          chosen)
        (mod-rule-pick-fallback-id)))))

(defun mod-rule-reroll-slot ((slot int) (apply-buffer symbol))
  (mod-rule-deactivate-slot slot)
  (mod-rule-schedule-slot slot 'mod-rule-pending-roll apply-buffer)
  (none))

(defun mod-rule-finish-slot ((slot int) (apply-buffer symbol))
  (if (> (mod-rule-active-slot-count) 1) (mod-rule-deactivate-slot slot) (mod-rule-reroll-slot slot apply-buffer))
  (none))

(defun mod-rule-counter-add-progress ((id symbol) (amount int))
  (when (> amount 0)
    (let ((slot 0))
      (while (< slot *mod-rule-slot-count*)
        (when (= (-> (-> *MOD-rule-slot-bank* active-slots) slot) id)
          (let ((goal (-> (-> *MOD-rule-slot-bank* slot-goals) slot))
                (new-progress 0))
            (if (> goal 0)
              (begin
                (set! new-progress (min goal (+ (-> (-> *MOD-rule-slot-bank* slot-progress) slot) amount)))
                (set! (-> (-> *MOD-rule-slot-bank* slot-progress) slot) new-progress)
                (when (>= new-progress goal)
                  (mod-rule-resolve! slot 'success #f)))
              (set! (-> (-> *MOD-rule-slot-bank* slot-progress) slot) (+ (-> (-> *MOD-rule-slot-bank* slot-progress) slot) amount)))))
        (+! slot 1))))
  (none))

(defun mod-rule-on-orb-pickup ((amount int))
  (mod-rule-counter-add-progress 'rule-money-pressure amount)
  (none))

(defun mod-rule-set-current ((id symbol))
  (mod-rule-activate-slot (-> *MOD-rule-context-bank* current-slot) id)
  (none))

(defun mod-rule-reroll-current ((apply-buffer symbol))
  (let ((slot (mod-rule-first-occupied-slot)))
    (mod-rule-reroll-slot (if (>= slot 0) slot (-> *MOD-rule-context-bank* current-slot)) apply-buffer))
  (none))

(defun mod-rule-refresh-active-rule-punishments ()
  (when (mod-rule-can-revert-collected-cell?)
    (dotimes (slot *mod-rule-slot-count*)
      (let ((id (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
        (when (and id (eq? (mod-rule-type id) 'rule))
          (set! (-> (-> *MOD-rule-slot-bank* slot-punishments) slot) (mod-rule-random-available-punishment id))))))
  (none))

(defun mod-rule-on-cell-pickup ((amount int))
  (mod-rule-counter-add-progress 'rule-fuel-pressure amount)
  (none))

(defun mod-rule-on-buzzer-pickup ((amount int))
  (mod-rule-counter-add-progress 'rule-buzzer-pressure amount)
  (none))

(defun mod-rule-record-player-hit ((enemy process) (attack-mode symbol))
  (when (and enemy attack-mode)
    (let ((idx (-> *MOD-rule-hit-bank* player-hit-write-idx)))
      (set! (-> (-> *MOD-rule-hit-bank* player-hit-handles) idx) (process->handle enemy))
      (set! (-> (-> *MOD-rule-hit-bank* player-hit-modes) idx) attack-mode)
      (set! (-> *MOD-rule-hit-bank* player-hit-write-idx) (mod (+ idx 1) 64))))
  (none))

(defun mod-rule-last-player-hit-mode ((enemy process-drawable))
  (let ((enemy-handle (process->handle (the-as process enemy))))
    ;; (format #t "[DEBUG] Looking up handle ~A for enemy ~A~%" enemy-handle (-> enemy type))
    (when enemy-handle
      (let ((count 0)
            (idx (mod (+ (-> *MOD-rule-hit-bank* player-hit-write-idx) 63) 64)))
        (while (< count 64)
          (when (= (-> (-> *MOD-rule-hit-bank* player-hit-handles) idx) enemy-handle)
            (let ((mode (-> (-> *MOD-rule-hit-bank* player-hit-modes) idx)))
              ;; (format #t "[DEBUG] Found hit-mode: ~A~%" mode)
              (return mode)))
          (set! idx (if (= idx 0) 63 (- idx 1)))
          (+! count 1)))))
  ;; (format #t "[DEBUG] Hit-mode not found, returning #f~%")
  #f)

(defun mod-rule-enemy-killed-by-flop? ((enemy process-drawable))
  (when *target*
    (let ((player-state (-> *target* state name)))
      (if (or (= player-state 'target-flop)
              (= player-state 'target-flop-hit-ground)
              ;; could not find a reliable way to detect flop so just excluding the situations where flut kills with dash, stomp, or eco
              (and (target-on-flut?)
                   (not (or (= player-state 'target-flut-running-attack)
                            (= player-state 'target-flut-double-jump)
                            (= player-state 'target-flut-falling)))))
        #t
        #f))))

(defun mod-rule-enemy-killed-by-red-eco? ((enemy process-drawable))
  (eq? (mod-rule-last-player-hit-mode enemy) 'eco-red))

(defun mod-rule-unique-enemy-type-seen? ((type-name symbol))
  (let ((slot 0)
        (seen #f))
    (while (and (< slot 3) (not seen))
      (when (= (-> *mod-rule-unique-enemy-killed-types* slot) type-name)
        (set! seen #t))
      (+! slot 1))
    seen))

(defun mod-rule-record-unique-enemy-type ((type-name symbol))
  (let ((slot 0)
        (recorded #f))
    (when (not (mod-rule-unique-enemy-type-seen? type-name))
      (while (and (< slot 3) (not recorded))
        (when (not (-> *mod-rule-unique-enemy-killed-types* slot))
          (set! (-> *mod-rule-unique-enemy-killed-types* slot) type-name)
          (set! recorded #t))
        (+! slot 1)))
    recorded))

(defun mod-rule-on-crate-break ((amount int))
  (mod-rule-counter-add-progress 'rule-crate-break amount)
  (none))

(defun mod-rule-punishment-name ((punishment symbol))
  (cond
    ((eq? punishment 'punishment-money) "LOSE 60 ORBS")
    ((eq? punishment 'punishment-warp) "WARP TO GEYSER")
    ((eq? punishment 'punishment-countdown) (string-format "LOSE ~D SECONDS" (mod-rule-countdown-punishment-seconds)))
    ((eq? punishment 'punishment-revert-cell) "REVERT A RANDOM CELL")
    ((eq? punishment 'punishment-extra-rule) "EXTRA CONDITION")
    ((eq? punishment 'punishment-blind) "BLIND FOR 10 SECONDS")
    ((eq? punishment 'punishment-fall-damage) "MORE FALL DAMAGE FOR 2 MINUTES")
    ((eq? punishment 'punishment-trip) "TRIP RANDOMLY FOR 2 MINUTES")
    ((eq? punishment 'punishment-edge) "NO LEDGE GRABS FOR 4 MINUTES")
    ((eq? punishment 'punishment-delay) "200MS INPUT DELAY FOR 1 MINUTE")
    ((eq? punishment 'punishment-crash) "CRASH THE GAME")
    ((eq? punishment 'punishment-iframes) "NO I-FRAMES FOR 3 MINUTES")
    ((eq? punishment 'punishment-camera) "INVERTED CAMERA FOR 2 MINUTES")
    ((eq? punishment 'punishment-ohko) "ANY DAMAGE OR BONK KILLS FOR 2 MINUTES")
    ((eq? punishment 'punishment-reset) "RESET THE RUN")
    (else "NONE")))

(defun mod-rule-timed-punishment-name ((punishment symbol))
  (cond
    ((eq? punishment 'punishment-fall-damage) "FALL DAMAGE")
    ((eq? punishment 'punishment-trip) "TRIP")
    ((eq? punishment 'punishment-edge) "LEDGE GRAB")
    ((eq? punishment 'punishment-delay) "INPUT DELAY")
    ((eq? punishment 'punishment-iframes) "I-FRAMES")
    ((eq? punishment 'punishment-camera) "CAMERA")
    ((eq? punishment 'punishment-ohko) "OHKO")
    (else (mod-rule-punishment-name punishment))))

(defun mod-rule-apply-extra-rule-punishment ((failed-slot int))
  (when (and (>= failed-slot 0) (< failed-slot *mod-rule-slot-count*) (< (mod-rule-active-slot-count) 2))
    (mod-rule-reroll-slot failed-slot #t)
    (let ((extra-slot (mod-rule-first-free-slot))) (when (>= extra-slot 0) (mod-rule-reroll-slot extra-slot #t))))
  (none))

(defun mod-rule-reset-run-and-restart ()
  (set! (-> *MOD-countdown-bank* remaining-time) 0)
  (set! (-> *MOD-countdown-bank* lost?) #t)
  (set! (-> *MOD-countdown-bank* active?) #f)
  (kill-by-name 'mod-rule-manager *active-pool*)
  (mod-rules-reset)
  (when *target*
    (logclear! (-> *target* mask) (process-mask sleep)))
  (set! (-> *MOD-rule-context-bank* mean-look-clear-time) 0)
  (process-spawn-function process
    (lambda ()
      (suspend)
      (start-speedrun (the-as speedrun-category #f))))
  (none))

(defun mod-rule-apply-punishment ((punishment symbol))
  (cond
    ((eq? punishment 'punishment-money) (set! (-> *game-info* money) (max 0.0 (- (current-orb-count) 60.0))))
    ((eq? punishment 'punishment-crash)
     (play-custom-sfx "Goodbye.mp3" 40.0)
     (process-spawn-function process
       (lambda ()
         (let ((start-time (current-time))) (until (>= (- (current-time) start-time) (seconds 1)) (suspend)))
         (/ 1 0))))
    ((eq? punishment 'punishment-warp)
     (process-spawn-function process
       (lambda ()
         (let ((start-time (current-time))) (until (>= (- (current-time) start-time) (seconds 1)) (suspend)))
         (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "training-warp"))
         (when (progress-allowed?)
           (auto-save-command 'auto-save 0 0 *default-pool*))
         (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))))
    ((eq? punishment 'punishment-countdown)
     (when (-> *MOD-countdown-bank* active?)
       (set! (-> *MOD-countdown-bank* remaining-time)
             (- (-> *MOD-countdown-bank* remaining-time) (mod-rule-countdown-punishment-ticks)))))
    ((eq? punishment 'punishment-revert-cell) (mod-rule-revert-random-collected-cell))
    ((eq? punishment 'punishment-blind) (set-blackout-frames (seconds 10)) (mod-rule-start-timed-punishment punishment))
    ((eq? punishment 'punishment-fall-damage)
     (set! (-> *TARGET-bank* fall-far) (meters 7.0))
     (set! (-> *TARGET-bank* fall-far-inc) (meters 10.0))
     (mod-rule-start-timed-punishment punishment))
    ((eq? punishment 'punishment-trip) (none) (mod-rule-start-timed-punishment punishment))
    ((eq? punishment 'punishment-edge) (none) (mod-rule-start-timed-punishment punishment))
    ((eq? punishment 'punishment-camera) (none) (mod-rule-start-timed-punishment punishment))
    ((eq? punishment 'punishment-ohko) (none) (mod-rule-start-timed-punishment punishment))
    ((eq? punishment 'punishment-reset)
     (process-spawn-function process
       (lambda ()
         (let ((start-time (current-time))) (until (>= (- (current-time) start-time) (seconds 1)) (suspend)))
         (mod-rule-reset-run-and-restart))))
    ((eq? punishment 'punishment-delay) (input-delay-enable! #t 0.2) (mod-rule-start-timed-punishment punishment))
    ((eq? punishment 'punishment-iframes)
     (set! (-> *TARGET-bank* hit-invulnerable-timeout) (seconds 0))
     (mod-rule-start-timed-punishment punishment))
    (else (none)))
  (none))

(defun mod-rule-slot-in-grace-period? ((slot int))
  (and (>= slot 0)
       (< slot *mod-rule-slot-count*)
       (< (current-time) (-> (-> *MOD-rule-slot-bank* slot-grace-periods) slot))))

(defun mod-rule-resolve! ((slot int) (natural-outcome symbol) (ignore-grace? symbol))
  (when (and (>= slot 0) (< slot *mod-rule-slot-count*))
    (let* ((twisted? (mod-rule-twist-marked-slot? slot))
           (effective (if twisted? (if (eq? natural-outcome 'success) 'failed 'success) natural-outcome)))
      (cond
        ((eq? effective 'success)
         (when twisted?
           (set! (-> *MOD-rule-context-bank* twist-marked-slot) -1))
         (sound-play "buzzer-pickup")
         (set! (-> *MOD-rule-context-bank* last-outcome) (if twisted? 'twisted-success 'success))
         (+! (-> *MOD-stats-bank* rules-followed) 1)
         (auto-save-command 'auto-save 0 0 *default-pool*)
         (mod-rule-finish-slot slot #t))
        ((or ignore-grace? (not (mod-rule-slot-in-grace-period? slot)))
         (when twisted?
           (set! (-> *MOD-rule-context-bank* twist-marked-slot) -1))
         (sound-play "caught-eel")
         (+! (-> *MOD-stats-bank* rules-broken) 1)
         (auto-save-command 'auto-save 0 0 *default-pool*)
         (set! (-> *MOD-rule-context-bank* last-outcome) (if twisted? 'twisted-failed 'failed))
         (let ((punishment (or (-> (-> *MOD-rule-slot-bank* slot-punishments) slot)
                               (mod-rule-random-available-punishment (-> (-> *MOD-rule-slot-bank* active-slots) slot)))))
           (if (eq? punishment 'punishment-extra-rule)
             (mod-rule-apply-extra-rule-punishment slot)
             (begin
               (mod-rule-apply-punishment punishment)
               (mod-rule-finish-slot slot #t))))))))
  (none))

(defun mod-rule-clear-other-active-rules! ((exclude-slot int))
  (let ((slot 0))
    (while (< slot *mod-rule-slot-count*)
      (when (!= slot exclude-slot)
        (let ((id (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
          (when (and id (eq? (mod-rule-type id) 'rule))
            (mod-rule-deactivate-slot slot)
            (let ((chosen (mod-rule-pick-weighted-id)))
              (if chosen
                (begin
                  (mod-rule-activate-slot slot chosen)
                  (mod-rule-record-roll! chosen))
                (mod-rule-schedule-slot slot 'mod-rule-pending-roll #t))))))
      (+! slot 1)))
  (none))

(defun mod-rule-twist-check-and-mark! ((slot int) (id symbol))
  (when (and (>= (-> *MOD-rule-context-bank* twist-pending-count) 0)
             (= (-> *MOD-stats-bank* rules-rolled) (-> *MOD-rule-context-bank* twist-pending-count)))
    (set! (-> *MOD-rule-context-bank* twist-marked-slot) slot)
    (set! (-> *MOD-rule-context-bank* twist-pending-count) -1)
    (mod-rule-clear-other-active-rules! slot))
  (none))

(defun mod-rule-twist-marked-slot? ((slot int))
  (and (>= (-> *MOD-rule-context-bank* twist-marked-slot) 0) (= (-> *MOD-rule-context-bank* twist-marked-slot) slot)))

;; (defun mod-rule-handle-slot-failure ((slot int) (punishment symbol))
;;   (mod-rule-resolve! slot 'failed #f)
;;   (none))

(defun mod-rule-handle-slot-expiry ((slot int))
  (when (and (>= slot 0) (< slot *mod-rule-slot-count*))
    (let ((id (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
      (when id
        (let ((goal (-> (-> *MOD-rule-slot-bank* slot-goals) slot))
              (progress (-> (-> *MOD-rule-slot-bank* slot-progress) slot))
              (punishment (-> (-> *MOD-rule-slot-bank* slot-punishments) slot)))
          (when (and (> goal 0) (< progress goal) punishment)
            (unless (eq? id 'rule-math-quiz)
              (mod-rule-resolve! slot 'failed #t)))
          (if (not (movie?)) (sound-play "cursor-options"))
          (when (and (= id (-> (-> *MOD-rule-slot-bank* active-slots) slot)) (or (<= goal 0) (>= progress goal) (not punishment)))
            (mod-rule-resolve! slot 'success #t))))))
  (none))

(defun mod-rule-punishment-for-id ((id symbol))
  (let ((slot 0)
        (found #f)
        (result #f))
    (while (and (< slot *mod-rule-slot-count*) (not found))
      (when (= (-> (-> *MOD-rule-slot-bank* active-slots) slot) id)
        (set! result (-> (-> *MOD-rule-slot-bank* slot-punishments) slot))
        (set! found #t))
      (+! slot 1))
    result))

(defun mod-rule-update-math-quiz ()
  (when (mod-rule-active? 'rule-math-quiz)
    (let ((slot (mod-rule-find-active-slot 'rule-math-quiz)))
      (when (>= slot 0)
        (let ((time-left (- (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (current-time))))
          (when (<= time-left 0)
            (mod-rule-resolve! slot
                               (if (= (-> *MOD-quiz-bank* math-current-guess) (-> *MOD-quiz-bank* math-answer)) 'success 'failed)
                               #t)
            (none))
          (when (cpad-pressed? 0 up)
            (+! (-> *MOD-quiz-bank* math-current-guess) 1)
            (sound-play "cursor-up-down"))
          (when (cpad-pressed? 0 down)
            (-! (-> *MOD-quiz-bank* math-current-guess) 1)
            (sound-play "cursor-up-down"))
          (when (cpad-pressed? 0 right)
            (+! (-> *MOD-quiz-bank* math-current-guess) 5)
            (sound-play "cursor-up-down"))
          (when (cpad-pressed? 0 left)
            (-! (-> *MOD-quiz-bank* math-current-guess) 5)
            (sound-play "cursor-up-down"))
          (when (or (and (cpad-hold? 0 l2) (cpad-pressed? 0 r2)) (and (cpad-hold? 0 r2) (cpad-pressed? 0 l2)))
            (mod-rule-resolve! slot
                               (if (= (-> *MOD-quiz-bank* math-current-guess) (-> *MOD-quiz-bank* math-answer)) 'success 'failed)
                               #t)
            (none))))))
  (none))

(defun mod-rule-reroll-id ((id symbol))
  (let ((slot 0)
        (found #f))
    (while (and (< slot *mod-rule-slot-count*) (not found))
      (when (= (-> (-> *MOD-rule-slot-bank* active-slots) slot) id)
        (mod-rule-reroll-slot slot #t)
        (set! found #t))
      (+! slot 1)))
  (none))

(defun mod-rule-trigger-failure ((id symbol))
  (when (mod-rule-active? id)
    (let ((punishment (mod-rule-punishment-for-id id)))
      (when punishment
        (let ((slot (mod-rule-find-active-slot id))) (when (>= slot 0) (mod-rule-resolve! slot 'failed (eq? id 'rule-survivor)))))))
  (none))

(defun mod-rule-trigger-brittle-bones ()
  (when (mod-rule-active? 'complication-brittle-bones)
    (let ((roll (mod-rand-punish-int-range 0 100)))
      ;; (format #t "Brittle Bones roll: ~D~%" roll)
      (when (and *target* (< roll 10))
        (send-event *target* 'attack #t (new 'static 'attack-info)))))
  (none))

(defun mod-rule-on-jump ()
  (mod-rule-trigger-brittle-bones)
  (mod-rule-trigger-failure 'rule-grounded)
  (none))

