(define *mod-trivia-questions-used* (new 'global 'boxed-array symbol (length *mod-trivia-questions*)))

(defun mod-trivia-clear-used ()
  (let ((i 0)) (while (< i (length *mod-trivia-questions*)) (set! (-> *mod-trivia-questions-used* i) #f) (+! i 1)))
  (none))

(defun mod-trivia-question-valid? ((idx int))
  (cond
    ;; ((= idx 9999) (> (-> *game-info* total-deaths) 0))
    ((= idx 40) (> (-> *MOD-stats-bank* rules-broken) 0))
    ((= idx 47) (> (-> *game-info* money-total) 150.0))
    (else #t)))

(defun mod-trivia-pick-question ()
  (let ((count (length *mod-trivia-questions*))
        (all-used? #t)
        (i 0))
    (while (< i count)
      (when (and (not (-> *mod-trivia-questions-used* i)) (mod-trivia-question-valid? i))
        (set! all-used? #f))
      (+! i 1))
    (when all-used?
      (mod-trivia-clear-used))
    (let ((idx (mod-rand-int-range 0 count)))
      (while (or (-> *mod-trivia-questions-used* idx) (not (mod-trivia-question-valid? idx)))
        (set! idx (mod-rand-int-range 0 count)))
      (set! (-> *mod-trivia-questions-used* idx) #t)
      idx)))

(defun mod-trivia-hiding-money-total? ()
  (and (mod-rule-active? 'rule-trivia) (= (-> *MOD-quiz-bank* trivia-current-question) 47)))

(defun mod-orb-weight-multiplier ()
  (let ((orbs (max 0.0 (min 150.0 (current-orb-count))))) (- 1.0 (* 0.4 (/ orbs 100.0)))))

(defun mod-refresh-movement-speeds! ((turbo? symbol) (mult float))
  (let* ((walk-base (if turbo? 77777.0 (-> *MOD-orb-weight-bank* base-walk-speed)))
         (double-jump-base (if turbo? 77777.0 (-> *MOD-orb-weight-bank* base-double-jump-speed)))
         (jump-base (if turbo? 77777.0 (-> *MOD-orb-weight-bank* base-jump-speed)))
         (attack-base (if turbo? 77777.0 (-> *MOD-orb-weight-bank* base-attack-speed)))
         (smack-jump-base (if turbo? 77777.0 (-> *MOD-orb-weight-bank* base-smack-jump-speed)))
         (forward-high-jump-base (if turbo? 77777.0 (-> *MOD-orb-weight-bank* base-forward-high-jump-speed)))
         (jump-attack-base (if turbo? 77777.0 (-> *MOD-orb-weight-bank* base-jump-attack-speed)))
         (flip-jump-base (if turbo? 77777.0 (-> *MOD-orb-weight-bank* base-flip-jump-speed))))
    (set! (-> *walk-mods* target-speed) (* walk-base mult))
    (set! (-> *double-jump-mods* target-speed) (* double-jump-base mult))
    (set! (-> *jump-mods* target-speed) (* jump-base mult))
    (set! (-> *attack-mods* target-speed) (* attack-base mult))
    (set! (-> *smack-jump-mods* target-speed) (* smack-jump-base mult))
    (set! (-> *forward-high-jump-mods* target-speed) (* forward-high-jump-base mult))
    (set! (-> *jump-attack-mods* target-speed) (* jump-attack-base mult))
    (set! (-> *TARGET-bank* wheel-flip-dist) (* (-> *MOD-orb-weight-bank* base-wheel-flip-dist) mult))
    (set! (-> *TARGET-bank* wheel-flip-height) (* (-> *MOD-orb-weight-bank* base-wheel-flip-height) mult))
    (set! (-> *flip-jump-mods* target-speed) (* flip-jump-base mult)))
  (none))

(defun mod-rule-apply-low-res! ()
  (pc-set-game-resolution (max 60 (/ (-> *pc-settings* framebuffer-scissor-width) 10))
                          (max 45 (/ (-> *pc-settings* framebuffer-scissor-height) 10)))
  (none))

(defun mod-rule-low-res-should-apply? ()
  (and (mod-rule-active? 'complication-interference) *target* (>= (-> *target* fact eco-level) 1.0)))

(defun mod-orb-weight-apply! ()
  (let ((orbs (current-orb-count)))
    (when (!= orbs (-> *MOD-orb-weight-bank* last-applied-orbs))
      (mod-refresh-movement-speeds! (mod-rule-active? 'complication-jak-be-nimble) (mod-orb-weight-multiplier))
      (set! (-> *MOD-orb-weight-bank* last-applied-orbs) orbs)))
  (none))

(defun mod-orb-weight-reset! ()
  (mod-refresh-movement-speeds! (mod-rule-active? 'complication-jak-be-nimble) 1.0)
  (set! (-> *MOD-orb-weight-bank* last-applied-orbs) -1.0)
  (none))

(defun mod-refresh-money-actors ((wake? symbol))
  (iterate-process-tree *active-pool*
                        (lambda ((p process))
                          (when (type-type? (-> p type) money)
                            (logclear! (-> (the-as money p) draw status) (draw-status hidden))
                            (restore-collide-with-as (-> (the-as money p) root)))
                          #t)
                        *null-kernel-context*)
  (when wake?
    (iterate-process-tree *active-pool*
                          (lambda ((p process))
                            (when (type-type? (-> p type) money)
                              (logclear! (-> p mask) (process-mask actor-pause)))
                            #t)
                          *null-kernel-context*))
  (none))

