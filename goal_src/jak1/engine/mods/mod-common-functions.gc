             0))
          ((eq? id 'complication-rotten-eggs) (if (or is-klaww (eq? level-name 'finalboss) deep-lavatube) 0 39))
          ((eq? id 'complication-disassociate) (if (and on-flut (not (sparse-lurker-level? level-name))) 774 0))
          ((eq? id 'complication-wings-tied) (if (and on-flut (not (eq? level-name 'finalboss))) 366 0))
          ((eq? id 'complication-fuel-shortage)
           (if (or (eq? level-name 'training)
                   (eq? level-name 'finalboss)
                   (eq? level-name 'lavatube)
                   is-minigame
                   (and (string= checkpoint-name "citadel-elevator")
                        (task-closed? (game-task citadel-sage-green) (task-status need-resolution))))
             0
             43))
          ((eq? id 'complication-brittle-bones)
           (cond
             ((or (eq? level-name 'finalboss) is-klaww) 34)
             (is-minigame 0)
             (else 42)))
          ((eq? id 'complication-twisted) 40)
          ((eq? id 'rule-qte) 35)
          ((eq? id 'complication-lights-out)
           (case level-name
             (('maincave 'robocave) 321)
             (else 0)))
          (else 35))))))

(defun mod-rule-fallback-candidate? ((candidate symbol))
  (and candidate
       (mod-condition-enabled? candidate)
       (not (mod-rule-active? candidate))
       (not (mod-rule-pending? candidate))
       (not (mod-rule-conflicts-with-active? candidate))
       (not (mod-rule-twist-blocks? candidate))))

(defun mod-rule-pick-fallback-id ()
  (let ((idx 0)
        (count 0))
    (while (< idx *mod-rule-id-count*)
      (when (mod-rule-fallback-candidate? (mod-rule-id-from-index idx))
        (+! count 1))
      (+! idx 1))
    (when *debug-segment*
      (format #t "Fallback roll: ~D enabled+eligible candidates~%" count))
    (if (> count 0)
      (let ((pick (mod-rand-int-range 0 count))
            (idx 0)
            (remaining 0)
            (chosen #f))
        (set! remaining pick)
        (while (and (< idx *mod-rule-id-count*) (not chosen))
          (let ((candidate (mod-rule-id-from-index idx)))
            (when (mod-rule-fallback-candidate? candidate)
              (if (= remaining 0) (set! chosen candidate) (-! remaining 1))))
          (+! idx 1))
        (when *debug-segment*
          (format #t "Fallback roll chose: ~S~%" chosen))
        chosen)
      (begin
        (when *debug-segment*
          (format #t "Fallback roll: no enabled candidates, returning #f~%"))
        #f))))

;; priority per rule index, filled once per roll
(define *mod-rule-weight-scratch* (new 'global 'boxed-array int32 *mod-rule-id-count*))

(defun mod-rule-candidate-weight ((idx int) (ignore-recency? symbol))
  (let ((priority (-> *mod-rule-weight-scratch* idx)))
    (if (or (<= priority 0) ignore-recency?) priority (* priority (mod-rule-recent-roll-factor (mod-rule-id-from-index idx))))))

(defun mod-rule-pick-weighted-id ()
  (let ((idx 0)
        (total 0)
        (use-fallback #f)
        (chosen #f))
    (while (< idx *mod-rule-id-count*)
      (let ((candidate (mod-rule-id-from-index idx))
            (priority 0))
        (when (and candidate (not (mod-rule-active? candidate)) (not (mod-rule-pending? candidate)))
          (set! priority (max 0 (mod-rule-roll-priority candidate))))
        (set! (-> *mod-rule-weight-scratch* idx) priority))
      (+! idx 1))
    ;; total weight (weighted by recency)
    (set! idx 0)
    (while (< idx *mod-rule-id-count*)
      (+! total (mod-rule-candidate-weight idx #f))
      (+! idx 1))
    ;; fallback: only candidates that were rolled recently are eligible, so ignore recency so something is rolled.
    (when (= total 0)
      (set! use-fallback #t)
      (set! idx 0)
      (while (< idx *mod-rule-id-count*)
        (+! total (mod-rule-candidate-weight idx #t))
        (+! idx 1))
      (when (and *debug-segment* (> total 0))
        (format #t "Weighted Roll Debug: only recently-rolled candidates eligible, ignoring recency~%")))
    (when (and *debug-segment* (> total 0))
      (format #t "--- Weighted Roll Debug (Total: ~D) ---~%" total)
      (let ((debug-idx 0))
        (while (< debug-idx *mod-rule-id-count*)
          (let ((candidate (mod-rule-id-from-index debug-idx)))
            (when (and candidate (not (mod-rule-active? candidate)) (not (mod-rule-pending? candidate)))
              (let* ((weight (mod-rule-candidate-weight debug-idx use-fallback))
                     (percent (* 100.0 (/ (the float weight) (the float total)))))
                (format #t
                        "  ~S: Weight=~D (Prio: ~D, Rec: ~D) | ~2,1f%~%"
                        candidate
                        weight
                        (-> *mod-rule-weight-scratch* debug-idx)
                        (if use-fallback 1 (mod-rule-recent-roll-factor candidate))
                        percent))))
          (+! debug-idx 1))))
    (if (> total 0)
      (let ((roll (mod-rand-int-range 0 total)))
        (set! idx 0)
        (while (and (< idx *mod-rule-id-count*) (not chosen))
          (let ((weight (mod-rule-candidate-weight idx use-fallback)))
            (when (> weight 0)
              (if (< roll weight) (set! chosen (mod-rule-id-from-index idx)) (set! roll (- roll weight)))))
          (+! idx 1))
        (when *debug-segment*
          (format #t "Weighted roll chose ~S~%" chosen))
        chosen)
      (mod-rule-pick-fallback-id))))

(defun mod-rule-reroll-slot ((slot int) (apply-buffer symbol))
  (mod-rule-deactivate-slot slot)
  (mod-rule-schedule-slot slot 'mod-rule-pending-roll apply-buffer)
  (none))

(defun mod-rule-finish-slot ((slot int) (apply-buffer symbol))
  (if (> (mod-rule-active-slot-count) 1) (mod-rule-deactivate-slot slot) (mod-rule-reroll-slot slot apply-buffer))
  (none))

(defun mod-rule-counter-add-progress ((id symbol) (amount int))
  (when (> amount 0)
    (let ((slot 0))
      (while (< slot *mod-rule-slot-count*)
        (when (= (-> (-> *MOD-rule-slot-bank* active-slots) slot) id)
          (let ((goal (-> (-> *MOD-rule-slot-bank* slot-goals) slot))
                (new-progress 0))
            (if (> goal 0)
              (begin
                (set! new-progress (min goal (+ (-> (-> *MOD-rule-slot-bank* slot-progress) slot) amount)))
                (set! (-> (-> *MOD-rule-slot-bank* slot-progress) slot) new-progress)
                (when (>= new-progress goal)
                  (mod-rule-resolve! slot 'success #f)))
              (set! (-> (-> *MOD-rule-slot-bank* slot-progress) slot) (+ (-> (-> *MOD-rule-slot-bank* slot-progress) slot) amount)))))
        (+! slot 1))))
  (none))

(defun mod-on-orb-pickup ((amount int))
  (mod-rule-counter-add-progress 'rule-money-pressure amount)
  (none))

(defun mod-rule-set-current ((id symbol))
  (mod-rule-activate-slot (-> *MOD-rule-context-bank* current-slot) id)
  (none))

(defun mod-rule-reroll-current ((apply-buffer symbol))
  (let ((slot (mod-rule-first-occupied-slot)))
    (mod-rule-reroll-slot (if (>= slot 0) slot (-> *MOD-rule-context-bank* current-slot)) apply-buffer))
  (none))

(defun mod-refresh-active-rule-punishments ()
  (when (mod-can-revert-collected-cell?)
    (dotimes (slot *mod-rule-slot-count*)
      (let ((id (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
        (when (and id (eq? (mod-rule-type id) 'rule))
          (set! (-> (-> *MOD-rule-slot-bank* slot-punishments) slot) (mod-random-available-punishment id))))))
  (none))

(defun mod-on-cell-pickup ((amount int))
  (mod-rule-counter-add-progress 'rule-fuel-pressure amount)
  (none))

(defun mod-on-buzzer-pickup ((amount int))
  (mod-rule-counter-add-progress 'rule-buzzer-pressure amount)
  (none))

(defun mod-record-player-hit ((enemy process) (attack-mode symbol))
  (when (and enemy attack-mode)
    (let ((idx (-> *MOD-hit-bank* player-hit-write-idx)))
      (set! (-> (-> *MOD-hit-bank* player-hit-handles) idx) (process->handle enemy))
      (set! (-> (-> *MOD-hit-bank* player-hit-modes) idx) attack-mode)
      (set! (-> *MOD-hit-bank* player-hit-write-idx) (mod (+ idx 1) 64))))
  (none))

(defun mod-last-player-hit-mode ((enemy process-drawable))
  (let ((enemy-handle (process->handle (the-as process enemy))))
    ;; (format #t "[DEBUG] Looking up handle ~A for enemy ~A~%" enemy-handle (-> enemy type))
    (when enemy-handle
      (let ((count 0)
            (idx (mod (+ (-> *MOD-hit-bank* player-hit-write-idx) 63) 64)))
        (while (< count 64)
          (when (= (-> (-> *MOD-hit-bank* player-hit-handles) idx) enemy-handle)
            (let ((mode (-> (-> *MOD-hit-bank* player-hit-modes) idx)))
              ;; (format #t "[DEBUG] Found hit-mode: ~A~%" mode)
              (return mode)))
          (set! idx (if (= idx 0) 63 (- idx 1)))
          (+! count 1)))))
  ;; (format #t "[DEBUG] Hit-mode not found, returning #f~%")
  #f)

(defun mod-enemy-killed-by-flop? ((enemy process-drawable))
  (let ((hit-mode (mod-last-player-hit-mode enemy)))
    (if (or (= hit-mode 'flop) (= hit-mode 'flop-down))
      #t
      (when *target*
        (let ((player-state (-> *target* state name)))
          (if (or (= player-state 'target-flop)
                  (= player-state 'target-flop-hit-ground)
                  (and (mod-target-on-flut?)
                       (not (or (= player-state 'target-flut-running-attack)
                                (= player-state 'target-flut-double-jump)
                                (= player-state 'target-flut-falling)))))
            #t
            #f))))))

(defun mod-enemy-killed-by-red-eco? ((enemy process-drawable))
  (eq? (mod-last-player-hit-mode enemy) 'eco-red))

(defun mod-unique-enemy-type-seen? ((type-name symbol))
  (let ((slot 0)
        (seen #f))
    (while (and (< slot 3) (not seen))
      (when (= (-> *mod-unique-enemy-killed-types* slot) type-name)
        (set! seen #t))
      (+! slot 1))
    seen))

(defun mod-record-unique-enemy-type ((type-name symbol))
  (let ((slot 0)
        (recorded #f))
    (when (not (mod-unique-enemy-type-seen? type-name))
      (while (and (< slot 3) (not recorded))
        (when (not (-> *mod-unique-enemy-killed-types* slot))
          (set! (-> *mod-unique-enemy-killed-types* slot) type-name)
          (set! recorded #t))
        (+! slot 1)))
    recorded))

(defun mod-on-crate-break ((amount int))
  (mod-rule-counter-add-progress 'rule-crate-break amount)
  (none))

(defun mod-duration-amount ((ticks time-frame))
  (if (and (>= ticks (seconds 60)) (= (mod ticks (seconds 60)) 0)) (/ ticks (seconds 60)) (/ ticks (seconds 1))))

(defun mod-duration-unit ((ticks time-frame))
  (if (and (>= ticks (seconds 60)) (= (mod ticks (seconds 60)) 0))
    (if (= (/ ticks (seconds 60)) 1) "MINUTE" "MINUTES")
    (if (= (/ ticks (seconds 1)) 1) "SECOND" "SECONDS")))

(defun mod-timed-punishment-text ((label string) (punishment symbol))
  (let ((d (mod-punishment-duration punishment)))
    (string-format "~S ~D ~S" label (mod-duration-amount d) (mod-duration-unit d))))

(defun mod-punishment-name ((punishment symbol))
  (cond
    ((eq? punishment 'punishment-money)
     (string-format "LOSE ~D ORBS" (the int (-> *MOD-tuning-bank* money-punishment-loss))))
    ((eq? punishment 'punishment-warp) "WARP TO GEYSER")
    ((eq? punishment 'punishment-countdown) (string-format "LOSE ~D SECONDS" (mod-countdown-punishment-seconds)))
    ((eq? punishment 'punishment-revert-cell) "REVERT A RANDOM CELL")
    ((eq? punishment 'punishment-extra-rule) "EXTRA CONDITION")
    ((eq? punishment 'punishment-blind) (mod-timed-punishment-text "BLIND FOR" punishment))
    ((eq? punishment 'punishment-fall-damage) (mod-timed-punishment-text "MORE FALL DAMAGE FOR" punishment))
    ((eq? punishment 'punishment-trip) (mod-timed-punishment-text "TRIP RANDOMLY FOR" punishment))
    ((eq? punishment 'punishment-edge) (mod-timed-punishment-text "NO LEDGE GRABS FOR" punishment))
    ((eq? punishment 'punishment-delay)
     (let ((d (mod-punishment-duration punishment)))
       (string-format "~D-MS INPUT DELAY FOR ~D ~S"
                      (mod-seconds->ms (-> *MOD-tuning-bank* punishment-input-delay))
                      (mod-duration-amount d)
                      (mod-duration-unit d))))
    ((eq? punishment 'punishment-crash) "CRASH THE GAME")
    ((eq? punishment 'punishment-iframes) (mod-timed-punishment-text "NO I-FRAMES FOR" punishment))
    ((eq? punishment 'punishment-camera) (mod-timed-punishment-text "INVERTED CAMERA FOR" punishment))
    ((eq? punishment 'punishment-ohko) (mod-timed-punishment-text "ANY DAMAGE OR BONK KILLS FOR" punishment))
    ((eq? punishment 'punishment-reset) "RESET THE RUN")
    ((eq? punishment 'punishment-kick) (mod-timed-punishment-text "NO SPIN KICK FOR" punishment))
    ((eq? punishment 'punishment-pause) (mod-timed-punishment-text "PAUSE RANDOMLY FOR" punishment))
    (else "NONE")))

(defun mod-timed-punishment-name ((punishment symbol))
  (cond
    ((eq? punishment 'punishment-fall-damage) "FALL DAMAGE")
    ((eq? punishment 'punishment-trip) "TRIP")
    ((eq? punishment 'punishment-edge) "LEDGE GRAB")
    ((eq? punishment 'punishment-delay) "INPUT DELAY")
    ((eq? punishment 'punishment-iframes) "I-FRAMES")
    ((eq? punishment 'punishment-camera) "CAMERA")
    ((eq? punishment 'punishment-ohko) "OHKO")
    ((eq? punishment 'punishment-kick) "SPIN KICK")
    ((eq? punishment 'punishment-pause) "PAUSE")
    (else (mod-punishment-name punishment))))

(defun mod-apply-extra-rule-punishment ((failed-slot int))
  (when (and (>= failed-slot 0) (< failed-slot *mod-rule-slot-count*))
    (if (< (mod-rule-active-slot-count) 2)
      (begin
        (mod-rule-reroll-slot failed-slot #t)
        (let ((extra-slot (mod-rule-first-free-slot))) (when (>= extra-slot 0) (mod-rule-reroll-slot extra-slot #t))))
      (mod-rule-finish-slot failed-slot #t)))
  (none))

(defun mod-reset-run-and-restart ()
  (set! (-> *MOD-countdown-bank* remaining-time) 0)
  (set! (-> *MOD-countdown-bank* lost?) #t)
  (set! (-> *MOD-countdown-bank* active?) #f)
  (kill-by-name 'mod-rule-manager *active-pool*)
  (mod-rules-reset)
  (when *target*
    (logclear! (-> *target* mask) (process-mask sleep)))
  (set! (-> *MOD-rule-context-bank* mean-look-clear-time) 0)
  (process-spawn-function process
    (lambda ()
      (suspend)
      (start-speedrun (the-as speedrun-category #f))))
  (none))

(defun mod-set-punished-fall-damage! ()
  (set! (-> *TARGET-bank* fall-far) (-> *MOD-tuning-bank* fall-damage-far))
  (set! (-> *TARGET-bank* fall-far-inc) (-> *MOD-tuning-bank* fall-damage-far-inc))
  (none))

(defun mod-rule-apply-punishment ((punishment symbol))
  (cond
    ((eq? punishment 'punishment-money)
     (set! (-> *game-info* money) (max 0.0 (- (current-orb-count) (-> *MOD-tuning-bank* money-punishment-loss)))))
    ((eq? punishment 'punishment-crash)
     (play-custom-sfx "Goodbye.mp3" 40.0)
     (process-spawn-function process
       (lambda ()
         (let ((start-time (current-time))) (until (>= (- (current-time) start-time) (seconds 1)) (suspend)))
         (/ 1 0))))
    ((eq? punishment 'punishment-warp)
     (process-spawn-function process
       (lambda ()
         (let ((start-time (current-time))) (until (>= (- (current-time) start-time) (seconds 1)) (suspend)))
         (set! (-> *game-info* current-continue) (get-continue-by-name *game-info* "training-warp"))
         (when (progress-allowed?)
           (auto-save-command 'auto-save 0 0 *default-pool*))
         (initialize! *game-info* 'die (the-as game-save #f) (the-as string #f)))))
    ((eq? punishment 'punishment-countdown)
     (when (-> *MOD-countdown-bank* active?)
       (set! (-> *MOD-countdown-bank* remaining-time)
             (- (-> *MOD-countdown-bank* remaining-time) (mod-countdown-punishment-ticks)))))
    ((eq? punishment 'punishment-revert-cell) (mod-revert-random-collected-cell))
    ((eq? punishment 'punishment-blind) (set-blackout-frames (mod-punishment-duration punishment)))
    ((eq? punishment 'punishment-fall-damage) (mod-set-punished-fall-damage!))
    ((eq? punishment 'punishment-reset)
     (process-spawn-function process
       (lambda ()
         (let ((start-time (current-time))) (until (>= (- (current-time) start-time) (seconds 1)) (suspend)))
         (mod-reset-run-and-restart))))
    ((eq? punishment 'punishment-delay) (input-delay-enable! #t (-> *MOD-tuning-bank* punishment-input-delay)))
    ((eq? punishment 'punishment-iframes) (set! (-> *TARGET-bank* hit-invulnerable-timeout) (seconds 0))))
  ;; every punishment with a duration also runs a timer (others have duration 0 and are ignored)
  (mod-start-timed-punishment punishment)
  (none))

(defun mod-rule-slot-in-grace-period? ((slot int))
  (and (>= slot 0)
       (< slot *mod-rule-slot-count*)
       (< (current-time) (-> (-> *MOD-rule-slot-bank* slot-grace-periods) slot))))

(defun mod-rule-resolve! ((slot int) (natural-outcome symbol) (ignore-grace? symbol))
  (when (and (>= slot 0) (< slot *mod-rule-slot-count*) (-> (-> *MOD-rule-slot-bank* active-slots) slot))
    (let* ((twisted? (mod-rule-twist-marked-slot? slot))
           (effective (if twisted? (if (eq? natural-outcome 'success) 'failed 'success) natural-outcome)))
      (cond
        ((and (eq? effective 'success)
              ;; a twisted rule's natural failure inside the grace period is ignored, same as an untwisted one
              (or (not twisted?) (not (eq? natural-outcome 'failed)) ignore-grace? (not (mod-rule-slot-in-grace-period? slot))))
         (when twisted?
           (set! (-> *MOD-rule-context-bank* twist-marked-slot) -1))
         (sound-play "buzzer-pickup")
         (set! (-> *MOD-rule-context-bank* last-outcome) (if twisted? 'twisted-success 'success))
         (when (eq? (mod-rule-type (-> (-> *MOD-rule-slot-bank* active-slots) slot)) 'rule)
           (+! (-> *MOD-stats-bank* rules-followed) 1)
           (mod-pass-add-credit!)
           (mod-global-countdown-add-seconds (compliance-increment-value)))
         (auto-save-command 'auto-save 0 0 *default-pool*)
         (mod-rule-finish-slot slot #t))
        ((or ignore-grace? (not (mod-rule-slot-in-grace-period? slot)))
         (when twisted?
           (set! (-> *MOD-rule-context-bank* twist-marked-slot) -1))
         (sound-play "caught-eel")
         (+! (-> *MOD-stats-bank* rules-broken) 1)
         (auto-save-command 'auto-save 0 0 *default-pool*)
         (set! (-> *MOD-rule-context-bank* last-outcome) (if twisted? 'twisted-failed 'failed))
         (let ((punishment (or (-> (-> *MOD-rule-slot-bank* slot-punishments) slot)
                               (mod-random-available-punishment (-> (-> *MOD-rule-slot-bank* active-slots) slot)))))
           (if (eq? punishment 'punishment-extra-rule)
             (mod-apply-extra-rule-punishment slot)
             (begin
               (mod-rule-apply-punishment punishment)
               (mod-rule-finish-slot slot #t))))))))
  (none))

(defun mod-rule-skip-slot! ((slot int))
  (when (and (>= slot 0) (< slot *mod-rule-slot-count*) (-> (-> *MOD-rule-slot-bank* active-slots) slot))
    (+! (-> *MOD-stats-bank* conditions-skipped) 1)
    ;; a skipped twist must not mark a later rule
    (when (eq? (-> (-> *MOD-rule-slot-bank* active-slots) slot) 'complication-twisted)
      (set! (-> *MOD-rule-context-bank* twist-pending-count) -1))
    (sound-play "cursor-options")
    (set! (-> *MOD-rule-context-bank* last-outcome) 'skipped)
    (auto-save-command 'auto-save 0 0 *default-pool*)
    (mod-rule-finish-slot slot #t))
  (none))

(defun mod-rule-use-pass! ()
  (when (and (mod-rule-current-active-id) (> (-> *MOD-pass-bank* passes) 0))
    (let ((slot 0))
      (-! (-> *MOD-pass-bank* passes) 1)
      (while (< slot *mod-rule-slot-count*)
        (when (-> (-> *MOD-rule-slot-bank* active-slots) slot)
          (mod-rule-skip-slot! slot))
        (+! slot 1))))
  (none))

(defun mod-rule-handle-pass-input ()
  (when (or (and (cpad-hold? 0 l2) (cpad-pressed? 0 r2)) (and (cpad-hold? 0 r2) (cpad-pressed? 0 l2)))
    (mod-rule-use-pass!))
  (none))

(defun mod-rule-clear-other-active-rules! ((exclude-slot int))
  (let ((slot 0))
    (while (< slot *mod-rule-slot-count*)
      (when (!= slot exclude-slot)
        (let ((id (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
          (when (and id (eq? (mod-rule-type id) 'rule))
            (mod-rule-deactivate-slot slot)
            ;; this rule was discarded by the twist before it could be followed or broken, so it no longer counts as rolled
            (set! (-> *MOD-stats-bank* rules-rolled) (max 0 (- (-> *MOD-stats-bank* rules-rolled) 1)))
            (mod-rule-forget-roll! id)
            (let ((chosen (mod-rule-pick-weighted-id)))
              (if chosen
                (begin
                  (mod-rule-activate-slot slot chosen)
                  (mod-rule-record-roll! chosen))
                (mod-rule-schedule-slot slot 'mod-rule-pending-roll #t))))))
      (+! slot 1)))
  (none))

(defun mod-rule-twist-check-and-mark! ((slot int) (id symbol))
  (when (and (>= (-> *MOD-rule-context-bank* twist-pending-count) 0)
             (= (-> *MOD-stats-bank* rules-rolled) (-> *MOD-rule-context-bank* twist-pending-count)))
    (set! (-> *MOD-rule-context-bank* twist-marked-slot) slot)
    (set! (-> *MOD-rule-context-bank* twist-pending-count) -1)
    (mod-rule-clear-other-active-rules! slot))
  (none))

(defun mod-rule-twist-marked-slot? ((slot int))
  (and (>= (-> *MOD-rule-context-bank* twist-marked-slot) 0) (= (-> *MOD-rule-context-bank* twist-marked-slot) slot)))

;; (defun mod-rule-handle-slot-failure ((slot int) (punishment symbol))
;;   (mod-rule-resolve! slot 'failed #f)
;;   (none))

(defun mod-rule-handle-slot-expiry ((slot int))
  (when (and (>= slot 0) (< slot *mod-rule-slot-count*))
    (let ((id (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
      (when id
        (let ((goal (-> (-> *MOD-rule-slot-bank* slot-goals) slot))
              (progress (-> (-> *MOD-rule-slot-bank* slot-progress) slot))
              (punishment (-> (-> *MOD-rule-slot-bank* slot-punishments) slot)))
          (when (and (> goal 0) (< progress goal) punishment)
            (mod-rule-resolve! slot 'failed #t))
          (if (not (movie?)) (sound-play "cursor-options"))
          (when (and (= id (-> (-> *MOD-rule-slot-bank* active-slots) slot)) (or (<= goal 0) (>= progress goal) (not punishment)))
            (when (eq? (mod-rule-type id) 'complication)
              (+! (-> *MOD-stats-bank* complications-endured) 1))
            (mod-rule-resolve! slot 'success #t))))))
  (none))

(defun mod-rule-punishment-for-id ((id symbol))
  (let ((slot 0)
        (found #f)
        (result #f))
    (while (and (< slot *mod-rule-slot-count*) (not found))
      (when (= (-> (-> *MOD-rule-slot-bank* active-slots) slot) id)
        (set! result (-> (-> *MOD-rule-slot-bank* slot-punishments) slot))
        (set! found #t))
      (+! slot 1))
    result))

(defun mod-warp-gate-menu-open? ()
  (let ((warp-gate (process-by-type-exact 'warp-gate *active-pool*)))
    (and warp-gate (= (-> warp-gate next-state name) 'active))))

(defun mod-math-quiz-handle-input ()
  (when (mod-rule-active? 'rule-math-quiz)
    (unless (mod-warp-gate-menu-open?)
      (when (cpad-pressed? 0 up)
        (+! (-> *MOD-quiz-bank* math-current-guess) 1)
        (sound-play "cursor-up-down"))
      (when (cpad-pressed? 0 down)
        (-! (-> *MOD-quiz-bank* math-current-guess) 1)
        (sound-play "cursor-up-down"))
      (when (cpad-pressed? 0 right)
        (+! (-> *MOD-quiz-bank* math-current-guess) 5)
        (sound-play "cursor-up-down"))
      (when (cpad-pressed? 0 left)
        (-! (-> *MOD-quiz-bank* math-current-guess) 5)
        (sound-play "cursor-up-down")))
    (when (cpad-pressed? 0 l3)
      (let ((slot (mod-rule-find-active-slot 'rule-math-quiz)))
        (when (>= slot 0)
          (mod-rule-resolve! slot
                             (if (= (-> *MOD-quiz-bank* math-current-guess) (-> *MOD-quiz-bank* math-answer)) 'success 'failed)
                             #t)))))
  (none))

(defun mod-update-math-quiz ()
  (mod-math-quiz-handle-input)
  (when (mod-rule-active? 'rule-math-quiz)
    (let ((slot (mod-rule-find-active-slot 'rule-math-quiz)))
      (when (and (>= slot 0) (<= (- (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (current-time)) 0))
        (mod-rule-resolve! slot
                           (if (= (-> *MOD-quiz-bank* math-current-guess) (-> *MOD-quiz-bank* math-answer)) 'success 'failed)
                           #t))))
  (none))

(defun mod-rule-reroll-id ((id symbol))
  (let ((slot 0)
        (found #f))
    (while (and (< slot *mod-rule-slot-count*) (not found))
      (when (= (-> (-> *MOD-rule-slot-bank* active-slots) slot) id)
        (mod-rule-reroll-slot slot #t)
        (set! found #t))
      (+! slot 1)))
  (none))

(defun mod-rule-fail! ((id symbol))
  (let ((slot (mod-rule-find-active-slot id)))
    (when (and (>= slot 0) (-> (-> *MOD-rule-slot-bank* slot-punishments) slot))
      (mod-rule-resolve! slot 'failed (eq? id 'rule-survivor)))) ;; ignore grace period for survivor rule
  (none))

(defun mod-rule-update-qte ()
  (let ((slot (mod-rule-find-active-slot 'rule-qte)))
    (when (>= slot 0)
      (let ((pressed (cpad-pressed 0)))
        (when (logtest? pressed (pad-buttons triangle circle x square))
          (let ((hit? (case (-> *MOD-rule-context-bank* qte-target-button)
                        ((0) (logtest? pressed (pad-buttons triangle)))
                        ((1) (logtest? pressed (pad-buttons circle)))
                        ((2) (logtest? pressed (pad-buttons x)))
                        (else (logtest? pressed (pad-buttons square))))))
            (mod-rule-resolve! slot (if hit? 'success 'failed) #f))))))
  (none))

(defun mod-rule-update-red-light ()
  (when (mod-rule-active? 'rule-red-light)
    (when (or (and (not (mod-target-on-racer?)) (or (cpad-pressed? 0 circle) (cpad-pressed? 0 square) (cpad-pressed? 0 x)))
              (cpad-pressed? 0 l1)
              (cpad-pressed? 0 r1)
              (!= (-> *cpad-list* cpads 0 stick0-speed) 0.0)
              (and (mod-target-on-racer?) (cpad-hold? 0 x)))
      (mod-rule-fail! 'rule-red-light)))
  (none))

(defun mod-rule-trigger-brittle-bones ()
  (when (mod-rule-active? 'complication-brittle-bones)
    (let ((roll (mod-rand-punish-int-range 0 100)))
      ;; (format #t "Brittle Bones roll: ~D~%" roll)
      (when (and *target* (< roll 10))
        (send-event *target* 'attack #t (new 'static 'attack-info)))))
  (none))

(defun mod-rule-on-jump ()
  (mod-rule-trigger-brittle-bones)
  (mod-rule-fail! 'rule-grounded)
  (none))

(defun mod-rule-trigger-loose-pockets ()
  (when (mod-rule-active? 'complication-loose-pockets)
    (set! (-> *game-info* money) (max 0.0 (- (current-orb-count) 20.0))))
  (none))

(defun mod-rule-trigger-get-a-grip ()
  (when (mod-rule-active? 'complication-get-a-grip)
    (set! (-> *MOD-rule-context-bank* get-a-grip-last-grab) (current-time)))
  (none))

(defun mod-rule-trigger-rotten-eggs ()
  (when (and (not (movie?)) (mod-rule-active? 'complication-rotten-eggs))
    (send-event *target* 'attack-invinc #f (static-attack-info ((mode (if (mod-target-on-flut?) 'endlessfall 'melt)))))
    (none)))

(defun mod-rule-trigger-eco-allergy ()
  (when (mod-rule-active? 'complication-eco-allergy)
    (send-event *target* 'attack #t (new 'static 'attack-info)))
  (none))

(defun mod-rule-trigger-sizeable ()
  (if (mod-rule-active? 'complication-sizeable)
    (if (>= (current-orb-count) 2.0) (begin   (set! (-> *game-info* money) (- (current-orb-count) 2.0))   #t) #f)
    #t))

(defun mod-rule-update-ohko ()
  (when (and *target*
             (or (mod-rule-active? 'rule-survivor) (mod-rule-active? 'complication-ohko))
             (> (-> (the-as fact-info-target (-> *target* fact)) health) 1.0))
    (set! (-> (the-as fact-info-target (-> *target* fact)) health) 1.0))
  (none))

(defun mod-rule-trigger-glare ()
  (when (mod-rule-active? 'complication-glare)
    (logior! (-> *target* mask) (process-mask sleep))
    (set! (-> *MOD-rule-context-bank* mean-look-clear-time) (+ (current-time) (seconds 3))))
  (none))

(defun mod-rule-update-shifty ()
  (when (and (mod-rule-active? 'complication-shifty) (>= (current-time) (-> *MOD-rule-context-bank* shifty-next-time)))
    (when (and *target* (not (movie?)))
      (let ((dx (mod-rand-float-range 1.5 5.0))
            (dz (mod-rand-float-range 1.5 5.0))
            (sfx (mod-rand-int-range 0 3)))
        (when (= (mod-rand-int-range 0 2) 0)
          (set! dx (- dx)))
        (when (= (mod-rand-int-range 0 2) 0)
          (set! dz (- dz)))
        (set! (-> (target-pos 0) x) (+ (-> (target-pos 0) x) (meters dx)))
        (set! (-> (target-pos 0) z) (+ (-> (target-pos 0) z) (meters dz)))
        (cond
          ((= sfx 0) (play-custom-sfx "warp1.mp3" 60.0))
          ((= sfx 1) (play-custom-sfx "warp2.mp3" 60.0))
          ((= sfx 2) (play-custom-sfx "warp3.mp3" 60.0)))))
    (set! (-> *MOD-rule-context-bank* shifty-next-time) (+ (current-time) (seconds (mod-rand-int-range 1 11)))))
  (none))

(defun mod-rule-trigger-double-kill ()
  (when (mod-rule-active? 'rule-double-kill)
    (let ((now (current-time)))
      (if (and (> (-> *MOD-rule-context-bank* last-kill-time) 0)
               (<= (- now (-> *MOD-rule-context-bank* last-kill-time)) (seconds 0.15)))
        (begin
          (mod-rule-counter-add-progress 'rule-double-kill 1)
          (set! (-> *MOD-rule-context-bank* last-kill-time) 0))
        (set! (-> *MOD-rule-context-bank* last-kill-time) now))))
  (none))

(defun mod-rule-trigger-flop-this ((flop-kill? symbol))
  (when (not flop-kill?)
    (mod-rule-fail! 'rule-flop-this))
  (none))

(defun mod-rule-trigger-soul-bond ()
  (when (mod-rule-active? 'complication-soul-bond)
    (send-event *target* 'attack-invinc #f (static-attack-info ((mode (if (mod-target-on-flut?) 'endlessfall 'melt))))))
  (none))

(defun mod-rule-trigger-hitlist ((enemy-type symbol))
  (when (and (mod-rule-active? 'rule-hitlist) enemy-type (mod-record-unique-enemy-type enemy-type))
    (mod-rule-counter-add-progress 'rule-hitlist 1))
  (none))

(defun mod-rule-trigger-vendetta ((red-eco-kill? symbol))
  (when red-eco-kill?
    (mod-rule-counter-add-progress 'rule-vendetta 1))
  (none))

(defun mod-rule-trigger-sniper ((far-kill? symbol))
  (when (and (mod-rule-active? 'rule-sniper) far-kill?)
    (mod-rule-counter-add-progress 'rule-sniper 1))
  (none))

(defun mod-rule-trigger-heating-balloons ()
  (when (mod-rule-active? 'complication-heating-balloons)
    (send-event *target* 'attack-invinc #f (static-attack-info ((mode 'melt)))))
  (none))

(defun mod-rule-trigger-disassociate ()
  (when (and (mod-target-on-flut?) (mod-rule-active? 'complication-disassociate) (not (movie?)))
    (send-event *target* 'end-mode))
  (none))

(defun mod-rule-trigger-bus-driver ()
  (when (and (mod-rule-active? 'complication-bus-driver)
             (>= (- (current-time) (-> *MOD-rule-context-bank* bus-driver-activate-time))
                 (-> *MOD-rule-context-bank* bus-driver-grace-period)))
    (when (not (movie?))
      (target-attack-up *target* 'attack 'explode)))
  (none))

(defun mod-rule-update-speed ()
  (when (and *target* (mod-rule-active? 'rule-speed) (>= (-> *target* control ctrl-xz-vel) (meters 40)))
    (mod-rule-counter-add-progress 'rule-speed 1))
  (none))

(defun mod-on-jak-death ()
  (mod-rule-counter-add-progress 'rule-die 1)
  (mod-rule-fail! 'rule-survivor)
  (when (mod-rule-active? 'rule-hang-time)
    (let ((slot (mod-rule-find-active-slot 'rule-hang-time)))
      (when (>= slot 0)
        (set! (-> (-> *MOD-rule-slot-bank* slot-progress) slot) 0))))
  (set! (-> *MOD-rule-context-bank* hang-time-air-start) (current-time))
  (none))

(defun mod-on-damage ()
  (mod-rule-trigger-loose-pockets)
  (if (mod-timed-punishment-active? 'punishment-ohko)
    (begin
      (pickup-collectable! (-> *target* fact) (pickup-type eco-green) (the-as float -1000.0) (the-as handle #f))
      (if (mod-target-on-racer?) (target-attack-up *target* 'attack 'explode))))
  (none))

(defun global-countdown-paused? ()
  (or (movie?)
      (task-complete? *game-info* (game-task finalboss-movies))
      (and *setting-control* (-> *setting-control* current movie))
      (and *target* (logtest? (-> *target* state-flags) (state-flags grabbed)))))

(defun mod-trivia-dynamic-dedup ((val int) (answer int) (other1 int) (other2 int) (step int))
  (while (or (= val answer) (= val other1) (= val other2))
    (set! val (+ val step)))
  val)

(defun mod-trivia-dynamic-delta ((base int) (mag int) (sign int))
  (if (= sign 0) (if (>= (- base mag) 0) (- base mag) (+ base mag)) (+ base mag)))

(defun mod-trivia-dynamic-offset ((base int) (seed int) (shift int) (step int) (count int))
  (let* ((bits (shr seed shift))
         (mag (* step (+ 1 (mod (logand bits 7) count))))
         (sign (logand (shr bits 3) 1)))
    (mod-trivia-dynamic-delta base mag sign)))

(defun mod-trivia-dynamic-choice-str ((answer int) (shuffled-idx int) (count int))
  (let* ((seed (-> *MOD-quiz-bank* trivia-dynamic-seed))
         (step-divisor 15)
         (scaled-step (if (<= (/ answer step-divisor) 0) 1 (/ answer step-divisor)))
         (v1 (mod-trivia-dynamic-offset answer seed 0 scaled-step count))
         (v2 (mod-trivia-dynamic-offset answer seed 4 scaled-step count))
         (v3 (mod-trivia-dynamic-offset answer seed 8 scaled-step count)))
    (set! v1 (mod-trivia-dynamic-dedup v1 answer answer answer scaled-step))
    (set! v2 (mod-trivia-dynamic-dedup v2 answer v1 v1 scaled-step))
    (set! v3 (mod-trivia-dynamic-dedup v3 answer v1 v2 scaled-step))
    (format (clear (-> *MOD-quiz-bank* trivia-dynamic-str))
            "~D"
            (cond
              ((= shuffled-idx 0) answer)
              ((= shuffled-idx 1) v1)
              ((= shuffled-idx 2) v2)
              (else v3)))
    (-> *MOD-quiz-bank* trivia-dynamic-str)))

(defun mod-get-trivia-choice-str ((q-idx int) (guess-idx int))
  (let ((shuffled-idx (-> (-> *MOD-quiz-bank* trivia-shuffle-map) guess-idx)))
    (cond
      ;; Dynamic questions here
      ;; ((= q-idx 9999) (mod-trivia-dynamic-choice-str (-> *game-info* total-deaths) shuffled-idx 4))
      ;; ((= q-idx 9999) (mod-trivia-dynamic-choice-str (the int (-> *game-info* money)) shuffled-idx 6))
      ((= q-idx 40) (mod-trivia-dynamic-choice-str (-> *MOD-stats-bank* rules-broken) shuffled-idx 4))
      ((= q-idx 47) (mod-trivia-dynamic-choice-str (the int (-> *game-info* money-total)) shuffled-idx 6))
      (else (-> *mod-trivia-choices* (+ (* q-idx 4) shuffled-idx))))))

(defun mod-get-trivia-answer ((q-idx int))
  (cond
    ((= q-idx 4) 2)
    ((= q-idx 7) 1)
    ((= q-idx 12) 3)
    ((= q-idx 13) 3)
    ((= q-idx 14) 2)
    ((= q-idx 17) 1)
    ((= q-idx 19) 3)
    ((= q-idx 23) 2)
    ((= q-idx 26) 1)
    ((= q-idx 35) 2)
    ;; Dynamic questions here
    (else 0)))

(defun mod-shuffle-trivia-choices ((q-idx int))
  (set! (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 0) 0)
  (set! (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 1) 1)
  (set! (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 2) 2)
  (set! (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 3) 3)
  ;; Do not shuffle
  (when (and (!= q-idx 2)
             (!= q-idx 4)
             (!= q-idx 7)
             (!= q-idx 12)
             (!= q-idx 13)
             (!= q-idx 14)
             (!= q-idx 17)
             (!= q-idx 19)
             (!= q-idx 23)
             (!= q-idx 26)
             (!= q-idx 31)
             (!= q-idx 34)
             (!= q-idx 35))
    (dotimes (i 4)
      (let* ((j (mod-rand-int-range 0 (+ i 1)))
             (temp (-> (-> *MOD-quiz-bank* trivia-shuffle-map) i)))
        (set! (-> (-> *MOD-quiz-bank* trivia-shuffle-map) i) (-> (-> *MOD-quiz-bank* trivia-shuffle-map) j))
        (set! (-> (-> *MOD-quiz-bank* trivia-shuffle-map) j) temp))))
  (none))

(defun mod-trivia-handle-input ()
  (when (mod-rule-active? 'rule-trivia)
    (let ((q-idx (-> *MOD-quiz-bank* trivia-current-question)))
      (when (!= q-idx (-> *MOD-quiz-bank* trivia-last-tracked-question))
        (set! (-> *MOD-quiz-bank* trivia-last-tracked-question) q-idx)
        (mod-shuffle-trivia-choices q-idx)
        (set! (-> *MOD-quiz-bank* trivia-current-guess) -1)))
    (unless (mod-warp-gate-menu-open?)
      (when (or (cpad-pressed? 0 up) (cpad-pressed? 0 right))
        (cond
          ((< (-> *MOD-quiz-bank* trivia-current-guess) 0) (set! (-> *MOD-quiz-bank* trivia-current-guess) 0))
          ((>= (-> *MOD-quiz-bank* trivia-current-guess) 3) (set! (-> *MOD-quiz-bank* trivia-current-guess) 0))
          (else (+! (-> *MOD-quiz-bank* trivia-current-guess) 1)))
        (sound-play "cursor-up-down"))
      (when (or (cpad-pressed? 0 down) (cpad-pressed? 0 left))
        (cond
          ((<= (-> *MOD-quiz-bank* trivia-current-guess) 0) (set! (-> *MOD-quiz-bank* trivia-current-guess) 3))
          (else (-! (-> *MOD-quiz-bank* trivia-current-guess) 1)))
        (sound-play "cursor-up-down")))
    (when (and (>= (-> *MOD-quiz-bank* trivia-current-guess) 0) (cpad-pressed? 0 l3))
      (let ((slot (mod-rule-find-active-slot 'rule-trivia)))
        (when (>= slot 0)
          (mod-rule-resolve! slot
                             (if (= (-> (-> *MOD-quiz-bank* trivia-shuffle-map) (-> *MOD-quiz-bank* trivia-current-guess))
                                    (mod-get-trivia-answer (-> *MOD-quiz-bank* trivia-current-question)))
                               'success
                               'failed)
                             #t)))))
  (none))

(defun mod-update-trivia ()
  (mod-trivia-handle-input)
  (when (mod-rule-active? 'rule-trivia)
    (let ((slot (mod-rule-find-active-slot 'rule-trivia)))
      (when (and (>= slot 0) (<= (- (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (current-time)) 0))
        (let ((guess (-> *MOD-quiz-bank* trivia-current-guess)))
          (mod-rule-resolve! slot
                             (if (and (>= guess 0)
                                      (= (-> (-> *MOD-quiz-bank* trivia-shuffle-map) guess) (mod-get-trivia-answer (-> *MOD-quiz-bank* trivia-current-question))))
                               'success
                               'failed)
                             #t)))))
  (none))

(defun mod-shift-all-timers! ((elapsed time-frame))
  (dotimes (slot *mod-rule-slot-count*)
    (when (-> (-> *MOD-rule-slot-bank* active-slots) slot)
      (set! (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (+ (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) elapsed)))
    (when (-> (-> *MOD-rule-slot-bank* pending-slots) slot)
      (set! (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot)
            (+ (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot) elapsed))))
  (dotimes (slot *mod-timed-punishment-slot-count*)
    (when (-> (-> *MOD-punishment-bank* timed-punishments) slot)
      (set! (-> (-> *MOD-punishment-bank* timed-end-times) slot)
            (+ (-> (-> *MOD-punishment-bank* timed-end-times) slot) elapsed))
      (set! (-> (-> *MOD-punishment-bank* timed-next-ticks) slot)
            (+ (-> (-> *MOD-punishment-bank* timed-next-ticks) slot) elapsed))))
  (set! (-> *MOD-rule-context-bank* hang-time-air-start) (+ (-> *MOD-rule-context-bank* hang-time-air-start) elapsed))
  (set! (-> *MOD-rule-context-bank* get-a-grip-last-grab) (+ (-> *MOD-rule-context-bank* get-a-grip-last-grab) elapsed))
  (set! (-> *MOD-rule-context-bank* bus-driver-activate-time)
        (+ (-> *MOD-rule-context-bank* bus-driver-activate-time) elapsed))
  (set! (-> *MOD-rule-context-bank* shifty-next-time) (+ (-> *MOD-rule-context-bank* shifty-next-time) elapsed))
  (none))

(defbehavior mod-rule-manager-proc process ()
  (when (not (-> *MOD-countdown-bank* lost?))
    (loop
      (let ((elapsed (- (current-time) (-> *MOD-rule-context-bank* last-update-time))))
        (when (or (< elapsed 0) (> elapsed (seconds 10)))
          (mod-shift-all-timers! elapsed)
          (set! elapsed 0))
        (cond
          ((global-countdown-paused?)
           (when (> elapsed 0)
             (mod-shift-all-timers! elapsed))
           (mod-math-quiz-handle-input)
           (mod-trivia-handle-input)
           (mod-rule-handle-pass-input))
          (else
           ;; (+! (-> *MOD-countdown-bank* countup-timer) elapsed)
           (when (and (> (-> *MOD-rule-context-bank* mean-look-clear-time) 0)
                      (>= (current-time) (-> *MOD-rule-context-bank* mean-look-clear-time)))
             (set! (-> *MOD-rule-context-bank* mean-look-clear-time) 0)
             (logclear! (-> *target* mask) (process-mask sleep)))
           (mod-update-timed-punishments)
           (mod-update-math-quiz)
           (mod-update-trivia)
           (mod-rule-update-hang-time)
           (mod-rule-update-red-light)
           (mod-rule-handle-pass-input)
           (mod-rule-update-shifty)
           (when (mod-rule-active? 'complication-get-a-grip)
             (when (>= (- (current-time) (-> *MOD-rule-context-bank* get-a-grip-last-grab)) (mod-apply-time-limit-multiplier (seconds 12)))
               (send-event *target* 'attack-invinc #f (static-attack-info ((mode 'endlessfall))))
               (set! (-> *MOD-rule-context-bank* get-a-grip-last-grab) (current-time))))
           (when (mod-rule-active? 'complication-cumbersome)
             (mod-orb-weight-apply!))
           (when (mod-rule-active? 'complication-drought)
             (mod-rule-set-drought-platform-gravity! #t))
           (when (mod-rule-low-res-should-apply?)
             (mod-rule-apply-low-res!))
           (when (mod-rule-active? 'complication-lights-out)
             (mod-rule-lights-out-activate!))
           (dotimes (slot *mod-rule-slot-count*)
             (when (and (-> (-> *MOD-rule-slot-bank* active-slots) slot)
                        (>= (current-time) (-> (-> *MOD-rule-slot-bank* slot-end-times) slot)))
               (mod-rule-handle-slot-expiry slot)))
           (dotimes (slot *mod-rule-slot-count*)
             (let ((pending-id (-> (-> *MOD-rule-slot-bank* pending-slots) slot)))
               (when pending-id
                 (let* ((rolling-left (max 0 (- (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot) (current-time))))
                        (whole-second (the int (/ rolling-left (seconds 1)))))
                   (if (> whole-second 2)
                     (set! (-> (-> *MOD-rule-slot-bank* roll-last-warn-second) slot) -1)
                     (when (and (>= whole-second 0) (!= whole-second (-> (-> *MOD-rule-slot-bank* roll-last-warn-second) slot)))
                       (set! (-> (-> *MOD-rule-slot-bank* roll-last-warn-second) slot) whole-second)
                       (sound-play "cursor-up-down")))))
               (when (and pending-id (>= (current-time) (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot)))
                 (if (eq? pending-id 'mod-rule-pending-roll)
                   (let ((chosen (mod-rule-pick-weighted-id)))
                     (if chosen (begin   (mod-rule-activate-slot slot chosen)   (mod-rule-record-roll! chosen)) (mod-rule-clear-slot slot)))
                   (mod-rule-activate-slot slot pending-id)))))))
        (set! (-> *MOD-rule-context-bank* last-update-time) (current-time)))
      (suspend)))
  (none))

(defun mod-rule-spawn-manager ()
  (kill-by-name 'mod-rule-manager *active-pool*)
  (process-spawn-function process
    mod-rule-manager-proc
    :name 'mod-rule-manager)
  (none))

(defun mod-rules-start ()
  (mod-rule-reroll-current #t)
  (mod-rule-spawn-manager)
  (none))

(defun mod-rules-resume ()
  (when (= (mod-rule-active-slot-count) 0)
    (mod-rule-reroll-current #t))
  (mod-rule-spawn-manager)
  (none))

(defun mod-rule-nth-active-slot ((start-slot int))
  (let ((slot (max 0 start-slot)))
    (while (and (< slot *mod-rule-slot-count*) (not (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
      (+! slot 1))
    (if (< slot *mod-rule-slot-count*) slot -1)))

(defun mod-string-width ((str string) (flags font-flags) (scale float))
  (let ((font-ctxt (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color white) flags)))
    (* (get-string-length str font-ctxt) scale)))

(defun mod-find-substr ((str string) (sub string) (start int))
  (let* ((str-len (length str))
         (sub-len (length sub))
         (limit (- str-len sub-len))
         (found -1))
    (dotimes (i (+ limit 1))
      (when (and (= found -1) (>= i start))
        (let ((match #t))
          (dotimes (j sub-len)
            (when (!= (-> str data (+ i j)) (-> sub data j))
              (set! match #f)))
          (when match
            (set! found i)))))
    found))

(defun mod-copy-range! ((dst string) (src string) (start int) (end int))
  (let ((j 0))
    (dotimes (i (- end start))
      (set! (-> dst data j) (-> src data (+ start i)))
      (+! j 1))
    (set! (-> dst data j) 0))
  dst)

(defun mod-draw-string-xy-scaled ((str string) (buf dma-buffer) (x int) (y int) (color font-color) (flags font-flags) (scale float))
  (draw-string-xy-scaled str buf x y color flags (* scale (text-scale-multiplier))))

;; scales a row-spacing/indent pixel offset by the same multiplier as the HUD text
(defun mod-scale-px ((n int))
  (the int (* (the float n) (text-scale-multiplier))))

(defun mod-draw-qte-button ((arg0 dma-buffer) (x int) (y int))
  (let ((button-text (case (-> *MOD-rule-context-bank* qte-target-button)
                       ((0) (lookup-text! *common-text* (text-id pad-triangle) #f))
                       ((1) (lookup-text! *common-text* (text-id pad-circle) #f))
                       ((2) (lookup-text! *common-text* (text-id pad-x) #f))
                       ((3) (lookup-text! *common-text* (text-id pad-square) #f))
                       (else #f))))
    (when button-text
      (mod-draw-string-xy-scaled (the string button-text) arg0 x y (font-color green) (font-flags shadow kerning large) 0.65))))

(defun mod-rule-draw-line-highlighted! ((buf dma-buffer) (line string) (highlight string) (highlight-color font-color) (x int) (y int) (scale float))
  (let ((idx (mod-find-substr line highlight 0))
        (eff-scale (* scale (text-scale-multiplier)))
        (flags (font-flags shadow kerning large)))
    (if (< idx 0)
      (mod-draw-string-xy-scaled line buf x y (font-color white) flags scale)
      (let ((cur-x x)
            (highlight-end (+ idx (length highlight))))
        (when (> idx 0)
          (mod-copy-range! (-> *MOD-rule-display-bank* highlight-line-buf) line 0 idx)
          (mod-draw-string-xy-scaled (-> *MOD-rule-display-bank* highlight-line-buf) buf cur-x y (font-color white) flags scale)
          (+! cur-x (the int (mod-string-width (-> *MOD-rule-display-bank* highlight-line-buf) flags eff-scale))))
        (mod-copy-range! (-> *MOD-rule-display-bank* highlight-line-buf) line idx highlight-end)
        (mod-draw-string-xy-scaled (-> *MOD-rule-display-bank* highlight-line-buf) buf cur-x y highlight-color flags scale)
        (when (< highlight-end (length line))
          (+! cur-x (the int (mod-string-width (-> *MOD-rule-display-bank* highlight-line-buf) flags eff-scale)))
          (mod-copy-range! (-> *MOD-rule-display-bank* highlight-line-buf) line highlight-end (length line))
          (mod-draw-string-xy-scaled (-> *MOD-rule-display-bank* highlight-line-buf) buf cur-x y (font-color white) flags scale)))))
  (none))

(defun mod-wrap-point ((str string) (max-len int))
  (let ((len (length str)))
    (if (<= len max-len)
      len
      (let ((break-idx -1))
        (dotimes (i (+ max-len 1))
          (if (= (-> str data i) 32) (set! break-idx i)))
        (if (>= break-idx 0) break-idx max-len)))))

(defun mod-rule-draw-desc-line! ((buf dma-buffer) (id symbol) (line string) (x int) (y int) (scale float))
  (if (eq? id 'complication-twisted)
    (mod-rule-draw-line-highlighted! buf line "RULE" (font-color orangeb) x y scale)
    (mod-draw-string-xy-scaled line buf x y (font-color white) (font-flags shadow kerning large) scale))
  (none))

(defun mod-tenths-str ((val float))
  (let ((tenths (the int (* val 10.0)))) (string-format "~D.~D" (/ tenths 10) (mod tenths 10))))

(defun mod-rule-draw-wrapped! ((buf dma-buffer) (id symbol) (str string) (max-len int) (x int) (y int) (scale float) (row-step int))
  (let ((break-idx (mod-wrap-point str max-len))
        (dy (mod-scale-px row-step)))
    (cond
      ((>= break-idx (length str)) (mod-rule-draw-desc-line! buf id str x y scale) (+ y dy))
      (else
       (mod-copy-range! (-> *MOD-rule-display-bank* wrap-line-1) str 0 break-idx)
       (mod-copy-range! (-> *MOD-rule-display-bank* wrap-line-2) str (+ break-idx 1) (length str))
       (mod-rule-draw-desc-line! buf id (-> *MOD-rule-display-bank* wrap-line-1) x y scale)
       (mod-rule-draw-desc-line! buf id (-> *MOD-rule-display-bank* wrap-line-2) x (+ y dy) scale)
       (+ y dy dy)))))

(defun mod-rule-draw-labeled-value! ((buf dma-buffer) (label string) (label-color font-color) (value string) (row int))
  (mod-draw-string-xy-scaled label buf 10 row label-color (font-flags shadow kerning large) 0.3)
  (let ((value-y (- row (mod-scale-px 2))))
    (mod-draw-string-xy-scaled value buf (mod-scale-px 66) value-y (font-color white) (font-flags shadow kerning large) 0.4)
    (+ value-y (mod-scale-px 8))))

(defun mod-rule-draw-slot ((buf dma-buffer) (slot int) (y int))
  (let* ((id (-> (-> *MOD-rule-slot-bank* active-slots) slot))
         (punishment (-> (-> *MOD-rule-slot-bank* slot-punishments) slot))
         (goal (-> (-> *MOD-rule-slot-bank* slot-goals) slot))
         (progress (-> (-> *MOD-rule-slot-bank* slot-progress) slot))
         (show-progress? (and (> goal 0) (eq? (mod-rule-goal-kind id) 'counter)))
         (time-left (max 0 (- (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (current-time))))
         (row y)
         (desc (mod-rule-description id)))
    (mod-draw-string-xy-scaled (mod-rule-name id)
                               buf
                               10
                               row
                               (if (eq? (mod-rule-type id) 'rule) (font-color orangeb) (font-color triangleb))
                               (font-flags shadow kerning large)
                               0.5)
    (+! row (mod-scale-px 10))
    (if (eq? id 'rule-qte)
      (begin
        (mod-draw-string-xy-scaled desc buf 10 row (font-color white) (font-flags shadow kerning large) 0.35)
        (mod-draw-qte-button buf (mod-scale-px 50) row)
        (+! row (mod-scale-px 15)))
      (set! row (mod-rule-draw-wrapped! buf id desc 25 10 row 0.35 9)))
    (when punishment
      (mod-draw-string-xy-scaled "PUNISHMENT: " buf 10 row (font-color redb) (font-flags shadow kerning large) 0.3)
      (set! row (mod-rule-draw-wrapped! buf #f (mod-punishment-name punishment) 16 (mod-scale-px 80) row 0.3 8)))
    (when show-progress?
      (mod-draw-string-xy-scaled "PROGRESS: " buf 10 row (font-color yellow) (font-flags shadow kerning large) 0.3)
      (if (eq? id 'rule-hang-time)
        (let* ((elapsed (min (seconds (mod-rule-counter-goal 'rule-hang-time))
                             (- (current-time) (-> *MOD-rule-context-bank* hang-time-air-start))))
               (tenths (the int (* (/ (the float elapsed) (the float (seconds 1))) 10))))
          (mod-draw-string-xy-scaled (string-format "~D.~D/~D" (/ tenths 10) (mod tenths 10) goal)
                                     buf
                                     (mod-scale-px 80)
                                     (- row (mod-scale-px 2))
                                     (font-color white)
                                     (font-flags shadow kerning large)
                                     0.5))
        (mod-draw-string-xy-scaled (string-format "~D/~D" progress goal)
                                   buf
                                   (mod-scale-px 80)
                                   (- row (mod-scale-px 2))
                                   (font-color white)
                                   (font-flags shadow kerning large)
                                   0.5))
      (+! row (mod-scale-px 7)))
    (let* ((timer-text (mod-format-time-frame time-left 1 'auto))
           (timer-flags (font-flags shadow kerning large)))
      (mod-draw-string-xy-scaled timer-text buf 10 row (font-color white) timer-flags 0.5)
      (when (> (-> *MOD-pass-bank* passes) 0)
        (mod-draw-string-xy-scaled "L2+R2 TO PASS"
                                   buf
                                   (mod-scale-px 80)
                                   (+ row (mod-scale-px 3))
                                   (font-color gray)
                                   timer-flags
                                   0.3)))
    (+! row (mod-scale-px 12))
    (when (eq? id 'rule-distancing)
      (set! row
            (mod-rule-draw-labeled-value! buf
                                          "DISTANCE: "
                                          (font-color progress-percent)
                                          (if (> *closest-buzzer-dist* (meters 40)) "-" (mod-tenths-str (/ *closest-buzzer-dist* (meters 1))))
                                          row)))
    (when (eq? id 'rule-sniper)
      (set! row
            (mod-rule-draw-labeled-value! buf
                                          "LAST KILL: "
                                          (font-color progress-percent)
                                          (if (< *last-kill-dist* (meters 0)) "-" (mod-tenths-str (/ *last-kill-dist* (meters 1))))
                                          row)))
    (when (eq? id 'rule-math-quiz)
      (let ((op-string (cond
                         ((= (-> *MOD-quiz-bank* math-op) 0) "+")
                         ((= (-> *MOD-quiz-bank* math-op) 1) "-")
                         (else "*"))))
        (format (clear *temp-string*)
                "~D ~S ~D = ~1L~D"
                (-> *MOD-quiz-bank* math-val1)
                op-string
                (-> *MOD-quiz-bank* math-val2)
                (-> *MOD-quiz-bank* math-current-guess))
        (mod-draw-string-xy-scaled *temp-string* buf 10 row (font-color white) (font-flags shadow kerning large) 0.6)
        (+! row (mod-scale-px 12))))
    (when (eq? id 'rule-trivia)
      (let* ((q-idx (-> *MOD-quiz-bank* trivia-current-question))
             (choice-str (if (= (-> *MOD-quiz-bank* trivia-current-guess) -1)
                           "USE D-PAD"
                           (mod-get-trivia-choice-str q-idx (-> *MOD-quiz-bank* trivia-current-guess)))))
        (format (clear *temp-string*) "~S" (-> *mod-trivia-questions* q-idx))
        (set! row (mod-rule-draw-wrapped! buf #f *temp-string* 27 10 row 0.35 8))
        (format (clear *temp-string*) " ~S" choice-str)
        (mod-draw-string-xy-scaled *temp-string*
                                   buf
                                   (mod-scale-px 20)
                                   row
                                   (font-color progress-memcard)
                                   (font-flags shadow kerning large)
                                   0.47)
        (+! row (mod-scale-px 12))))
    (when (or (eq? id 'complication-bus-driver) (eq? id 'rule-speed))
      (let ((value-y (- row (mod-scale-px 2))))
        (set! row
              (mod-rule-draw-labeled-value! buf
                                            "SPEED: "
                                            (font-color progress-percent)
                                            (mod-tenths-str (/ (-> *target* control ctrl-xz-vel) (meters 1)))
                                            row))
        (if (mod-rule-active? 'complication-bus-driver)
          (mod-draw-string-xy-scaled "/20.0"
                                     buf
                                     (mod-scale-px 96)
                                     value-y
                                     (font-color white)
                                     (font-flags shadow kerning large)
                                     0.4))))
    (when (eq? id 'complication-get-a-grip)
      (let* ((elapsed (- (current-time) (-> *MOD-rule-context-bank* get-a-grip-last-grab)))
             (grip-left (max 0 (- (mod-apply-time-limit-multiplier (seconds 12)) elapsed))))
        (set! row (mod-rule-draw-labeled-value! buf "DEATH: " (font-color red) (mod-format-time-frame grip-left 1 #f) row))))
    row))

(defun mod-draw-timed-punishments ((buf dma-buffer))
  (let ((row-count 0))
    (dotimes (slot *mod-timed-punishment-slot-count*)
      (let ((punishment (-> (-> *MOD-punishment-bank* timed-punishments) slot)))
        (when punishment
          (let ((time-left (max 0 (- (-> (-> *MOD-punishment-bank* timed-end-times) slot) (current-time))))
                (row-y (+ 72 (* row-count (mod-scale-px 10)))))
            (mod-draw-string-xy-scaled (mod-timed-punishment-name punishment)
                                       buf
                                       395
                                       row-y
                                       (font-color white)
                                       (font-flags shadow kerning large)
                                       0.3)
            (mod-draw-string-xy-scaled (mod-format-time-frame time-left 1 'auto)
                                       buf
                                       (+ 395 (mod-scale-px 70))
                                       (- row-y (mod-scale-px 2))
                                       (font-color white)
                                       (font-flags shadow kerning large)
                                       0.4)
            (+! row-count 1))))))
  (none))

(defun mod-rule-draw-last-outcome ((buf dma-buffer) (y int))
  (cond
    ((eq? (-> *MOD-rule-context-bank* last-outcome) 'success)
     (mod-draw-string-xy-scaled "GOOD JOB!" buf 10 y (font-color green) (font-flags shadow kerning large) 0.4))
    ((eq? (-> *MOD-rule-context-bank* last-outcome) 'failed)
     (mod-draw-string-xy-scaled "RULE BROKEN!" buf 10 y (font-color red) (font-flags shadow kerning large) 0.4))
    ((eq? (-> *MOD-rule-context-bank* last-outcome) 'twisted-success)
     (mod-draw-string-xy-scaled "TWISTED RULE!" buf 10 y (font-color green) (font-flags shadow kerning large) 0.4))
    ((eq? (-> *MOD-rule-context-bank* last-outcome) 'twisted-failed)
     (mod-draw-string-xy-scaled "TWISTED RULE!" buf 10 y (font-color red) (font-flags shadow kerning large) 0.4))
    ((eq? (-> *MOD-rule-context-bank* last-outcome) 'skipped)
     (mod-draw-string-xy-scaled "PASS!" buf 10 y (font-color violet) (font-flags shadow kerning large) 0.4)))
  (none))

(defun mod-rule-draw-rolling-slot ((buf dma-buffer))
  (let ((slot 0)
        (rolling-id #f)
        (rolling-left 0))
    (while (and (< slot *mod-rule-slot-count*) (not rolling-id))
      (let ((pending (-> (-> *MOD-rule-slot-bank* pending-slots) slot)))
        (when pending
          (set! rolling-id pending)
          (set! rolling-left (max 0 (- (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot) (current-time))))))
      (+! slot 1))
    (when rolling-id
      (mod-draw-string-xy-scaled "NEW CONDITION" buf 10 60 (font-color yellow) (font-flags shadow kerning large) 0.4)
      (mod-draw-string-xy-scaled (mod-format-time-frame rolling-left 1 'auto)
                                 buf
                                 110
                                 57
                                 (font-color white)
                                 (font-flags shadow kerning large)
                                 0.6)))
  (none))

(defun mod-global-countdown-draw ()
  (cond
    ((-> *MOD-countdown-bank* active?)
     (with-dma-buffer-add-bucket ((global-buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf))
       (draw-string-xy-scaled (string-format "SEED: ~D" (-> *MOD-rng-bank* seed-display))
                              global-buf
                              4
                              215
                              (font-color flat-yellow)
                              (font-flags shadow kerning large)
                              0.4)
       ;; Draw main countdown timer
       (mod-draw-string-xy-scaled (mod-format-time-frame (-> *MOD-countdown-bank* remaining-time) 2 'auto)
                                  global-buf
                                  380
                                  54
                                  (font-color red)
                                  (font-flags shadow kerning large)
                                  0.8)
       ;; Draw countup timer
       (when (show-countup-timer-enabled?)
         (let ((show-hours? (> (the int (/ (-> *MOD-countdown-bank* countup-timer) (seconds 3600))) 0)))
           (mod-draw-string-xy-scaled (mod-format-time-frame (-> *MOD-countdown-bank* countup-timer) 2 'auto)
                                      global-buf
                                      (if show-hours? 390 410)
                                      44
                                      (font-color white)
                                      (font-flags shadow kerning large)
                                      0.5)))
       (mod-draw-timed-punishments global-buf)
       (let ((reverted-y 72)
             (primary (mod-rule-nth-active-slot 0)))
         (cond
           ((>= primary 0)
            (let ((end-row (mod-rule-draw-slot global-buf primary 40)))
              (set! reverted-y (+ end-row (mod-scale-px 20)))
              (let ((secondary (mod-rule-nth-active-slot (+ primary 1))))
                (cond
                  ((>= secondary 0)
                   (mod-rule-draw-last-outcome global-buf (+ end-row (mod-scale-px 8)))
                   (set! reverted-y (+ (mod-rule-draw-slot global-buf secondary (+ end-row (mod-scale-px 18))) (mod-scale-px 20))))
                  (else (mod-rule-draw-last-outcome global-buf (+ end-row (mod-scale-px 8))))))))
           (else (mod-rule-draw-rolling-slot global-buf) (mod-rule-draw-last-outcome global-buf 51)))
         (when (> (-> *MOD-rule-context-bank* last-reverted-cell-until) (current-time))
           (mod-draw-string-xy-scaled (string-format "REVERTED: ~A"
                                                     (mod-revert-cell-name (the game-task (-> *MOD-rule-context-bank* last-reverted-cell-task))))
                                      global-buf
                                      10
                                      reverted-y
                                      (font-color red)
                                      (font-flags shadow kerning large)
                                      0.35)))))
    (else (none)))
  (none))

(defun mod-global-countdown-add-seconds ((seconds-to-add float))
  (when (-> *MOD-countdown-bank* active?)
    (when (mod-rule-active? 'complication-income-tax)
      (set! seconds-to-add (* seconds-to-add 0.5)))
    (set! (-> *MOD-countdown-bank* remaining-time)
          (+ (-> *MOD-countdown-bank* remaining-time) (the int (* seconds-to-add (the float TICKS_PER_SECOND))))))
  (none))

(defun draw-complicated-mod-title ()
  (with-dma-buffer-add-bucket ((global-buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf))
    (let ((title-row 30)
          (title-x 10))
      (draw-string-xy-scaled "A COMPLICATED MOD"
                             global-buf
                             title-x
                             title-row
                             (font-color green)
                             (font-flags shadow kerning large)
                             0.8)
      (+! title-row (mod-scale-px 15))
      (draw-string-xy-scaled "A COMPLICATED MOD WITH RULES."
                             global-buf
                             title-x
                             title-row
                             (font-color white)
                             (font-flags shadow kerning large)
                             0.4)
      (+! title-row (mod-scale-px 10))
      (draw-string-xy-scaled "" global-buf title-x title-row (font-color yellow) (font-flags shadow kerning large) 1.0)))
  (none))

(defbehavior mod-global-countdown-proc process ()
  (loop
    (when (and (-> *MOD-countdown-bank* active?) (not (-> *MOD-countdown-bank* lost?)))
      ;; The countup timer always runs
      (let ((up-elapsed (- (current-time) (-> *MOD-countdown-bank* countup-last-update-time))))
        ;; Detect save/load time-warp
        (when (or (< up-elapsed 0) (> up-elapsed (seconds 10)))
          (set! up-elapsed 0))
        (when (> up-elapsed 0)
          (set! (-> *MOD-countdown-bank* countup-timer) (+ (-> *MOD-countdown-bank* countup-timer) up-elapsed)))
        (set! (-> *MOD-countdown-bank* countup-last-update-time) (current-time)))
      (cond
        ((or (global-countdown-paused?)
             (and *target*
                  (or (and (mod-rule-active? 'complication-eco-reserve) (= (-> *target* fact eco-type) (pickup-type eco-yellow)))
                      (and (mod-rule-active? 'complication-red-stop) (= (-> *target* fact eco-type) (pickup-type eco-red))))
                  (>= (-> *target* fact eco-level) 1.0)))
         (set! (-> *MOD-countdown-bank* last-update-time) (current-time)))
        (else
         (let ((elapsed (- (current-time) (-> *MOD-countdown-bank* last-update-time))))
           ;; Detect save/load time-warp
           (when (or (< elapsed 0) (> elapsed (seconds 10)))
             (set! elapsed 0))
           (when (> elapsed 0)
             (when (and *target*
                        (mod-rule-active? 'complication-quicksand)
                        (= (-> *target* control ground-pat material) (pat-material sand)))
               (set! elapsed (* elapsed 2)))
             (set! (-> *MOD-countdown-bank* remaining-time) (max 0 (- (-> *MOD-countdown-bank* remaining-time) elapsed))))
           (set! (-> *MOD-countdown-bank* last-update-time) (current-time))
           ;; Beep on second during the final 10 seconds
           (let ((whole-second (the int (/ (-> *MOD-countdown-bank* remaining-time) (seconds 1)))))
             (if (> whole-second 9)
               (set! (-> *MOD-countdown-bank* last-warn-second) -1)
               (when (and (>= whole-second 0) (!= whole-second (-> *MOD-countdown-bank* last-warn-second)))
                 (set! (-> *MOD-countdown-bank* last-warn-second) whole-second)
                 (sound-play "slider2001"))))
           (when (<= (-> *MOD-countdown-bank* remaining-time) 0)
             (format #t "COUNTDOWN: lost triggered~%")
             (mod-reset-run-and-restart))))))
    (mod-global-countdown-draw)
    (suspend))
  (none))

(defun mod-global-countdown-reset ()
  (kill-by-name 'global-countdown *active-pool*)
  (mod-rules-reset)
  (set! (-> *MOD-countdown-bank* active?) #f)
  (set! (-> *MOD-countdown-bank* lost?) #f)
  (set! (-> *MOD-countdown-bank* remaining-time)
        (the int (* (countdown-start-seconds-value) (the float TICKS_PER_SECOND)))) ;; global countdown start
  (set! (-> *MOD-countdown-bank* countup-timer) 0)
  (set! (-> *MOD-countdown-bank* last-update-time) (current-time))
  (set! (-> *MOD-countdown-bank* countup-last-update-time) (current-time))
  (set! (-> *MOD-rule-context-bank* last-update-time) (current-time))
  (none))

(defun mod-rng-reset-state! ()
  (set! (-> *MOD-rng-bank* content-state) (the uint 1))
  (set! (-> *MOD-rng-bank* punish-state) (the uint 1))
  (set! (-> *MOD-rng-bank* seed-display) (the uint 0))
  (none))

(defun mod-rng-reset-seed-display! ()
  (set! (-> *MOD-rng-bank* seed-display) (the uint 0))
  (none))

(defun mod-rule-context-reset! ()
  (set! (-> *MOD-rule-context-bank* twist-pending-count) -1)
  (set! (-> *MOD-rule-context-bank* twist-marked-slot) -1)
  (mod-rule-clear-recent-rolls)
  (mod-trivia-clear-used)
  (let ((i 0))
    (while (< i *mod-rule-slot-count*)
      (mod-rule-deactivate-slot i)
      (set! (-> (-> *MOD-rule-slot-bank* saved-remaining-times) i) -1)
      (set! (-> (-> *MOD-rule-slot-bank* saved-punishments) i) #f)
      (set! (-> (-> *MOD-rule-slot-bank* saved-pending) i) #f)
      (set! (-> (-> *MOD-rule-slot-bank* saved-roll-tenths) i) -1)
      (+! i 1)))
  (let ((i 0))
    (while (< i *mod-timed-punishment-slot-count*)
      (set! (-> (-> *MOD-punishment-bank* timed-saved-ids) i) #f)
      (set! (-> (-> *MOD-punishment-bank* timed-saved-tenths) i) -1)
      (+! i 1)))
  (set! (-> *MOD-rule-context-bank* palate-change-grace-until) 0)
  (none))

(defun mod-rule-index-from-id ((id symbol))
  (mod-symbol-index *mod-rule-ids* id))

(defun mod-punishment-index-from-id ((id symbol))
  (mod-symbol-index *mod-punishment-ids* id))

(defun mod-slot-punishments-save-value ()
  (mod-pack-symbols (-> *MOD-rule-slot-bank* slot-punishments) *mod-punishment-ids* *mod-rule-slot-count*))

(defun mod-slot-punishments-resume-from-save ((val int))
  (dotimes (slot *mod-rule-slot-count*)
    (set! (-> (-> *MOD-rule-slot-bank* saved-punishments) slot)
          (mod-unpack-symbol (the uint val) slot *mod-punishment-ids*)))
  (none))

(defun mod-rule-pending-slots-save-value ()
  (let ((result (the uint 0))
        (slot 0))
    (while (< slot *mod-rule-slot-count*)
      (let* ((pending (-> (-> *MOD-rule-slot-bank* pending-slots) slot))
             (idx (if pending (mod-rule-index-from-id pending) -1))
             (byte-val (cond
                         ((not pending) (the uint #xff))
                         ((eq? pending 'mod-rule-pending-roll) (the uint #xfe))
                         ((>= idx 0) (the uint idx))
                         (else (the uint #xff)))))
        (set! result (logior result (shl byte-val (* slot 8)))))
      (+! slot 1))
    (the int result)))

(defun mod-rule-pending-slots-resume-from-save ((val int))
  (let ((bits (the uint val))
        (slot 0))
    (while (< slot *mod-rule-slot-count*)
      (let ((idx (the int (logand (shr bits (* slot 8)) (the uint #xff)))))
        (set! (-> (-> *MOD-rule-slot-bank* saved-pending) slot)
              (cond
                ((= idx #xfe) 'mod-rule-pending-roll)
                ((= idx #xff) #f)
                (else (mod-rule-id-from-index idx)))))
      (+! slot 1)))
  (none))

(defun mod-rule-pending-times-save-value ()
  (let ((result (the uint 0))
        (slot 0))
    (while (< slot *mod-rule-slot-count*)
      (let ((remaining (if (-> (-> *MOD-rule-slot-bank* pending-slots) slot)
                         (max 0 (- (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot) (current-time)))
                         0)))
        (set! result
              (logior result
                      (shl (the uint (min #x3ff (/ (+ remaining (+ MOD_TICKS_PER_TENTH -1)) MOD_TICKS_PER_TENTH))) (* slot 10)))))
      (+! slot 1))
    (the int result)))

(defun mod-rule-pending-times-resume-from-save ((val int))
  (let ((bits (the uint val))
        (slot 0))
    (while (< slot *mod-rule-slot-count*)
      (set! (-> (-> *MOD-rule-slot-bank* saved-roll-tenths) slot) (the int (logand (shr bits (* slot 10)) (the uint #x3ff))))
      (+! slot 1)))
  (none))

(defun mod-rule-slot-progress-save-value ((group int))
  (let ((result (the uint 0))
        (start (* group 2))
        (offset 0))
    (while (< offset 2)
      (let ((slot (+ start offset)))
        (when (< slot *mod-rule-slot-count*)
          (set! result
                (logior result (shl (the uint (min #xffff (max 0 (-> (-> *MOD-rule-slot-bank* slot-progress) slot)))) (* offset 16)))))
        (+! offset 1)))
    (the int result)))

(defun mod-rule-slot-progress-resume-from-save ((group int) (val int))
  (let ((bits (the uint val))
        (start (* group 2))
        (offset 0))
    (while (< offset 2)
      (let ((slot (+ start offset)))
        (when (< slot *mod-rule-slot-count*)
          (set! (-> (-> *MOD-rule-slot-bank* slot-progress) slot) (the int (logand (shr bits (* offset 16)) (the uint #xffff)))))
        (+! offset 1))))
  (none))

(defmacro def-save-index-pair (save-name resume-name base-save-fn base-resume-fn index)
  `(begin
    (defun ,save-name ()
      (,base-save-fn ,index))
    (defun ,resume-name ((val int))
      (,base-resume-fn ,index val))))

(def-save-index-pair mod-rule-slot-progress0-save-value
                     mod-rule-slot-progress0-resume-from-save
                     mod-rule-slot-progress-save-value
                     mod-rule-slot-progress-resume-from-save
                     0)

(def-save-index-pair mod-rule-slot-progress1-save-value
                     mod-rule-slot-progress1-resume-from-save
                     mod-rule-slot-progress-save-value
                     mod-rule-slot-progress-resume-from-save
                     1)

(defun mod-math-quiz-state-save-value ()
  (the int
       (logior (the uint (-> *MOD-quiz-bank* math-val1))
               (shl (the uint (-> *MOD-quiz-bank* math-val2)) 8)
               (shl (the uint (-> *MOD-quiz-bank* math-op)) 16))))

(defun mod-math-quiz-state-resume-from-save ((val int))
  (let ((bits (the uint val)))
    (set! (-> *MOD-quiz-bank* math-val1) (the int (logand bits (the uint #xff))))
    (set! (-> *MOD-quiz-bank* math-val2) (the int (logand (shr bits 8) (the uint #xff))))
    (set! (-> *MOD-quiz-bank* math-op) (the int (logand (shr bits 16) (the uint #x3))))
    (mod-math-quiz-compute-answer!))
  (none))

(defun mod-math-quiz-guess-save-value ()
  (-> *MOD-quiz-bank* math-current-guess))

(defun mod-math-quiz-guess-resume-from-save ((val int))
  (set! (-> *MOD-quiz-bank* math-current-guess) val)
  (none))

(defun mod-trivia-state-save-value ()
  (the int
       (logior (the uint (-> *MOD-quiz-bank* trivia-current-question))
               (shl (the uint (+ (-> *MOD-quiz-bank* trivia-current-guess) 1)) 8)
               (shl (the uint (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 0)) 11)
               (shl (the uint (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 1)) 13)
               (shl (the uint (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 2)) 15)
               (shl (the uint (-> (-> *MOD-quiz-bank* trivia-shuffle-map) 3)) 17)
               (shl (the uint (-> *MOD-quiz-bank* trivia-dynamic-seed)) 19))))

(defun mod-trivia-state-resume-from-save ((val int))
  (let ((bits (the uint val)))
    (set! (-> *MOD-quiz-bank* trivia-current-question) (the int (logand bits (the uint #xff))))
    (set! (-> *MOD-quiz-bank* trivia-current-guess) (- (the int (logand (shr bits 8) (the uint #x7))) 1))
    (dotimes (i 4)
      (set! (-> (-> *MOD-quiz-bank* trivia-shuffle-map) i) (the int (logand (shr bits (+ 11 (* i 2))) (the uint #x3)))))
    (set! (-> *MOD-quiz-bank* trivia-dynamic-seed) (the int (logand (shr bits 19) (the uint #xfff))))
    (set! (-> *MOD-quiz-bank* trivia-last-tracked-question) (-> *MOD-quiz-bank* trivia-current-question)))
  (none))

(defun mod-rule-qte-state-save-value ()
  (-> *MOD-rule-context-bank* qte-target-button))

(defun mod-rule-qte-state-resume-from-save ((val int))
  (set! (-> *MOD-rule-context-bank* qte-target-button) val)
  (none))

(defun mod-timed-punishments-save-value ()
  (mod-pack-symbols (-> *MOD-punishment-bank* timed-punishments)
                    *mod-punishment-ids*
                    *mod-timed-punishment-slot-count*))

(defun mod-timed-punishment-times-save-value ((group int))
  (let ((result (the uint 0))
        (start (* group 4))
        (offset 0))
    (while (< offset 4)
      (let ((slot (+ start offset)))
        (when (< slot *mod-timed-punishment-slot-count*)
          (let ((remaining (if (-> (-> *MOD-punishment-bank* timed-punishments) slot)
                             (max 0 (- (-> (-> *MOD-punishment-bank* timed-end-times) slot) (current-time)))
                             0)))
            (set! result
                  (logior result
                          (shl (the uint (min #xffff (/ (+ remaining (+ MOD_TICKS_PER_TENTH -1)) MOD_TICKS_PER_TENTH))) (* offset 16)))))))
      (+! offset 1))
    (the int result)))

(defun mod-timed-punishments-resume-from-save ((val int))
  (let* ((bits (the uint val))
         (legacy? (zero? (shr bits 32)))
         (empty-val (if legacy? #xf #xff))
         (slot 0))
    (while (< slot *mod-timed-punishment-slot-count*)
      (let ((idx (if legacy? (the int (logand (shr bits (* slot 4)) (the uint #xf))) (the int (logand (shr bits (* slot 8)) (the uint #xff))))))
        (set! (-> (-> *MOD-punishment-bank* timed-saved-ids) slot)
              (if (= idx empty-val) #f (mod-punishment-id-from-index idx))))
      (+! slot 1)))
  (none))

(defun mod-timed-punishment-times-resume-from-save ((group int) (val int))
  (let ((bits (the uint val))
        (start (* group 4))
        (offset 0))
    (while (< offset 4)
      (let ((slot (+ start offset)))
        (when (< slot *mod-timed-punishment-slot-count*)
          (set! (-> (-> *MOD-punishment-bank* timed-saved-tenths) slot)
                (the int (logand (shr bits (* offset 16)) (the uint #xffff)))))
        (+! offset 1))))
  (none))

(def-save-index-pair mod-rule-timed-punishment-times0-save-value
                     mod-rule-timed-punishment-times0-resume-from-save
                     mod-timed-punishment-times-save-value
                     mod-timed-punishment-times-resume-from-save
                     0)

(def-save-index-pair mod-rule-timed-punishment-times1-save-value
                     mod-rule-timed-punishment-times1-resume-from-save
                     mod-timed-punishment-times-save-value
                     mod-timed-punishment-times-resume-from-save
                     1)

(defun mod-rule-active-slots-save-value ()
  (mod-pack-symbols (-> *MOD-rule-slot-bank* active-slots) *mod-rule-ids* *mod-rule-slot-count*))

(defun mod-rule-slot-remaining-time-save-value ((slot int))
  (if (-> (-> *MOD-rule-slot-bank* active-slots) slot)
    (the int (max 0 (- (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (current-time))))
    0))

(defun mod-rule-slot-remaining-time-resume-from-save ((slot int) (val int))
  (set! (-> (-> *MOD-rule-slot-bank* saved-remaining-times) slot) (max 0 val))
  (none))

(def-save-index-pair mod-rule-slot0-end-time-save-value
                     mod-rule-slot0-end-time-resume-from-save
                     mod-rule-slot-remaining-time-save-value
                     mod-rule-slot-remaining-time-resume-from-save
                     0)

(def-save-index-pair mod-rule-slot1-end-time-save-value
                     mod-rule-slot1-end-time-resume-from-save
                     mod-rule-slot-remaining-time-save-value
                     mod-rule-slot-remaining-time-resume-from-save
                     1)

(def-save-index-pair mod-rule-slot2-end-time-save-value
                     mod-rule-slot2-end-time-resume-from-save
                     mod-rule-slot-remaining-time-save-value
                     mod-rule-slot-remaining-time-resume-from-save
                     2)

(defun mod-finalize-resume-from-save ()
  (dotimes (slot *mod-rule-slot-count*)
    (let ((remaining (-> (-> *MOD-rule-slot-bank* saved-remaining-times) slot)))
      (when (-> (-> *MOD-rule-slot-bank* active-slots) slot)
        (set! (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (+ (current-time) (if (>= remaining 0) remaining 0)))
        (set! (-> (-> *MOD-rule-slot-bank* slot-goals) slot)
              (mod-rule-counter-goal (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
        (set! (-> (-> *MOD-rule-slot-bank* slot-punishments) slot) (-> (-> *MOD-rule-slot-bank* saved-punishments) slot)))))
  (dotimes (slot *mod-rule-slot-count*)
    (let ((pending (-> (-> *MOD-rule-slot-bank* saved-pending) slot))
          (tenths (-> (-> *MOD-rule-slot-bank* saved-roll-tenths) slot)))
      (when pending
        (set! (-> (-> *MOD-rule-slot-bank* pending-slots) slot) pending)
        (set! (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot) (+ (current-time) (* (max 0 tenths) MOD_TICKS_PER_TENTH)))
        (set! (-> (-> *MOD-rule-slot-bank* roll-last-warn-second) slot) -1))))
  (mod-clear-all-timed-punishments)
  (dotimes (slot *mod-timed-punishment-slot-count*)
    (let ((punishment (-> (-> *MOD-punishment-bank* timed-saved-ids) slot))
          (tenths (-> (-> *MOD-punishment-bank* timed-saved-tenths) slot)))
      (when (and punishment (> tenths 0))
        (set! (-> (-> *MOD-punishment-bank* timed-punishments) slot) punishment)
        (set! (-> (-> *MOD-punishment-bank* timed-end-times) slot) (+ (current-time) (* tenths MOD_TICKS_PER_TENTH)))
        (set! (-> (-> *MOD-punishment-bank* timed-next-ticks) slot) (+ (current-time) (seconds 1)))
        (case punishment
          (('punishment-blind) (set-blackout-frames (* tenths MOD_TICKS_PER_TENTH)))
          (('punishment-fall-damage) (mod-set-punished-fall-damage!))
          (('punishment-delay) (input-delay-enable! #t (-> *MOD-tuning-bank* punishment-input-delay)))
          (('punishment-iframes) (set! (-> *TARGET-bank* hit-invulnerable-timeout) (seconds 0)))))))
  (set! (-> *MOD-rule-context-bank* last-update-time) (current-time))
  (none))

(defun mod-rule-active-slots-resume-from-save ((val int))
  (dotimes (i *mod-rule-slot-count*)
    (mod-rule-deactivate-slot i))
  (dotimes (i *mod-rule-slot-count*)
    (let ((id (mod-unpack-symbol (the uint val) i *mod-rule-ids*)))
      (set! (-> (-> *MOD-rule-slot-bank* active-slots) i) id)
      (when id
        (mod-rule-reapply-slot-visual-effect id))))
  (none))

