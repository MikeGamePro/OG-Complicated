(defun mod-rule-id-from-index ((idx int))
  (if (and (>= idx 0) (< idx (-> *mod-rule-ids* length))) (-> *mod-rule-ids* idx) #f))

(defun mod-rule-punishment-id-from-index ((idx int))
  (if (and (>= idx 0) (< idx *mod-rule-punishment-id-count*)) (-> *mod-rule-punishment-ids* idx) #f))

(defun mod-rule-enabled-condition-count ()
  (let ((count 0))
    (dotimes (i *mod-rule-id-count*)
      (when (mod-rule-condition-enabled? (mod-rule-id-from-index i))
        (+! count 1)))
    count))

(defun mod-rule-enabled-condition-fraction ()
  (/ (the float (mod-rule-enabled-condition-count)) (the float *mod-rule-id-count*)))

(defun mod-rule-punishment-toggle-enabled-count ()
  (let ((count 0))
    (dotimes (i *mod-rule-punishment-id-count*)
      (let ((id (mod-rule-punishment-id-from-index i))) (when (punishment-toggle-enabled? id) (+! count 1))))
    count))

(defun mod-rule-punishment-toggle-enabled-fraction ()
  (/ (the float (mod-rule-punishment-toggle-enabled-count)) (the float (- *mod-rule-punishment-id-count* 1))))

(define SCORE-MAX-INC 35780.0)

(define SCORE-TIME-SCALE 5400.0)

(defun mod-rule-collectable-inc-total ()
  (+ (* 101.0 (cell-increment-value)) (* 2000.0 (orb-increment-value)) (* 112.0 (fly-increment-value))))

(defun mod-rule-inc-total ()
  (+ (mod-rule-collectable-inc-total) (countdown-start-seconds-value)))

(defun mod-calc-run-score ()
  (let* ((inc-total (mod-rule-inc-total))
         (inc-norm (/ inc-total SCORE-MAX-INC))
         (final-time-seconds (/ (the float (-> *MOD-stats-bank* final-time)) (the float TICKS_PER_SECOND)))
         (time-factor (/ SCORE-TIME-SCALE (+ SCORE-TIME-SCALE final-time-seconds)))
         (raw-mult (fmax 0.01 (time-limit-multiplier)))
         (max-score 100000.0)
         (mult-weight 0.0175)
         (time-weight 0.2)
         (score-weight 0.8)
         (conditions-weight 0.055)
         (punishments-weight 0.012)
         (effective-mult (+ 1.0 (* (- raw-mult 1.0) mult-weight)))
         (effective-conditions-mult (+ 1.0 (* (- 1.0 (mod-rule-enabled-condition-fraction)) conditions-weight)))
         (effective-punishments-mult (+ 1.0 (* (- 1.0 (mod-rule-punishment-toggle-enabled-fraction)) punishments-weight)))
         (score 0.0))
    (set! inc-norm (fmax 0.0 (fmin 1.0 inc-norm)))
    (let ((base-score (* max-score (+ (* time-weight time-factor) (* score-weight (- 1.0 inc-norm))))))
      (set! score (/ (/ (/ base-score effective-mult) effective-conditions-mult) effective-punishments-mult)))
    (format #t
            "mod-score: inc-total ~f inc-norm ~f final-time-s ~f time-factor ~f "
            inc-total
            inc-norm
            final-time-seconds
            time-factor)
    (format #t
            "eff-mult ~f eff-cond-mult ~f eff-punish-mult ~f score ~f~%"
            effective-mult
            effective-conditions-mult
            effective-punishments-mult
            score)
    score))

(defun mod-game-beaten-resume-from-save ((value int))
  (set! (-> *MOD-rule-context-bank* game-beaten?) (not (= value 0)))
  (none))

(defun mod-game-beaten-save-value ()
  (if (-> *MOD-rule-context-bank* game-beaten?) 1 0))

;; mod: setter used by other files (e.g. robotboss.gc, game-save.gc) so they
;; never touch *MOD-rule-context-bank* directly.
(defun mod-game-beaten-set! ((val symbol))
  (set! (-> *MOD-rule-context-bank* game-beaten?) val)
  (none))

;; mod: called by robotboss.gc when the final white eco is picked up, so it
;; never touches *MOD-countdown-bank*/*MOD-stats-bank* directly.
(defun mod-rule-finalize-run-stats! ()
  (set! (-> *MOD-stats-bank* final-remaining-time) (-> *MOD-countdown-bank* remaining-time))
  (set! (-> *MOD-stats-bank* final-time) (-> *MOD-countdown-bank* countup-timer))
  (set! (-> *MOD-stats-bank* final-score) (the int (mod-calc-run-score)))
  (none))

(defun final-time-save-value ()
  (-> *MOD-stats-bank* final-time))

(defun final-time-resume-from-save ((value int))
  (set! (-> *MOD-stats-bank* final-time) value)
  (none))

(defun final-remaining-time-save-value ()
  (-> *MOD-stats-bank* final-remaining-time))

(defun final-remaining-time-resume-from-save ((value int))
  (set! (-> *MOD-stats-bank* final-remaining-time) value)
  (none))

(defun final-score-save-value ()
  (-> *MOD-stats-bank* final-score))

(defun final-score-resume-from-save ((value int))
  (set! (-> *MOD-stats-bank* final-score) value)
  (none))

(defun mod-stats-reset! ()
  (set! (-> *MOD-stats-bank* rules-rolled) 0)
  (set! (-> *MOD-stats-bank* rules-broken) 0)
  (set! (-> *MOD-stats-bank* rules-followed) 0)
  (set! (-> *MOD-stats-bank* complications-rolled) 0)
  (set! (-> *MOD-stats-bank* final-time) 0)
  (set! (-> *MOD-stats-bank* final-remaining-time) 0)
  (set! (-> *MOD-stats-bank* final-score) 0)
  (set! (-> *MOD-rule-context-bank* game-beaten?) #f)
  (none))

(defun mod-stats-rules-rolled-save-value ()
  (-> *MOD-stats-bank* rules-rolled))

(defun mod-stats-rules-rolled-resume-from-save ((value int))
  (set! (-> *MOD-stats-bank* rules-rolled) value)
  (none))

(defun mod-stats-rules-broken-save-value ()
  (-> *MOD-stats-bank* rules-broken))

(defun mod-stats-rules-broken-resume-from-save ((value int))
  (set! (-> *MOD-stats-bank* rules-broken) value)
  (none))

(defun mod-stats-rules-followed-save-value ()
  (-> *MOD-stats-bank* rules-followed))

(defun mod-stats-rules-followed-resume-from-save ((value int))
  (set! (-> *MOD-stats-bank* rules-followed) value)
  (none))

(defun mod-stats-complications-rolled-save-value ()
  (-> *MOD-stats-bank* complications-rolled))

(defun mod-stats-complications-rolled-resume-from-save ((value int))
  (set! (-> *MOD-stats-bank* complications-rolled) value)
  (none))

(defun mod-rule-countdown-punishment-seconds ()
  (let* ((scaled (* (-> *MOD-tuning-bank* countdown-punishment-baseline-seconds)
                    (/ (mod-rule-collectable-inc-total) (-> *MOD-tuning-bank* countdown-punishment-baseline-inc-total))))
         (rounded (* (the int (/ (+ scaled 2.5) 5.0)) 5)))
    (max 5 rounded)))

(defun mod-rule-countdown-punishment-ticks ()
  (the int (* (the float (mod-rule-countdown-punishment-seconds)) (the float TICKS_PER_SECOND))))

