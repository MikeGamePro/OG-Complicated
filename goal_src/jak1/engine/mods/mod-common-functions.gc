(defun mod-countdown-punishment-seconds ()
  (let* ((scaled (* (-> *MOD-tuning-bank* countdown-punishment-baseline-seconds)
                    (/ (mod-collectable-inc-total) (-> *MOD-tuning-bank* countdown-punishment-baseline-inc-total))))
         (rounded (* (the int (/ (+ scaled 2.5) 5.0)) 5)))
    (max 5 rounded)))

(defun mod-countdown-punishment-ticks ()
  (the int (* (the float (mod-countdown-punishment-seconds)) (the float TICKS_PER_SECOND))))

(defun mod-cell-blocked? ()
  (the symbol
       (or (mod-rule-active? 'complication-fuel-shortage)
           (and (mod-target-on-flut?) (mod-rule-active? 'complication-wings-tied))
           (and *target* (> (-> (the-as fact-info-target (-> *target* fact)) health) 1.0) (mod-rule-active? 'complication-critical)))))

(defun mod-cell-price-task ()
  (if (mod-rule-active? 'complication-half-price) (/ (-> *GAME-bank* money-task-inc) 2.0) (-> *GAME-bank* money-task-inc)))

(defun mod-cell-price-oracle ()
  (if (mod-rule-active? 'complication-half-price) (/ (-> *GAME-bank* money-oracle-inc) 2.0) (-> *GAME-bank* money-oracle-inc)))

(defun mod-trade-hint-task ()
