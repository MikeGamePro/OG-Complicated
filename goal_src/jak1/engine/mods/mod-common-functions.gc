;; True if every villager trade for this level group is already done.
(defun mod-villagers-closed? ((level symbol))
  (cond
    ((or (eq? level 'village1) (eq? level 'beach))
     (and (task-closed? (game-task village1-mayor-money) (task-status need-resolution))
          (task-closed? (game-task village1-uncle-money) (task-status need-resolution))))
    ((or (eq? level 'village2) (eq? level 'rolling))
     (and (task-closed? (game-task village2-gambler-money) (task-status need-resolution))
          (task-closed? (game-task village2-geologist-money) (task-status need-resolution))
          (task-closed? (game-task village2-warrior-money) (task-status need-resolution))))
    ((eq? level 'village3)
     (and (task-closed? (game-task village3-miner-money1) (task-status need-resolution))
          (task-closed? (game-task village3-miner-money2) (task-status need-resolution))
          (task-closed? (game-task village3-miner-money3) (task-status need-resolution))
          (task-closed? (game-task village3-miner-money4) (task-status need-resolution))))
    (else #f)))

;; True if every oracle trade for this level group is already done.
(defun mod-oracles-closed? ((level symbol))
  (cond
    ((or (eq? level 'village1) (eq? level 'beach))
     (and (task-closed? (game-task village1-oracle-money1) (task-status need-resolution))
          (task-closed? (game-task village1-oracle-money2) (task-status need-resolution))))
    ((or (eq? level 'village2) (eq? level 'rolling))
     (and (task-closed? (game-task village2-oracle-money1) (task-status need-resolution))
          (task-closed? (game-task village2-oracle-money2) (task-status need-resolution))))
    ((eq? level 'village3)
     (and (task-closed? (game-task village3-oracle-money1) (task-status need-resolution))
          (task-closed? (game-task village3-oracle-money2) (task-status need-resolution))))
    (else #f)))

;; Integer avalanche hash; scrambles a uint into a well-mixed one.
(defun mod-rng-hash-u32 ((x uint))
  (set! x (logxor x (shr x 16)))
  (set! x (* x (the uint #x7feb352d)))
  (set! x (logxor x (shr x 15)))
  (set! x (* x (the uint #x846ca68b)))
  (set! x (logxor x (shr x 16)))
  x)

(defun mod-rng-random-seed ()
  (mod-rng-hash-u32 (the uint (current-time))))

(defun mod-rng-active-seed ()
  (let ((imgui-seed (the uint (complicated-get-seed))))
    (if (!= imgui-seed 0) (logand imgui-seed (the uint #x7fffffff)) (logand (mod-rng-random-seed) (the uint #x7fffffff)))))

;; Derive the two RNG stream states (content and punishment) from one master seed. Never leaves a state at 0.
(defun mod-rng-seed-all! ((master-seed uint))
  (let ((content-hash (mod-rng-hash-u32 (+ master-seed (the uint 1))))
        (punish-hash (mod-rng-hash-u32 (+ master-seed (the uint 2)))))
    (set! (-> *MOD-rng-bank* content-state) (if (= content-hash 0) (the uint 1) content-hash))
    (set! (-> *MOD-rng-bank* punish-state) (if (= punish-hash 0) (the uint 1) punish-hash)))
  (none))

;; Advance the content RNG one xorshift32 step. Content (rule rolls, quizzes) and punishment use
;; separate streams so one can't disturb the other.
(defun mod-rng-content-next-u32 ()
  (let ((x (-> *MOD-rng-bank* content-state)))
    (set! x (logxor x (shl x 13)))
    (set! x (logxor x (shr x 17)))
    (set! x (logxor x (shl x 5)))
    (set! (-> *MOD-rng-bank* content-state) x)
    x))

(defun mod-rng-punish-next-u32 ()
  (let ((x (-> *MOD-rng-bank* punish-state)))
    (set! x (logxor x (shl x 13)))
    (set! x (logxor x (shr x 17)))
    (set! x (logxor x (shl x 5)))
    (set! (-> *MOD-rng-bank* punish-state) x)
    x))

(defun mod-rand-int-range ((lo int) (hi int))
  (let* ((bound (the uint (- hi lo)))
         (threshold (mod (- (the uint 0) bound) bound))
         (r (mod-rng-content-next-u32)))
    (while (< r threshold)
      (set! r (mod-rng-content-next-u32)))
    (+ lo (the int (mod r bound)))))

;; Same as mod-rand-int-range but uses the punishment stream.
(defun mod-rand-punish-int-range ((lo int) (hi int))
  (let* ((bound (the uint (- hi lo)))
         (threshold (mod (- (the uint 0) bound) bound))
         (r (mod-rng-punish-next-u32)))
    (while (< r threshold)
      (set! r (mod-rng-punish-next-u32)))
    (+ lo (the int (mod r bound)))))

(defun mod-rand-float-range ((lo float) (hi float))
  (let ((r (logand (mod-rng-content-next-u32) (the uint #x7fffffff))))
    (+ lo (* (- hi lo) (/ (the float r) 2147483648.0)))))
