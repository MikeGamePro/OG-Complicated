  (set! (-> *MOD-rng-bank* seed-display) (the uint val))
  (none))

(defun mod-rule-recent-rolls-save-value ()
  (mod-pack-symbols *mod-rule-recent-rolls* *mod-rule-ids* 8))

(defun mod-rule-recent-rolls-resume-from-save ((val int))
  (dotimes (i 8)
    (set! (-> *mod-rule-recent-rolls* i) (mod-unpack-symbol (the uint val) i *mod-rule-ids*)))
  (none))

(defun mod-rule-twist-pending-count-save-value ()
  (-> *MOD-rule-context-bank* twist-pending-count))

(defun mod-rule-twist-pending-count-resume-from-save ((val int))
