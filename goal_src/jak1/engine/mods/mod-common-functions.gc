(defun mod-rule-timed-punishments-save-value ()
  (let ((result (the uint 0))
        (slot 0))
    (while (< slot *mod-rule-timed-punishment-slot-count*)
      (let* ((punishment (-> (-> *MOD-rule-punishment-bank* timed-punishments) slot))
             (idx (if punishment (mod-rule-punishment-index-from-id punishment) -1))
             (nibble-val (if (>= idx 0) (the uint idx) (the uint #xf))))
        (set! result (logior result (shl nibble-val (* slot 4)))))
      (+! slot 1))
    (the int result)))

(defun mod-rule-timed-punishment-times-save-value ((group int))
  (let ((result (the uint 0))
        (start (* group 4))
        (offset 0))
    (while (< offset 4)
      (let ((slot (+ start offset)))
        (when (< slot *mod-rule-timed-punishment-slot-count*)
          (let ((remaining (if (-> (-> *MOD-rule-punishment-bank* timed-punishments) slot)
                             (max 0 (- (-> (-> *MOD-rule-punishment-bank* timed-end-times) slot) (current-time)))
                             0)))
            (set! result (logior result (shl (the uint (min #xffff (/ (+ remaining 29) 30))) (* offset 16)))))))
      (+! offset 1))
    (the int result)))

(defun mod-rule-timed-punishments-resume-from-save ((val int))
  (let ((bits (the uint val))
        (slot 0))
    (while (< slot *mod-rule-timed-punishment-slot-count*)
      (let ((idx (the int (logand (shr bits (* slot 4)) (the uint #xf)))))
        (set! (-> (-> *MOD-rule-punishment-bank* timed-saved-ids) slot)
              (if (= idx #xf) #f (mod-rule-punishment-id-from-index idx))))
      (+! slot 1)))
  (none))

(defun mod-rule-timed-punishment-times-resume-from-save ((group int) (val int))
  (let ((bits (the uint val))
        (start (* group 4))
        (offset 0))
    (while (< offset 4)
      (let ((slot (+ start offset)))
        (when (< slot *mod-rule-timed-punishment-slot-count*)
          (set! (-> (-> *MOD-rule-punishment-bank* timed-saved-tenths) slot)
                (the int (logand (shr bits (* offset 16)) (the uint #xffff)))))
        (+! offset 1))))
  (none))

(def-save-index-pair mod-rule-timed-punishment-times0-save-value
                     mod-rule-timed-punishment-times0-resume-from-save
                     mod-rule-timed-punishment-times-save-value
                     mod-rule-timed-punishment-times-resume-from-save
                     0)

(def-save-index-pair mod-rule-timed-punishment-times1-save-value
                     mod-rule-timed-punishment-times1-resume-from-save
                     mod-rule-timed-punishment-times-save-value
                     mod-rule-timed-punishment-times-resume-from-save
                     1)

(defun mod-rule-active-slots-save-value ()
  (let ((result (the uint 0))
        (i 0))
    (while (< i *mod-rule-slot-count*)
      (let* ((sym (-> (-> *MOD-rule-slot-bank* active-slots) i))
             (idx (if sym (mod-rule-index-from-id sym) -1))
             (byte-val (if (>= idx 0) (the uint idx) (the uint #xff))))
        (set! result (logior result (shl byte-val (* i 8)))))
      (+! i 1))
    (the int result)))

(defun mod-rule-slot-remaining-time-save-value ((slot int))
  (if (-> (-> *MOD-rule-slot-bank* active-slots) slot)
    (the int (max 0 (- (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (current-time))))
    0))

(defun mod-rule-slot-remaining-time-resume-from-save ((slot int) (val int))
  (set! (-> (-> *MOD-rule-slot-bank* saved-remaining-times) slot) (max 0 val))
  (none))

(def-save-index-pair mod-rule-slot0-end-time-save-value
                     mod-rule-slot0-end-time-resume-from-save
                     mod-rule-slot-remaining-time-save-value
                     mod-rule-slot-remaining-time-resume-from-save
                     0)

(def-save-index-pair mod-rule-slot1-end-time-save-value
                     mod-rule-slot1-end-time-resume-from-save
                     mod-rule-slot-remaining-time-save-value
                     mod-rule-slot-remaining-time-resume-from-save
                     1)

(def-save-index-pair mod-rule-slot2-end-time-save-value
                     mod-rule-slot2-end-time-resume-from-save
                     mod-rule-slot-remaining-time-save-value
                     mod-rule-slot-remaining-time-resume-from-save
                     2)

(defun mod-rule-finalize-resume-from-save ()
  (dotimes (slot *mod-rule-slot-count*)
    (let ((remaining (-> (-> *MOD-rule-slot-bank* saved-remaining-times) slot)))
      (when (-> (-> *MOD-rule-slot-bank* active-slots) slot)
        (set! (-> (-> *MOD-rule-slot-bank* slot-end-times) slot) (+ (current-time) (if (>= remaining 0) remaining 0)))
        (set! (-> (-> *MOD-rule-slot-bank* slot-goals) slot)
              (mod-rule-counter-goal (-> (-> *MOD-rule-slot-bank* active-slots) slot)))
        (set! (-> (-> *MOD-rule-slot-bank* slot-punishments) slot) (-> (-> *MOD-rule-slot-bank* saved-punishments) slot)))))
  (dotimes (slot *mod-rule-slot-count*)
    (let ((pending (-> (-> *MOD-rule-slot-bank* saved-pending) slot))
          (tenths (-> (-> *MOD-rule-slot-bank* saved-roll-tenths) slot)))
      (when pending
        (set! (-> (-> *MOD-rule-slot-bank* pending-slots) slot) pending)
        (set! (-> (-> *MOD-rule-slot-bank* roll-ready-times) slot) (+ (current-time) (* (max 0 tenths) 30)))
        (set! (-> (-> *MOD-rule-slot-bank* roll-last-warn-second) slot) -1))))
  (mod-rule-clear-all-timed-punishments)
  (dotimes (slot *mod-rule-timed-punishment-slot-count*)
    (let ((punishment (-> (-> *MOD-rule-punishment-bank* timed-saved-ids) slot))
          (tenths (-> (-> *MOD-rule-punishment-bank* timed-saved-tenths) slot)))
      (when (and punishment (> tenths 0))
        (set! (-> (-> *MOD-rule-punishment-bank* timed-punishments) slot) punishment)
        (set! (-> (-> *MOD-rule-punishment-bank* timed-end-times) slot) (+ (current-time) (* tenths 30)))
        (set! (-> (-> *MOD-rule-punishment-bank* timed-next-ticks) slot) (+ (current-time) (seconds 1)))
        (case punishment
          (('punishment-blind) (set-blackout-frames (* tenths 30)))
          (('punishment-fall-damage)
           (set! (-> *TARGET-bank* fall-far) (meters 7.0))
           (set! (-> *TARGET-bank* fall-far-inc) (meters 10.0)))
          (('punishment-delay) (input-delay-enable! #t 0.2))
          (('punishment-iframes) (set! (-> *TARGET-bank* hit-invulnerable-timeout) (seconds 0)))))))
  (set! (-> *MOD-rule-context-bank* last-update-time) (current-time))
  (none))

(defun mod-rule-active-slots-resume-from-save ((val int))
  (let ((i 0)) (while (< i *mod-rule-slot-count*) (mod-rule-deactivate-slot i) (+! i 1)))
  (let ((bits (the uint val))
        (i 0))
    (while (< i *mod-rule-slot-count*)
      (let* ((byte-val (logand (shr bits (* i 8)) (the uint #xff)))
             (id (if (= byte-val (the uint #xff)) #f (mod-rule-id-from-index (the int byte-val)))))
        (set! (-> (-> *MOD-rule-slot-bank* active-slots) i) id)
        (when id
          (mod-rule-reapply-slot-visual-effect id)))
      (+! i 1)))
  (none))

