;;-*-Lisp-*-
(in-package goal)

;;

(defun mod-level-display-name ((level symbol))
  (case level
    (('training) "GEYSER ROCK")
    (('village1) "SANDOVER VILLAGE")
    (('beach) "SENTINEL BEACH")
    (('jungle) "FORBIDDEN JUNGLE")
    (('jungleb) "JUNGLE TEMPLE")
    (('misty) "MISTY ISLAND")
    (('firecanyon) "FIRE CANYON")
    (('village2) "ROCK VILLAGE")
    (('sunken 'sunkenb) "LOST PRECURSOR CITY")
    (('swamp) "BOGGY SWAMP")
    (('rolling) "PRECUROR BASIN")
    (('ogre) "MOUNTAIN PASS")
    (('village3) "VOLCANIC CRATER")
    (('snow) "SNOWY MOUNTAIN")
    (('maincave) "MAIN CAVE")
    (('robocave) "ROBOT ROOM")
    (('darkcave) "DARK CAVE")
    (('lavatube) "LAVA TUBE")
    (('citadel) "CITADEL")
    (('finalboss) "FINAL BOSS")
    (else "UNKNOWN")))

(defun mod-rule-description ((id symbol))
  (cond
    ((eq? id 'rule-grounded) "DO NOT JUMP.")
    ((eq? id 'rule-management) "DO NOT PUNCH.")
    ((eq? id 'rule-die) "KILL HIM. KILL HIM NOW.")
    ((eq? id 'rule-lurker-pressure) "KILL 6 LURKERS.")
    ((eq? id 'rule-hitlist) "KILL 3 UNIQUE LURKER TYPES.")
    ((eq? id 'rule-double-kill) "KILL 2 LURKERS AT THE SAME TIME.")
    ((eq? id 'rule-sniper) "KILL A LURKER FROM AT LEAST 70 METERS AWAY.")
    ((eq? id 'rule-crate-break) "BREAK 5 CRATES.")
    ((eq? id 'rule-money-pressure) "COLLECT 20 ORBS.")
    ((eq? id 'rule-fuel-pressure) "COLLECT A POWER CELL.")
    ((eq? id 'rule-buzzer-pressure) "COLLECT A SCOUT FLY.")
    ((eq? id 'rule-flop-this) "LURKERS MAY ONLY BE KILLED WITH GROUND POUNDS.")
    ((eq? id 'complication-brittle-bones) "EVERY JUMP HAS A 10% CHANCE TO DAMAGE YOU.")
    ((eq? id 'complication-rotten-eggs) "ORBS KILL YOU.")
    ((eq? id 'complication-eco-allergy) "ECO DAMAGES YOU.")
    ((eq? id 'rule-keep-it-low) "DO NOT JUMP KICK.")
    ((eq? id 'complication-sizeable) "ROLLJUMPS COST 2 ORBS.")
    ((eq? id 'complication-cumbersome) "ORBS WEIGH JAK DOWN.")
    ((eq? id 'complication-heating-balloons) "COOLING BALLOONS MELT YOU.")
    ((eq? id 'complication-drought) "ALL WATER, LAVA, AND DARK ECO ARE GONE.")
    ((eq? id 'complication-ohko) "JAK IS LIMITED TO ONE HEALTH.")
    ((eq? id 'complication-critical) "CELLS CAN ONLY BE COLLECTED AT ONE HEALTH.")
    ((eq? id 'complication-glare) "JAK FREEZES WHEN LURKERS SEE HIM.")
    ((eq? id 'complication-disassociate) "KILLING A LURKER DISMOUNTS FLUT FLUT.")
    ((eq? id 'complication-bus-driver) "ZOOMER EXPLODES IF TOO SLOW.")
    ((eq? id 'complication-fuel-shortage) "ALL POWER CELLS ARE GONE.")
    ((eq? id 'complication-hidden-treasure) "ORBS ARE INVISIBLE.")
    ((eq? id 'complication-wings-tied) "YOU CANNOT COLLECT CELLS WHILE ON FLUT FLUT.")
    ((eq? id 'complication-jak-rabbit) "JUMP HEIGHTS ARE DOUBLED.")
    ((eq? id 'rule-vendetta) "KILL A LURKER WITH RED ECO.")
    ((eq? id 'rule-hands-on) "CRATES MAY ONLY BE BROKEN BY DIRECT CONTACT FROM JAK.")
    ((eq? id 'rule-survivor) "STAY ALIVE.")
    ((eq? id 'complication-eco-reserve) "YELLOW ECO PAUSES TIMER.")
    ((eq? id 'complication-red-stop) "RED ECO PAUSES TIMER.")
    ((eq? id 'rule-one-frame) "DO A ONE-FRAME.")
    ((eq? id 'rule-distancing) "DO NOT GET WITHIN 8 METERS OF A SCOUT FLY.")
    ((eq? id 'rule-red-light) "DO NOT MOVE.")
    ((eq? id 'complication-rgyb) "BLUE AND YELLOW ECO ARE SWAPPED.")
    ((eq? id 'complication-butter-fingers) "JAK CANNOT GRAB LEDGES.")
    ((eq? id 'rule-for-billy) "PROTECT FARTHY\c12S SNACKS. DO NOT LEAVE BOGGY SWAMP.")
    ((eq? id 'rule-cold-feet) "KEEP OFF THE ICE.")
    ((eq? id 'complication-overclock) "CITADEL DISCS ARE FASTER.")
    ((eq? id 'rule-speed) "REACH A SPEED OF 40 METERS PER SECOND.")
    ((eq? id 'rule-math-quiz) "ANSWER CORRECTLY.       (USE D-PAD)")
    ((eq? id 'rule-trivia) "ANSWER CORRECTLY.")
    ((eq? id 'complication-bad-ping)
     (string-format "YOU HAVE ~D-MS INPUT DELAY." (mod-seconds->ms (-> *MOD-tuning-bank* bad-ping-input-delay))))
    ((eq? id 'rule-green-pilled) "INCREASE YOUR HEALTH WITH GREEN ECO.")
    ((eq? id 'rule-button-pusher) "PUSH A BUTTON.")
    ((eq? id 'rule-loyal-customer) "BUY AN ORACLE CELL.")
    ((eq? id 'complication-invisible-man) "JAK IS INVISIBLE.")
    ((eq? id 'rule-cooked) "BURN JAK.")
    ((eq? id 'complication-joyride) "HEY! THERE\c12S THE FLUT-FLUT!")
    ((eq? id 'rule-sagging-sails) "MISS 3 FIVE-POUND FISH.")
    ((eq? id 'rule-side-to-side) "DO NOT TOUCH THE MIDDLE PLATFORM.")
    ((eq? id 'rule-landlubber) "STAY OUT OF THE WATER, MUD, AND TAR.")
    ((eq? id 'complication-double-aphids) "DOUBLE THE APHIDS.")
    ((eq? id 'complication-invert) "CONTROLS ARE INVERTED.")
    ((eq? id 'complication-loose-pockets) "BONKING OR TAKING DAMAGE LOSES 20 ORBS.")
    ((eq? id 'complication-twisted)
     (let ((rolls-away (- (-> *MOD-rule-context-bank* twist-pending-count) (-> *MOD-stats-bank* rules-rolled))))
       (if (> rolls-away 0)
         (string-format "THE RULE ROLLED ~D RULES FROM NOW MUST BE BROKEN." rolls-away)
         "A LATER RULE MUST BE BROKEN.")))
    ((eq? id 'complication-vibe-check) "I LIKE YA CUT, G.")
    ((eq? id 'complication-income-tax) "TIMER INCREMENTS ARE HALVED.")
    ((eq? id 'rule-touch-grass) "DO THAT.")
    ((eq? id 'rule-express-delivery) "RETURN THE MUSE.          OR SUFFER MY CURSE.")
    ((eq? id 'rule-qte) "PRESS ")
    ((eq? id 'complication-mirror) "THE WORLD IS MIRRORED.")
    ((eq? id 'complication-no-double-jump) "JAK AND FLUT FLUT FORGOT HOW TO DOUBLE JUMP.")
    ((eq? id 'rule-hang-time) "STAY AIRBORNE FOR 3 CONSECUTIVE SECONDS.")
    ((eq? id 'complication-unbreakable) "SCOUT FLY CRATES CAN ONLY BE BROKEN BY ECO.")
    ((eq? id 'complication-get-a-grip)
     (let ((seconds (/ (the int (mod-apply-time-limit-multiplier (seconds 12))) (seconds 1))))
       (string-format "FOR EVERY ~D SECONDS A LEDGE IS NOT GRABBED, YOU DIE." seconds)))
    ((eq? id 'complication-fast-reel) "YOUR REEL SPEED HAS INCREASED!")
    ((eq? id 'complication-palate-change) "EELS ARE GOOD, YELLOWS ARE BAD.")
    ((eq? id 'complication-jak-be-nimble) "JAK BE QUICK.")
    ((eq? id 'rule-no-harm) "DO NOT KILL ANY LURKERS.")
    ((eq? id 'complication-soul-bond) "IF A LURKER DIES, YOU DIE TOO.")
    ((eq? id 'complication-shifty) "JAK RANDOMLY TELEPORTS SHORT DISTANCES.")
    ((eq? id 'complication-interference) "ECO PIXELATES THE SCREEN.")
    ((eq? id 'complication-quicksand) "THE TIMER DRAINS TWICE AS FAST WHILE YOU\c12RE ON SAND.")
    ((eq? id 'complication-lights-out) "SORRY, WERE YOU USING THAT?")
    ((eq? id 'rule-supercharged) "COLLECT BLUE ECO.")
    ((eq? id 'complication-half-price) "POWER CELLS ARE 50% OFF!")
    ((eq? id 'rule-keep-rolling) "ROLL 30 TIMES.")
    ((eq? id 'complication-energy-boost) "HAVE SOME ECO.")
    ((eq? id 'rule-uncharted) "VISIT A LEVEL YOU HAVE NOT BEEN TO YET.")
    ((eq? id 'rule-bonecracker) "KNOCK DOWN A BONE BRIDGE.")
    ((eq? id 'rule-orb-hunt)
     (if (-> *MOD-orb-hunt-bank* level)
       (string-format "COLLECT THE HIDDEN ORB IN ~S." (mod-level-display-name (-> *MOD-orb-hunt-bank* level)))
       "COLLECT THE HIDDEN ORB IN THIS LEVEL."))
    ((eq? id 'rule-no-ledge) "DO NOT GRAB A LEDGE.")
    (else "NO DESCRIPTION AVAILABLE.")))

