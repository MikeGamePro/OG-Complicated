(defun mod-rule-counter-goal ((id symbol))
  (case id
    (('rule-lurker-pressure) 6)
    (('rule-hitlist 'rule-sagging-sails 'rule-hang-time) 3)
    (('rule-crate-break) 5)
    (('rule-money-pressure) 20)
    (('rule-keep-rolling) 30)
    (('rule-double-kill 'rule-fuel-pressure
                       'rule-sniper
                       'rule-buzzer-pressure
                       'rule-die
                       'rule-one-frame
                       'rule-vendetta
                       'rule-for-billy
                       'rule-speed
                       'rule-green-pilled
                       'rule-button-pusher
                       'rule-loyal-customer
                       'rule-cooked
                       'rule-express-delivery
                       'rule-qte
                       'rule-touch-grass
                       'rule-supercharged
                       'rule-uncharted
                       'rule-bonecracker
                       'rule-orb-hunt)
     1)
    (else 0)))

(defun mod-rule-type ((id symbol))
  (cond
    ((or (eq? id 'rule-keep-it-low)
         (eq? id 'rule-die)
         (eq? id 'rule-lurker-pressure)
         (eq? id 'rule-hitlist)
         (eq? id 'rule-double-kill)
         (eq? id 'rule-sniper)
         (eq? id 'rule-crate-break)
         (eq? id 'rule-money-pressure)
         (eq? id 'rule-fuel-pressure)
         (eq? id 'rule-buzzer-pressure)
         (eq? id 'rule-flop-this)
         (eq? id 'rule-grounded)
         (eq? id 'rule-survivor)
         (eq? id 'rule-management)
         (eq? id 'rule-vendetta)
         (eq? id 'rule-hands-on)
         (eq? id 'rule-one-frame)
         (eq? id 'rule-distancing)
         (eq? id 'rule-red-light)
         (eq? id 'rule-for-billy)
         (eq? id 'rule-cold-feet)
         (eq? id 'rule-speed)
         (eq? id 'rule-math-quiz)
         (eq? id 'rule-trivia)
         (eq? id 'rule-green-pilled)
         (eq? id 'rule-button-pusher)
         (eq? id 'rule-loyal-customer)
         (eq? id 'rule-cooked)
         (eq? id 'rule-sagging-sails)
         (eq? id 'rule-side-to-side)
         (eq? id 'rule-landlubber)
         (eq? id 'rule-express-delivery)
         (eq? id 'rule-qte)
         (eq? id 'rule-touch-grass)
         (eq? id 'rule-hang-time)
         (eq? id 'rule-no-harm)
         (eq? id 'rule-supercharged)
         (eq? id 'rule-keep-rolling)
         (eq? id 'rule-uncharted)
         (eq? id 'rule-bonecracker)
         (eq? id 'rule-orb-hunt)
         (eq? id 'rule-no-ledge))
     'rule)
    ((or (eq? id 'complication-brittle-bones)
         (eq? id 'complication-rotten-eggs)
         (eq? id 'complication-eco-allergy)
         (eq? id 'complication-sizeable)
         (eq? id 'complication-cumbersome)
         (eq? id 'complication-ohko)
         (eq? id 'complication-critical)
         (eq? id 'complication-heating-balloons)
         (eq? id 'complication-glare)
         (eq? id 'complication-disassociate)
         (eq? id 'complication-bus-driver)
         (eq? id 'complication-wings-tied)
         (eq? id 'complication-fuel-shortage)
         (eq? id 'complication-jak-rabbit)
         (eq? id 'complication-hidden-treasure)
         (eq? id 'complication-drought)
         (eq? id 'complication-eco-reserve)
         (eq? id 'complication-red-stop)
         (eq? id 'complication-rgyb)
         (eq? id 'complication-butter-fingers)
         (eq? id 'complication-overclock)
         (eq? id 'complication-bad-ping)
         (eq? id 'complication-invisible-man)
         (eq? id 'complication-joyride)
         (eq? id 'complication-double-aphids)
         (eq? id 'complication-invert)
         (eq? id 'complication-loose-pockets)
         (eq? id 'complication-twisted)
         (eq? id 'complication-vibe-check)
         (eq? id 'complication-income-tax)
         (eq? id 'complication-mirror)
         (eq? id 'complication-no-double-jump)
         (eq? id 'complication-unbreakable)
         (eq? id 'complication-get-a-grip)
         (eq? id 'complication-fast-reel)
         (eq? id 'complication-palate-change)
         (eq? id 'complication-jak-be-nimble)
         (eq? id 'complication-soul-bond)
         (eq? id 'complication-shifty)
         (eq? id 'complication-interference)
         (eq? id 'complication-quicksand)
         (eq? id 'complication-lights-out)
         (eq? id 'complication-half-price)
         (eq? id 'complication-energy-boost))
     'complication)
    (else 'unknown)))

(defmacro mod-slot-ref (field slot)
  `(-> (-> *MOD-rule-slot-bank* ,field) ,slot))

(defun mod-rule-find-active-slot ((id symbol))
  (mod-symbol-index (-> *MOD-rule-slot-bank* active-slots) id))

(defun mod-rule-active? ((id symbol))
  (>= (mod-rule-find-active-slot id) 0))

(defun mod-rule-pending? ((id symbol))
  (>= (mod-symbol-index (-> *MOD-rule-slot-bank* pending-slots) id) 0))

;; True if the slot holds an active condition or is waiting to roll one.
(defun mod-rule-slot-occupied? ((slot int))
  (or (mod-slot-ref active-slots slot) (mod-slot-ref pending-slots slot)))

(defun mod-rule-active-slot-count ()
  (let ((slot 0)
        (count 0))
    (while (< slot *mod-rule-slot-count*)
      (when (mod-rule-slot-occupied? slot)
        (+! count 1))
      (+! slot 1))
    count))

(defun mod-any-rule-active? ()
  (let ((slot 0)
        (found #f))
    (while (and (< slot *mod-rule-slot-count*) (not found))
      (let ((id (mod-slot-ref active-slots slot))) (when (and id (eq? (mod-rule-type id) 'rule)) (set! found #t)))
      (+! slot 1))
    found))

(defun mod-rule-first-free-slot ()
  (let ((slot 0)
        (result -1))
    (while (and (< slot *mod-rule-slot-count*) (< result 0))
      (when (not (mod-rule-slot-occupied? slot))
        (set! result slot))
      (+! slot 1))
    result))

(defun mod-rule-first-occupied-slot ()
  (let ((slot 0)
        (result -1))
    (while (and (< slot *mod-rule-slot-count*) (< result 0))
      (when (mod-rule-slot-occupied? slot)
        (set! result slot))
      (+! slot 1))
    result))

(defun mod-rule-clear-slot ((slot int))
  (when (and (>= slot 0) (< slot *mod-rule-slot-count*))
    (set! (mod-slot-ref active-slots slot) #f)
    (set! (mod-slot-ref pending-slots slot) #f)
    (set! (mod-slot-ref slot-punishments slot) #f)
    (set! (mod-slot-ref slot-goals slot) 0)
    (set! (mod-slot-ref slot-progress slot) 0)
    (set! (mod-slot-ref slot-end-times slot) 0)
    (set! (mod-slot-ref roll-ready-times slot) 0)
    (set! (mod-slot-ref slot-grace-periods slot) 0))
  (none))

;; Remember the last outcome shown in a slot's band.
(defun mod-rule-set-slot-outcome! ((slot int) (outcome symbol))
  (when (and (>= slot 0) (< slot *mod-rule-slot-count*))
    (set! (mod-slot-ref slot-outcomes slot) outcome))
  (none))
