(defun mod-rule-duration ((id symbol))
  (cond
    ((eq? id 'rule-grounded) (seconds 10)) ;; 10
    ((eq? id 'rule-management) (seconds 90)) ;; 90
    ((eq? id 'rule-die) (mod-apply-time-limit-multiplier (seconds 20))) ;; 20
    ((eq? id 'rule-lurker-pressure) (mod-apply-time-limit-multiplier (seconds 45))) ;; 45
    ((eq? id 'rule-hitlist) (mod-apply-time-limit-multiplier (seconds 50))) ;; 50
