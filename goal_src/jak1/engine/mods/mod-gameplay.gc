(defun mod-apply-time-limit-multiplier ((base-time time-frame))
  (let* ((raw-mult (time-limit-multiplier))
         (tenths (the int (+ (* raw-mult 10.0) 0.5))))
    (the time-frame (/ (* base-time (the time-frame tenths)) 10))))
