(defun mod-orb-hunt-spot-count ((level symbol))
  (mod-orb-hunt-pick-spot level (the-as vector #f) #f))

(defun mod-orb-hunt-spawn! ()
  (let ((pos (new 'stack-no-clear 'vector)))
    (when (> (mod-orb-hunt-pick-spot (the symbol (current-level-name)) pos #t) 0)
      (let ((h (spawn-money pos 1.0 #t)))
        (when (handle->process h)
          (let ((orb (the-as money (handle->process h))))
            (set-vector! (-> orb draw color-mult) 1.0 0.0 6.0 1.0)
            (set! (-> (-> orb root) scale x) 1.5)
            (set! (-> (-> orb root) scale y) 1.5)
            (set! (-> (-> orb root) scale z) 1.5))
          (set! (-> *MOD-orb-hunt-bank* orb-handle) h)
          (set! (-> *MOD-orb-hunt-bank* spawned?) #t)
          (set! (-> *MOD-orb-hunt-bank* level) (the symbol (current-level-name)))))))
  (none))

(defun mod-orb-hunt-clear! ()
  (when (-> *MOD-orb-hunt-bank* spawned?)
    (let ((orb (the-as eco-collectable (handle->process (-> *MOD-orb-hunt-bank* orb-handle)))))
      (when (and orb (!= (-> orb state name) 'pickup) (!= (-> orb state name) 'die))
        (if (nonzero? (-> orb part)) (kill-and-free-particles (-> orb part)))
        (if (nonzero? (-> orb sound)) (stop! (-> orb sound)))
        (deactivate orb))))
  (set! (-> *MOD-orb-hunt-bank* orb-handle) (the-as handle #f))
  (set! (-> *MOD-orb-hunt-bank* spawned?) #f)
  (set! (-> *MOD-orb-hunt-bank* level) #f)
  (none))

(defun mod-orb-hunt-on-orb-pickup ((orb process))
  (when (and (mod-rule-active? 'rule-orb-hunt)
             (-> *MOD-orb-hunt-bank* spawned?)
             (eq? (handle->process (-> *MOD-orb-hunt-bank* orb-handle)) orb))
    ;; refund: this orb must not count toward the money, total, or per-level counts
    (set! (-> *game-info* money) (max 0.0 (- (-> *game-info* money) 1.0)))
    (set! (-> *game-info* money-total) (max 0.0 (- (-> *game-info* money-total) 1.0)))
    (when (and *target* (-> *target* current-level))
      (let ((lvl-idx (-> *level-task-data-remap* (+ (-> *target* current-level info index) -1))))
        (when (> (-> *game-info* money-per-level lvl-idx) 0)
          (-! (-> *game-info* money-per-level lvl-idx) 1))))
    ;; forget the orb first
    (set! (-> *MOD-orb-hunt-bank* orb-handle) (the-as handle #f))
    (set! (-> *MOD-orb-hunt-bank* spawned?) #f)
    (mod-rule-counter-add-progress 'rule-orb-hunt 1))
  (none))

(defun mod-orb-hunt-update ()
  (when (and (mod-rule-active? 'rule-orb-hunt)
             (or (not (-> *MOD-orb-hunt-bank* spawned?)) (not (handle->process (-> *MOD-orb-hunt-bank* orb-handle)))))
    (set! (-> *MOD-orb-hunt-bank* spawned?) #f)
    (mod-orb-hunt-spawn!))
  (none))

