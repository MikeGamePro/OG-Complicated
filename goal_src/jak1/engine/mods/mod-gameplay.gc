;; Bounds-checked array lookup; returns #f when idx is out of range.
(defun mod-symbol-at ((ids (array symbol)) (idx int))
  (if (and (>= idx 0) (< idx (-> ids length))) (-> ids idx) #f))

(defun mod-symbol-index ((ids (array symbol)) (id symbol))
  (let ((i 0)) (while (< i (-> ids length)) (when (= (-> ids i) id) (return i)) (+! i 1)) -1))

;; Pack one byte per entry (index into ids, #xff = empty) into a uint. Save format: do not change.
(defun mod-pack-symbols ((arr (array symbol)) (ids (array symbol)) (n int))
  (let ((result (the uint 0))
        (i 0))
    (while (< i n)
      (let* ((sym (-> arr i))
             (idx (if sym (mod-symbol-index ids sym) -1))
             (byte-val (if (>= idx 0) (the uint idx) (the uint #xff))))
        (set! result (logior result (shl byte-val (* i 8)))))
      (+! i 1))
    (the int result)))

;; Inverse of mod-pack-symbols for a single slot's byte.
(defun mod-unpack-symbol ((bits uint) (slot int) (ids (array symbol)))
  (mod-symbol-at ids (the int (logand (shr bits (* slot 8)) (the uint #xff)))))

(defun mod-seconds->ms ((secs float))
  (the int (+ 0.5 (* secs 1000.0))))

(defun mod-rule-id-from-index ((idx int))
  (mod-symbol-at *mod-rule-ids* idx))

(defun mod-punishment-id-from-index ((idx int))
  (mod-symbol-at *mod-punishment-ids* idx))

(defun mod-enabled-condition-count ()
  (let ((count 0))
    (dotimes (i *mod-rule-id-count*)
      (when (mod-condition-enabled? (mod-rule-id-from-index i))
        (+! count 1)))
    count))

(defun mod-enabled-condition-fraction ()
  (/ (the float (mod-enabled-condition-count)) (the float *mod-rule-id-count*)))

(defun mod-punishment-toggle-enabled-count ()
  (let ((count 0))
    (dotimes (i *mod-punishment-id-count*)
      (let ((id (mod-punishment-id-from-index i))) (when (punishment-toggle-enabled? id) (+! count 1))))
    count))

(defun mod-punishment-toggle-enabled-fraction ()
  (/ (the float (mod-punishment-toggle-enabled-count)) (the float *mod-punishment-id-count*)))

(define *mod-score-max-inc* 35780.0)

(define *mod-score-time-scale* 5400.0)

(define *mod-rule-follow-estimate* 40.0)

;; Total seconds obtainable from every collectable at the current increment settings.
(defun mod-collectable-inc-total ()
  (+ (* 101.0 (cell-increment-value)) (* 2000.0 (orb-increment-value)) (* 112.0 (fly-increment-value))))

;; Collectable total + countdown start time + estimated compliance bonus.
(defun mod-inc-total ()
  (+ (mod-collectable-inc-total)
     (countdown-start-seconds-value)
     (* *mod-rule-follow-estimate* (compliance-increment-value))))

(defun mod-calc-run-score ()
  (let* ((inc-total (mod-inc-total))
         (inc-norm (/ inc-total *mod-score-max-inc*))
         (final-time-seconds (/ (the float (-> *MOD-stats-bank* final-time)) (the float TICKS_PER_SECOND)))
         (time-factor (/ *mod-score-time-scale* (+ *mod-score-time-scale* final-time-seconds)))
         (raw-mult (fmax 0.01 (time-limit-multiplier)))
         (max-score 100000.0)
         (mult-weight 0.0185)
         (time-weight 0.2)
         (score-weight 0.8)
         (conditions-weight 0.055)
         (punishments-weight 0.012)
         (target-slot-weight 0.075)
         (condition-delay-weight 0.03)
         (completion-baseline 69.0)
         (completion-weight 0.14)
         (completion (calculate-completion (the-as progress #f)))
         (completion-factor (+ 1.0 (* completion-weight (- (/ completion completion-baseline) 1.0))))
         (effective-mult (+ 1.0 (* (- raw-mult 1.0) mult-weight)))
         (effective-conditions-mult (+ 1.0 (* (- 1.0 (mod-enabled-condition-fraction)) conditions-weight)))
         (effective-punishments-mult (+ 1.0 (* (- 1.0 (mod-punishment-toggle-enabled-fraction)) punishments-weight)))
         (target-slot-count (target-slot-count-value))
         (target-slot-delta (/ (the float (- 1 target-slot-count)) (the float *mod-rule-slot-count*)))
         (delay-delta (/ (- (new-condition-delay-seconds) 5.0) 30.0))
         (effective-target-slots-mult (if (= target-slot-count 0) (+ 1.0 conditions-weight) (+ 1.0 (* target-slot-delta target-slot-weight))))
         (effective-delay-mult (+ 1.0 (* delay-delta condition-delay-weight)))
         (score 0.0))
    (set! inc-norm (fmax 0.0 (fmin 1.0 inc-norm)))
    (let ((base-score (* max-score (+ (* time-weight time-factor) (* score-weight (- 1.0 inc-norm))))))
      (set! score
            (* completion-factor
               (/ (/ (/ (/ (/ base-score effective-mult) effective-conditions-mult) effective-punishments-mult)
                     effective-target-slots-mult)
                  effective-delay-mult))))
    (format #t
            "mod-score: inc-total ~f inc-norm ~f final-time-s ~f time-factor ~f completion ~f completion-factor ~f "
            inc-total
            inc-norm
            final-time-seconds
            time-factor
            completion
            completion-factor)
    (format #t
            "eff-mult ~f eff-cond-mult ~f eff-punish-mult ~f eff-slots-mult ~f eff-delay-mult ~f score ~f~%"
            effective-mult
            effective-conditions-mult
            effective-punishments-mult
            effective-target-slots-mult
            effective-delay-mult
            score)
    score))

(defun mod-game-beaten-resume-from-save ((value int))
  (set! (-> *MOD-rule-context-bank* game-beaten?) (not (= value 0)))
  (none))

(defun mod-game-beaten-save-value ()
  (if (-> *MOD-rule-context-bank* game-beaten?) 1 0))

(defun mod-game-beaten-set! ((val symbol))
  (set! (-> *MOD-rule-context-bank* game-beaten?) val)
  (none))

;; Called when the final light eco is picked up.
(defun mod-finalize-run-stats! ()
  (set! (-> *MOD-stats-bank* final-remaining-time) (-> *MOD-countdown-bank* remaining-time))
  (set! (-> *MOD-stats-bank* final-time) (-> *MOD-countdown-bank* countup-timer))
  (set! (-> *MOD-stats-bank* final-score) (the int (mod-calc-run-score)))
  (none))

(defun mod-difficulty-display-name ()
  (case *complicated-difficulty-preset*
    (('easy) "Simple")
    (('medium) "Complicated")
    (('esoteric) "Esoteric")
    (('unfathomable) "Unfathomable")
    (else "Custom")))

(defun mod-discord-info-fill! ((info discord-info))
  (set! (-> info difficulty) (mod-difficulty-display-name))
  (set! (-> info countdown-active?) (-> *MOD-countdown-bank* active?))
  (set! (-> info countdown-lost?) (-> *MOD-countdown-bank* lost?))
  (set! (-> info game-beaten?) (-> *MOD-rule-context-bank* game-beaten?))
  (set! (-> info time-remaining)
        (if (-> *MOD-rule-context-bank* game-beaten?)
          (-> *MOD-stats-bank* final-remaining-time)
          (-> *MOD-countdown-bank* remaining-time)))
  (set! (-> info completion) (calculate-completion (the-as progress #f)))
  (set! (-> info rules-followed) (-> *MOD-stats-bank* rules-followed))
  (set! (-> info rules-broken) (-> *MOD-stats-bank* rules-broken))
  (none))

(def-save-field-pair mod-final-time-save-value mod-final-time-resume-from-save (-> *MOD-stats-bank* final-time))

(def-save-field-pair mod-final-remaining-time-save-value
                     mod-final-remaining-time-resume-from-save
                     (-> *MOD-stats-bank* final-remaining-time))

(def-save-field-pair mod-final-score-save-value mod-final-score-resume-from-save (-> *MOD-stats-bank* final-score))

(defun mod-pass-reset! ()
  (set! (-> *MOD-pass-bank* passes) 0)
  (set! (-> *MOD-pass-bank* credits) 0)
  (none))

(defun mod-pass-add-credit! ()
  (when (< (-> *MOD-pass-bank* passes) (-> *MOD-tuning-bank* pass-max-carry))
    (+! (-> *MOD-pass-bank* credits) 1)
    (when (>= (-> *MOD-pass-bank* credits) (pass-credits-required-value))
      (+! (-> *MOD-pass-bank* passes) 1)
      (-! (-> *MOD-pass-bank* credits) (pass-credits-required-value))))
  (none))

(defun mod-pass-state-save-value ()
  (the int (logior (the uint (-> *MOD-pass-bank* passes)) (shl (the uint (-> *MOD-pass-bank* credits)) 8))))

(defun mod-pass-state-resume-from-save ((val int))
  (let ((bits (the uint val)))
    (set! (-> *MOD-pass-bank* passes) (min (-> *MOD-tuning-bank* pass-max-carry) (the int (logand bits (the uint #xff)))))
    (set! (-> *MOD-pass-bank* credits) (the int (logand (shr bits 8) (the uint #xff)))))
  (none))

(defun mod-stats-reset! ()
  (set! (-> *MOD-stats-bank* rules-rolled) 0)
  (set! (-> *MOD-stats-bank* rules-broken) 0)
  (set! (-> *MOD-stats-bank* rules-followed) 0)
  (set! (-> *MOD-stats-bank* complications-endured) 0)
  (set! (-> *MOD-stats-bank* conditions-skipped) 0)
  (set! (-> *MOD-stats-bank* final-time) 0)
  (set! (-> *MOD-stats-bank* final-remaining-time) 0)
  (set! (-> *MOD-stats-bank* final-score) 0)
  (set! (-> *MOD-rule-context-bank* game-beaten?) #f)
  (mod-pass-reset!)
  (none))

(def-save-field-pair mod-stats-rules-rolled-save-value
                     mod-stats-rules-rolled-resume-from-save
                     (-> *MOD-stats-bank* rules-rolled))

(def-save-field-pair mod-stats-rules-broken-save-value
                     mod-stats-rules-broken-resume-from-save
                     (-> *MOD-stats-bank* rules-broken))

(def-save-field-pair mod-stats-rules-followed-save-value
                     mod-stats-rules-followed-resume-from-save
                     (-> *MOD-stats-bank* rules-followed))

(def-save-field-pair mod-stats-complications-endured-save-value
                     mod-stats-complications-endured-resume-from-save
                     (-> *MOD-stats-bank* complications-endured))

(def-save-field-pair mod-stats-conditions-skipped-save-value
                     mod-stats-conditions-skipped-resume-from-save
                     (-> *MOD-stats-bank* conditions-skipped))

;; Seconds lost by the time loss punishment. Baseline scaled by how generous the increments are.
(defun mod-countdown-punishment-seconds ()
  (let* ((scaled (* (-> *MOD-tuning-bank* countdown-punishment-baseline-seconds)
                    (/ (mod-collectable-inc-total) (-> *MOD-tuning-bank* countdown-punishment-baseline-inc-total))))
         (rounded (* (the int (/ (+ scaled 2.5) 5.0)) 5)))
    (max 5 rounded)))

(defun mod-countdown-punishment-ticks ()
  (the int (* (the float (mod-countdown-punishment-seconds)) (the float TICKS_PER_SECOND))))

(defun mod-cell-blocked? ()
  (the symbol
       (or (mod-rule-active? 'complication-fuel-shortage)
           (and (mod-target-on-flut?) (mod-rule-active? 'complication-wings-tied))
           (and *target* (> (-> (the-as fact-info-target (-> *target* fact)) health) 1.0) (mod-rule-active? 'complication-critical)))))

(defun mod-cell-price-task ()
  (if (mod-rule-active? 'complication-half-price) (/ (-> *GAME-bank* money-task-inc) 2.0) (-> *GAME-bank* money-task-inc)))

(defun mod-cell-price-oracle ()
  (if (mod-rule-active? 'complication-half-price) (/ (-> *GAME-bank* money-oracle-inc) 2.0) (-> *GAME-bank* money-oracle-inc)))

(defun mod-trade-hint-task ()
  (if (mod-rule-active? 'complication-half-price) (text-id press-to-trade-money-cheap) (text-id press-to-trade-money)))

(defun mod-trade-hint-oracle ()
  (if (mod-rule-active? 'complication-half-price)
    (text-id press-to-trade-money-oracle-cheap)
    (text-id press-to-trade-money-oracle)))

