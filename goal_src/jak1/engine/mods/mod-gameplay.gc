       (orb-hunt-spot -370.18 20.31 -1755.46)
       (orb-hunt-spot 15.95 25.66 -1626.83)
       (orb-hunt-spot -80.17 29.93 -1522.58))
      (('ogre))
      (('village3)
       (orb-hunt-spot 1113.68 46.90 -3523.32)
       (orb-hunt-spot 1108.07 53.78 -3484.56)
       (orb-hunt-spot 1025.44 41.27 -3508.61)
       (orb-hunt-spot 1138.43 45.67 -3407.86))
      (('snow)
       (orb-hunt-spot 990.09 241.62 -3485.62)
       (orb-hunt-spot 737.31 264.28 -3445.28)
       (orb-hunt-spot 888.26 211.51 -3355.38)
       (orb-hunt-spot 1016.1641 225.1692 -3306.5546))
      (('maincave)
       (orb-hunt-spot 1065.11 19.25 -3108.19)
       (orb-hunt-spot 1027.23 23.68 -3124.52)
       (orb-hunt-spot 1145.30 26.85 -3115.95)
       (orb-hunt-spot 1019.30 45.01 -3100.94))
      (('darkcave))
