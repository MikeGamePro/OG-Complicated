(defun mod-rule-slot-remaining-time-save-value ((slot int))
  (if (mod-slot-ref active-slots slot) (the int (max 0 (- (mod-slot-ref slot-end-times slot) (current-time)))) 0))

(defun mod-rule-slot-remaining-time-resume-from-save ((slot int) (val int))
  (set! (mod-slot-ref saved-remaining-times slot) (max 0 val))
